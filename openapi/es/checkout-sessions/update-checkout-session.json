                      "type": "array",
                      "items": {
                        "type": "string",
                        "example": "The merchant has no authorization to use this API."
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "deprecated": false,
        "parameters": [
          {
            "in": "path",
            "name": "checkout_session",
            "schema": {
              "type": "string"
            },
            "required": true
          }
        ]
      }
    }
  },
