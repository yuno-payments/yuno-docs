{
  "openapi": "3.1.0",
  "info": {
    "title": "checkout-api",
    "version": "1.0.2"
  },
  "servers": [
    {
      "url": "https://api-sandbox.y.uno/v1",
      "description": "Sandbox"
    },
    {
      "url": "https://api.y.uno/v1",
      "description": "Production (US)"
    }
  ],
  "components": {
    "securitySchemes": {
      "sec0": {
        "type": "apiKey",
        "in": "header",
        "name": "public-api-key",
        "x-default": "<Your public-api-key>"
      },
      "sec1": {
        "type": "apiKey",
        "in": "header",
        "name": "private-secret-key",
        "x-default": "<Your private-secret-key>"
      }
    }
  },
  "security": [
    {
      "sec0": [],
      "sec1": []
    }
  ],
  "paths": {
    "/checkout/sessions/{id}": {
      "get": {
        "summary": "Retrieve Checkout Session",
        "operationId": "get-checkout-session",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "El identificador único de la sesión de checkout (UUID, 36 caracteres).",
            "schema": {
              "type": "string"
            },
            "required": true
          }
        ],
        "responses": {
          "200": {
            "description": "200",
            "content": {
              "application/json": {
                "examples": {
                  "Result": {
                    "value": {
                      "merchant_order_id": "1752072398",
                      "country": "AR",
                      "payment_description": "Test Cards",
                      "customer_id": "e937e18e-a684-4d7b-a1a1-ab64c10a941d",
                      "callback_url": "https://google.com/?checkoutSession=02caeb08-45c0-4670-9736-5bdee1b311f8",
                      "amount": {
                        "currency": "ARS",
                        "value": 520
                      },
                      "created_at": "2025-07-09T14:46:39.515251Z",
                      "metadata": null,
                      "workflow": "SDK_CHECKOUT",
                      "installments": {
                        "plan_id": null,
                        "plan": null
                      },
                      "used": true,
                      "checkout_id": "6822f80c-684e-41a3-8628-78963d3d60f7",
                      "checkout_session": "87749bc1-1ce4-47f3-8745-72602bb6bcea",
                      "recurring_payment": {
                        "description": "Monthly subscription",
                        "management_url": "https://example.com/manage",
                        "billing_agreement": "BA-123",
                        "regular_billing": {
                          "label": "Monthly",
                          "amount": 9.99,
                          "interval_unit": "month",
                          "interval_count": 1
                        },
                        "trial_billing": {
                          "label": "Free trial",
                          "amount": 0,
                          "interval_unit": "month",
                          "interval_count": 1
                        }
                      }
                    }
                  }
                },
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "description": "El identificador único de la sesión de checkout (MAX 64; MIN 36).",
                      "example": "02caeb08-45c0-4670-9736-5bdee1b311f8"
                    },
                    "merchant_order_id": {
                      "type": "string",
                      "description": "El identificador único de la orden del cliente (MAX 255; MIN 3).",
                      "example": "1752072398"
                    },
                    "country": {
                      "type": "string",
                      "description": "País donde se debe procesar la transacción (MAX 2; MIN 2; ISO 3166-1).",
                      "example": "AR"
                    },
                    "payment_description": {
                      "type": "string",
                      "description": "La descripción del pago (MAX 255; MIN 3).",
                      "example": "Test Cards"
                    },
                    "customer_id": {
                      "type": "string",
                      "description": "El identificador único del cliente (MAX 64; MIN 36).",
                      "example": "e937e18e-a684-4d7b-a1a1-ab64c10a941d"
                    },
                    "callback_url": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "description": "La URL a la que se redirige al cliente después del pago (MAX 526; MIN 3).",
                      "example": "https://google.com/?checkoutSession=02caeb08-45c0-4670-9736-5bdee1b311f8"
                    },
                    "amount": {
                      "type": "object",
                      "description": "Indica el objeto del monto del pago, con el valor y la moneda.",
                      "properties": {
                        "currency": {
                          "type": "string",
                          "description": "La moneda utilizada para realizar el pago (MAX 3; MIN 3; ISO 4217).",
                          "example": "ARS"
                        },
                        "value": {
                          "type": "number",
                          "description": "El monto del pago (múltiplo de 0.0001).",
                          "example": 520
                        }
                      }
                    },
                    "created_at": {
                      "type": "string",
                      "description": "Fecha y hora de creación de la sesión de checkout (MAX 27; MIN 27; ISO 8601).",
                      "example": "2025-07-09T14:46:39.515251Z"
                    },
                    "metadata": {
                      "type": [
                        "array",
                        "null"
                      ],
                      "description": "Especifica una lista de objetos de metadatos. Puedes agregar hasta 50 objetos de metadatos.",
                      "items": {
                        "type": "object",
                        "properties": {
                          "key": {
                            "type": "string",
                            "description": "Especifica una clave de metadatos.",
                            "example": "age"
                          },
                          "value": {
                            "type": "string",
                            "description": "Especifica el valor de la clave de metadatos definida.",
                            "example": "28"
                          }
                        }
                      }
                    },
                    "workflow": {
                      "type": "string",
                      "description": "El tipo de flujo de pago que especifica cómo se procesará la sesión de checkout.",
                      "example": "SDK_CHECKOUT"
                    },
                    "installments": {
                      "type": "object",
                      "description": "El objeto para enviar el plan de cuotas creado en Yuno, que se muestra a tus clientes para que elijan.",
                      "properties": {
                        "plan_id": {
                          "type": [
                            "string",
                            "null"
                          ],
                          "description": "Especifica un id de plan creado en Yuno para mostrar a tu cliente en la sesión de checkout (MAX 64; MIN 64)."
                        },
                        "plan": {
                          "type": [
                            "array",
                            "null"
                          ],
                          "description": "Cuotas que se muestran al cliente con la sesión de checkout.",
                          "items": {
                            "type": "object",
                            "properties": {
                              "installment": {
                                "type": "integer",
                                "description": "El número de cuotas mensuales que pueden elegir los compradores.",
                                "example": 3
                              },
                              "rate": {
                                "type": "number",
                                "description": "La tasa que el proveedor de pagos aplicará al monto final de la transacción después de usar cuotas.",
                                "example": 1.5
                              }
                            }
                          }
                        }
                      }
                    },
                    "used": {
                      "type": "boolean",
                      "description": "Especifica si una sesión de checkout se usó anteriormente o no.",
                      "example": true
                    },
                    "checkout_id": {
                      "type": "string",
                      "example": "6822f80c-684e-41a3-8628-78963d3d60f7"
                    },
                    "wallet_card_acceptance": {
                      "type": "object",
                      "description": "Reglas de aceptación de tarjetas enviadas al crear la sesión de checkout. Se devuelven solo cuando la sesión se creó con ellas.",
                      "properties": {
                        "supported_countries": {
                          "type": "array",
                          "description": "Países que emitieron la tarjeta, como códigos ISO 3166-1 alpha-2. Es el país emisor de la tarjeta, no la ubicación del cliente.",
                          "items": {
                            "type": "string"
                          },
                          "example": [
                            "BR"
                          ]
                        },
                        "supported_networks": {
                          "type": "array",
                          "description": "Redes de tarjetas que el cliente puede elegir. Reemplaza la lista predeterminada (AMEX, DISCOVER, ELECTRON, ELO, MASTERCARD, VISA, MAESTRO).",
                          "items": {
                            "type": "string"
                          },
                          "example": [
                            "VISA",
                            "MASTERCARD"
                          ]
                        },
                        "supported_funding_types": {
                          "type": "array",
                          "description": "Tipos de fondos que el cliente puede elegir: CREDIT, DEBIT o ambos.",
                          "items": {
                            "type": "string",
                            "enum": [
                              "CREDIT",
                              "DEBIT"
                            ]
                          },
                          "example": [
                            "CREDIT"
                          ]
                        }
                      }
                    },
                    "checkout_session": {
                      "type": "string",
                      "example": "87749bc1-1ce4-47f3-8745-72602bb6bcea",
                      "description": "Sesión de checkout."
                    },
                    "recurring_payment": {
                      "type": "object",
                      "properties": {
                        "description": {
                          "type": "string",
                          "example": "Monthly subscription"
                        },
                        "management_url": {
                          "type": "string",
                          "example": "https://example.com/manage"
                        },
                        "billing_agreement": {
                          "type": "string",
                          "example": "BA-123"
                        },
                        "regular_billing": {
                          "type": "object",
                          "properties": {
                            "label": {
                              "type": "string",
                              "example": "Monthly"
                            },
                            "amount": {
                              "type": "number",
                              "example": 9.99
                            },
                            "interval_unit": {
                              "type": "string",
                              "example": "month"
                            },
                            "interval_count": {
                              "type": "integer",
                              "example": 1
                            }
                          }
                        },
                        "trial_billing": {
                          "type": "object",
                          "properties": {
                            "label": {
                              "type": "string",
                              "example": "Free trial"
                            },
                            "amount": {
                              "type": "number",
                              "example": 0
                            },
                            "interval_unit": {
                              "type": "string",
                              "example": "month"
                            },
                            "interval_count": {
                              "type": "integer",
                              "example": 1
                            }
                          }
                        }
                      },
                      "description": "Pago recurrente."
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "400",
            "content": {
              "application/json": {
                "examples": {
                  "Result": {
                    "value": {
                      "code": "INVALID_REQUEST",
                      "messages": [
                        "Invalid request"
                      ]
                    }
                  }
                },
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "string",
                      "example": "INVALID_REQUEST"
                    },
                    "messages": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "example": "Invalid request"
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "401",
            "content": {
              "application/json": {
                "examples": {
                  "Unauthorized": {
                    "value": {
                      "code": "INVALID_CREDENTIALS",
                      "messages": [
                        "Invalid credentials"
                      ]
                    }
                  }
                },
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "string",
                      "example": "INVALID_CREDENTIALS"
                    },
                    "messages": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "example": "Invalid credentials"
                      }
                    }
                  }
                }
              }
            }
          },
          "403": {
            "description": "403",
            "content": {
              "application/json": {
                "examples": {
                  "Forbidden": {
                    "value": {
                      "code": "AUTHORIZATION_REQUIRED",
                      "messages": [
                        "The merchant has no authorization to use this API."
                      ]
                    }
                  }
                },
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "string",
                      "example": "AUTHORIZATION_REQUIRED"
                    },
                    "messages": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "example": "The merchant has no authorization to use this API."
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "deprecated": false
      }
    }
  },
  "x-readme": {
    "headers": [
      {
        "value": "utf-8",
        "key": "charset"
      }
    ],
    "explorer-enabled": true,
    "proxy-enabled": true
  },
  "x-readme-fauxas": true
