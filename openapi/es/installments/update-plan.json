{
  "openapi": "3.1.0",
  "info": {
    "title": "installments",
    "version": "1.0.2"
  },
  "servers": [
    {
      "url": "https://api-sandbox.y.uno/v1",
      "description": "Sandbox"
    },
    {
      "url": "https://api.y.uno/v1",
      "description": "Production (US)"
    }
  ],
  "components": {
    "securitySchemes": {
      "sec0": {
        "type": "apiKey",
        "in": "header",
        "name": "public-api-key",
        "x-default": "<Your public-api-key>"
      },
      "sec1": {
        "type": "apiKey",
        "in": "header",
        "name": "private-secret-key",
        "x-default": "<Your private-secret-key>"
      }
    }
  },
  "security": [
    {
      "sec0": [],
      "sec1": []
    }
  ],
  "paths": {
    "/installments-plans/{installment_code}": {
      "patch": {
        "summary": "Actualizar plan",
        "description": "",
        "operationId": "update-plan",
        "parameters": [
          {
            "name": "installment_code",
            "in": "path",
            "description": "El identificador único del plan de cuotas.",
            "schema": {
              "type": "string"
            },
            "required": true
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "description": "El nombre del plan de cuotas (MAX 255; MIN 3)"
                  },
                  "account_id": {
                    "type": "array",
                    "description": "El identificador único de la cuenta de Yuno que tendrá disponible el plan de cuotas (MAX 64 ; MIN 36).",
                    "items": {
                      "type": "string"
                    }
                  },
                  "merchant_reference": {
                    "type": "string",
                    "description": "Identificación del plan de cuotas (MAX 255; MIN 3)"
                  },
                  "installments_plan": {
                    "type": "array",
                    "description": "Definición de las cuotas disponibles para cada escenario",
                    "items": {
                      "properties": {
                        "installment": {
                          "type": "integer",
                          "description": "La cantidad de cuotas mensuales que pueden elegir los compradores",
                          "format": "int32"
                        },
                        "rate": {
                          "type": "number",
                          "description": "La tasa que aplica el proveedor de pagos al monto final de la transacción cuando se usan cuotas. El valor se ingresa como multiplicador, no como porcentaje. Por ejemplo, para aplicar una tasa del 20 %, ingresa `1.20` en lugar de `20`.",
                          "format": "float"
                        },
                        "financial_costs": {
                          "type": "array",
                          "description": "Detalles opcionales de los costos financieros de esta opción de cuotas.",
                          "items": {
                            "type": "object",
                            "properties": {
                              "type": {
                                "type": "string",
                                "description": "El identificador del tipo de costo financiero (MIN 3; MAX 255).\n\n<br/> Ejemplo: `CFT`, `TEA`, `CET`, `CAT`"
                              },
                              "rate": {
                                "type": "number",
                                "description": "La tasa del costo financiero como número decimal (por ejemplo, 45.25 para 45.25%).",
                                "minimum": 0,
                                "maximum": 100000,
                                "format": "float"
                              }
                            },
                            "required": [
                              "type",
                              "rate"
                            ]
                          }
                        },
                        "type": {
                          "type": "string",
                          "description": "Tipo de cuota. Solo disponible para Ecuador y México. Merchant se refiere a pagos diferidos con intereses e Issuer, a pagos diferidos sin intereses",
                          "enum": [
                            "MERCHANT_INSTALLMENTS",
                            "ISSUER_INSTALLMENTS"
                          ]
                        }
                      },
                      "required": [
                        "installment",
                        "rate"
                      ],
                      "type": "object"
                    }
                  },
                  "country_code": {
                    "type": "string",
                    "description": "El país del emisor (ISO 3166-1 MAX 2; MIN 2)"
                  },
                  "scheme": {
                    "type": "string",
                    "description": "Información del esquema de la tarjeta. (MAX 255; MIN 3)"
                  },
                  "brand": {
                    "type": "array",
                    "description": "Información de la marca de la tarjeta (MAX 255; MIN 3).",
                    "items": {
                      "type": "string"
                    }
                  },
                  "issuer": {
                    "type": "string",
                    "description": "Emisor de la tarjeta (MAX 255; MIN 3)"
                  },
                  "iin": {
                    "type": "array",
                    "description": "El número de identificación del emisor (IIN) corresponde a los primeros dígitos del número de una tarjeta de pago emitida por una institución financiera (MAX 8; MIN 6)",
                    "items": {
                      "type": "string"
                    }
                  },
                  "first_installment_deferral": {
                    "type": "integer",
                    "description": "La cantidad de meses que se esperan para debitar la primera cuota (MAX: 3).",
                    "format": "int32"
                  },
                  "amount": {
                    "type": "object",
                    "description": "Los montos para los que estará disponible el plan de cuotas. Si es null, está disponible para cualquier monto.",
                    "required": [
                      "currency"
                    ],
                    "properties": {
                      "currency": {
                        "type": "string",
                        "description": "La moneda con la que se hace el pago (ISO 4217 MAX 3; MIN 3)"
                      },
                      "min_value": {
                        "type": "number",
                        "description": "El monto mínimo para el que se podrá usar el plan de cuotas (múltiplo de 0.0001).",
                        "format": "float"
                      },
                      "max_value": {
                        "type": "number",
                        "description": "El monto máximo para el que se podrá usar el plan de cuotas (múltiplo de 0.0001).",
                        "format": "float"
                      }
                    }
                  },
                  "availability": {
                    "type": "object",
                    "description": "Las fechas en las que estará disponible el plan de cuotas. Si es null, no tiene fecha de finalización",
                    "required": [
                      "start_at",
                      "finish_at"
                    ],
                    "properties": {
                      "start_at": {
                        "type": "string",
                        "description": "La fecha de inicio desde la cual se podrá usar el plan de cuotas",
                        "format": "date-time"
                      },
                      "finish_at": {
                        "type": "string",
                        "description": "La fecha de fin hasta la cual se podrá usar el plan de cuotas.",
                        "format": "date-time"
                      }
                    }
                  }
                }
              },
              "examples": {
                "Update Plan": {
                  "summary": "Update Plan",
                  "value": {
                    "name": "Plan Update",
                    "account_id": [
                      "{{account_id}}"
                    ],
                    "merchant_reference": "REF01",
                    "installments_plan": [
                      {
                        "installment": 3,
                        "rate": 1.05,
                        "financial_costs": [
                          {
                            "type": "CFT",
                            "rate": 15.5
                          }
                        ],
                        "type": "MERCHANT_INSTALLMENTS"
                      },
                      {
                        "installment": 6,
                        "rate": 1.1
                      },
                      {
                        "installment": 12,
                        "rate": 1.2
                      }
                    ],
                    "country_code": "US",
                    "scheme": "VISA",
                    "brand": [
                      "VISA",
                      "MASTERCARD"
                    ],
                    "issuer": "JPMORGAN CHASE BANK",
                    "iin": [
                      "411111",
                      "542418"
                    ],
                    "first_installment_deferral": 1,
                    "amount": {
                      "currency": "USD",
                      "min_value": 50,
                      "max_value": 10000
                    },
                    "availability": {
                      "start_at": "2024-01-01T00:00:00.000Z",
                      "finish_at": "2024-12-31T23:59:59.999Z"
                    }
                  }
                }
              }
            }
          }
        },
