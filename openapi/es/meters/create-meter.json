{
  "openapi": "3.1.0",
  "info": {
    "title": "meters",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://api-sandbox.y.uno/v1",
      "description": "Sandbox"
    },
    {
      "url": "https://api.y.uno/v1",
      "description": "Production (US)"
    }
  ],
  "components": {
    "securitySchemes": {
      "sec0": {
        "type": "apiKey",
        "in": "header",
        "name": "public-api-key",
        "x-default": "<Your public-api-key>"
      },
      "sec1": {
        "type": "apiKey",
        "in": "header",
        "name": "private-secret-key",
        "x-default": "<Your private-secret-key>"
      }
    }
  },
  "security": [
    {
      "sec0": [],
      "sec1": []
    }
  ],
  "paths": {
    "/subscriptions/meters": {
      "post": {
        "summary": "Crear medidor",
        "description": "La facturación por uso debe estar habilitada para tu organización antes de que este endpoint acepte solicitudes (de lo contrario, `403 PRODUCT_NOT_ENABLED`). Crea un medidor: una acción con nombre y contable que realiza tu producto (tokens, solicitudes de API, gigabytes almacenados). El medidor define el `event_name` que envían tus sistemas y cómo se agregan los valores reportados en cada ciclo de facturación. Asócialo a un plan como precio medido para facturar el uso.",
        "operationId": "create-meter",
        "parameters": [
          {
            "in": "header",
            "name": "X-Idempotency-Key",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Identificador único usado en los encabezados HTTP para garantizar que una solicitud se procese una sola vez, incluso si se reintenta por problemas de red o tiempos de espera agotados. Es opcional, igual que en el resto de la API de Yuno."
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "account_id",
                  "name",
                  "event_name",
                  "aggregation"
                ],
                "properties": {
                  "account_id": {
                    "type": "string",
                    "description": "El identificador único de la cuenta a la que pertenece el medidor (UUID, 36 caracteres)."
                  },
                  "name": {
                    "type": "string",
                    "description": "El nombre visible del medidor (MAX 255; MIN 3). Se eliminan los espacios al inicio y al final."
                  },
                  "description": {
                    "type": "string",
                    "description": "Qué cuenta el medidor y cómo. Es opcional, pero recomendable: así tu equipo y el soporte de Yuno entienden el medidor."
                  },
                  "event_name": {
                    "type": "string",
                    "description": "La clave que tus sistemas envían en cada evento de uso para hacer referencia a este medidor (MAX 100; solo letras minúsculas, dígitos, `_` y `.`: `^[a-z0-9_.]+$`). Debe ser única entre todos los medidores de la cuenta, `ACTIVE` o `INACTIVE`; de lo contrario, `409 METER_EVENT_NAME_CONFLICT`. No se puede cambiar después de la creación."
                  },
                  "aggregation": {
                    "type": "string",
                    "enum": [
                      "SUM",
                      "COUNT",
                      "LAST"
                    ],
                    "description": "Cómo se acumulan los eventos reportados en la cantidad del ciclo. `SUM` suma el `value` de cada evento (tokens, minutos). `COUNT` cuenta los eventos e ignora `value` (solicitudes de API). `LAST` conserva el `value` más reciente (un indicador como los gigabytes almacenados). No se puede cambiar después de la creación."
                  },
                  "unit_label": {
                    "type": "string",
                    "description": "Etiqueta de unidad en singular que se usa al mostrar el uso. Ejemplo: `token`."
                  },
                  "plural_unit_label": {
                    "type": "string",
                    "description": "Etiqueta de unidad en plural que se usa al mostrar el uso. Ejemplo: `tokens`."
                  },
                  "default_price": {
                    "type": "object",
                    "required": [
                      "currency",
                      "value"
                    ],
                    "properties": {
                      "currency": {
                        "type": "string",
                        "description": "MAX 3; MIN 3. Debe ser `USD`: cualquier otra moneda se rechaza con `400 INVALID_PARAMETERS`."
                      },
                      "value": {
                        "type": "number",
                        "format": "float",
                        "description": "Precio por defecto por unidad por encima de los créditos incluidos (múltiplo de 0.0001). Lo heredan los planes en USD que asocian este medidor sin un `price_per_credit` explícito."
                      }
                    }
                  },
                  "metadata": {
                    "type": "array",
                    "description": "Pares opcionales de clave y valor asociados al medidor (MAX 48 entradas; las claves deben ser únicas por medidor).",
                    "items": {
                      "type": "object",
                      "required": [
                        "key",
                        "value"
                      ],
                      "properties": {
                        "key": {
                          "type": "string",
                          "description": "MAX 48."
                        },
                        "value": {
                          "type": "string",
                          "description": "MAX 512."
                        }
                      }
                    }
                  },
                  "status": {
                    "type": "string",
                    "enum": [
                      "ACTIVE",
                      "INACTIVE"
                    ],
                    "description": "Se ignora al crear: un medidor nuevo siempre está `ACTIVE`. Usa Update Meter para archivarlo."
                  }
                }
              },
              "examples": {
                "Meter": {
                  "value": {
                    "account_id": "00000000-0000-4000-8000-000000000002",
                    "name": "AI tokens",
                    "description": "LLM tokens consumed by model responses, reported once per response",
                    "event_name": "ai_tokens",
                    "aggregation": "SUM",
                    "unit_label": "token",
                    "plural_unit_label": "tokens",
                    "default_price": {
                      "currency": "USD",
                      "value": 0.002
                    },
                    "metadata": [
                      {
                        "key": "team",
                        "value": "platform"
                      }
                    ]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "201",
            "content": {
              "application/json": {
                "examples": {
                  "Result": {
                    "value": {
                      "id": "55555555-5555-5555-5555-555555555555",
                      "account_id": "00000000-0000-4000-8000-000000000002",
                      "name": "AI tokens",
                      "description": "LLM tokens consumed by model responses, reported once per response",
                      "event_name": "ai_tokens",
                      "aggregation": "SUM",
                      "unit_label": "token",
                      "plural_unit_label": "tokens",
                      "default_price": {
                        "currency": "USD",
                        "value": 0.002
                      },
                      "metadata": [
                        {
                          "key": "team",
                          "value": "platform"
                        }
                      ],
                      "status": "ACTIVE",
                      "created_at": "2026-08-18T09:00:04.000000Z",
                      "updated_at": "2026-08-18T09:00:04.000000Z"
                    }
                  }
                },
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "description": "El identificador único del medidor."
                    },
                    "account_id": {
                      "type": "string",
                      "description": "El identificador único de la cuenta propietaria del medidor."
                    },
                    "name": {
                      "type": "string"
                    },
                    "description": {
                      "type": "string",
                      "nullable": true
                    },
                    "event_name": {
                      "type": "string"
                    },
                    "aggregation": {
                      "type": "string",
                      "enum": [
                        "SUM",
                        "COUNT",
                        "LAST"
                      ]
                    },
                    "unit_label": {
                      "type": "string",
                      "nullable": true
                    },
                    "plural_unit_label": {
                      "type": "string",
                      "nullable": true
                    },
                    "default_price": {
                      "type": "object",
                      "nullable": true,
                      "properties": {
                        "currency": {
                          "type": "string"
                        },
                        "value": {
                          "type": "number"
                        }
                      }
                    },
                    "metadata": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "key": {
                            "type": "string"
                          },
                          "value": {
                            "type": "string"
                          }
                        }
                      }
                    },
                    "status": {
                      "type": "string",
                      "enum": [
                        "ACTIVE",
                        "INACTIVE"
                      ],
                      "example": "ACTIVE"
                    },
                    "created_at": {
                      "type": "string",
                      "description": "Lo establece Yuno al crearlo."
                    },
                    "updated_at": {
                      "type": "string",
                      "description": "Lo establece Yuno en cada actualización."
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "400",
            "content": {
              "application/json": {
                "examples": {
                  "Invalid event_name": {
                    "summary": "Invalid event_name",
                    "value": {
                      "code": "INVALID_PARAMETERS",
                      "messages": [
                        "The field 'event_name' has an invalid value, it must contain only lowercase letters, numbers, underscores and dots."
                      ]
                    }
                  },
                  "Missing account_id": {
                    "summary": "Missing account_id",
                    "value": {
                      "code": "INVALID_PARAMETERS",
                      "messages": [
                        "The account_id is required"
                      ]
                    }
                  },
                  "Non-USD default_price": {
                    "summary": "Non-USD default_price",
                    "value": {
                      "code": "INVALID_PARAMETERS",
                      "messages": [
                        "The default_price currency must be USD"
                      ]
                    }
                  },
                  "Invalid aggregation": {
                    "summary": "Invalid aggregation",
                    "value": {
                      "code": "INVALID_PARAMETERS",
                      "messages": [
                        "The aggregation must be one of SUM, COUNT, LAST"
                      ]
                    }
                  }
                },
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "string"
                    },
                    "messages": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            }
          },
          "403": {
            "description": "403",
            "content": {
              "application/json": {
                "examples": {
                  "Product not enabled": {
                    "summary": "Product not enabled",
                    "value": {
                      "code": "PRODUCT_NOT_ENABLED",
                      "messages": [
                        "Usage-based billing is not enabled for this organization"
                      ]
                    }
                  }
                },
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "string",
                      "example": "PRODUCT_NOT_ENABLED"
                    },
                    "messages": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            }
          },
          "409": {
            "description": "409",
            "content": {
              "application/json": {
                "examples": {
                  "Result": {
                    "value": {
                      "code": "METER_EVENT_NAME_CONFLICT",
                      "messages": [
                        "A meter with event_name ai_tokens already exists for this account"
                      ]
                    }
                  }
                },
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "string"
                    },
                    "messages": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "deprecated": false
      }
    }
  },
  "x-readme": {
    "headers": [
      {
        "value": "utf-8",
        "key": "charset"
      }
    ],
    "explorer-enabled": true,
    "proxy-enabled": true
  },
  "x-readme-fauxas": true
}
