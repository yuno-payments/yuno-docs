{
  "openapi": "3.1.0",
  "info": {
    "title": "meters",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://api-sandbox.y.uno/v1",
      "description": "Sandbox"
    },
    {
      "url": "https://api.y.uno/v1",
      "description": "Production (US)"
    }
  ],
  "components": {
    "securitySchemes": {
      "sec0": {
        "type": "apiKey",
        "in": "header",
        "name": "public-api-key",
        "x-default": "<Your public-api-key>"
      },
      "sec1": {
        "type": "apiKey",
        "in": "header",
        "name": "private-secret-key",
        "x-default": "<Your private-secret-key>"
      }
    }
  },
  "security": [
    {
      "sec0": [],
      "sec1": []
    }
  ],
  "paths": {
    "/subscriptions/meters/events": {
      "post": {
        "summary": "Reportar evento de uso",
        "description": "La facturación por uso debe estar habilitada para tu organización antes de que este endpoint acepte solicitudes (de lo contrario, `403 PRODUCT_NOT_ENABLED`). Reporta un evento de uso para una suscripción. El medidor se resuelve a partir de `event_name`. La validación es síncrona: un evento mal formado o que no se puede resolver se rechaza con `400` y nunca se cuenta. Repetir el mismo `event_id` devuelve la respuesta original, incluido el `value` original, aunque el reintento haya enviado uno distinto, y nunca se cuenta dos veces. Las suscripciones `ACTIVE`, `TRIALING` y `PAST_DUE` aceptan uso; cualquier otro estado se rechaza con `400 SUBSCRIPTION_NOT_ACTIVE`. Un evento por solicitud.",
        "operationId": "report-usage-event",
        "parameters": [
          {
            "in": "header",
            "name": "X-Account-Code",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "El `account_id` que se encuentra en tu [Yuno Dashboard](https://dashboard.y.uno/developers) (UUID). Obligatorio: si lo omites, se devuelve `400 BAD_REQUEST` (\"Invalid x-account-code header.\")."
          },
          {
            "in": "header",
            "name": "X-Idempotency-Key",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Identificador único usado en los encabezados HTTP para garantizar que una solicitud se procese una sola vez, incluso si se reintenta por problemas de red o tiempos de espera agotados. Es opcional, igual que en el resto de la API de Yuno."
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "event_id",
                  "event_name",
                  "subscription_id"
                ],
                "properties": {
                  "event_id": {
                    "type": "string",
                    "description": "Tu identificador único para este evento: la clave de idempotencia. Único por cuenta. Volver a enviar el mismo `event_id` devuelve la misma respuesta (incluido el `value` original) y nunca cuenta el uso dos veces, sin importar los reintentos."
                  },
                  "event_name": {
                    "type": "string",
                    "description": "El `event_name` del medidor al que pertenece este evento. Resuelve el medidor dentro de tu cuenta; un medidor desconocido o `INACTIVE` se rechaza con `400 METER_NOT_FOUND`."
                  },
                  "subscription_id": {
                    "type": "string",
                    "description": "El identificador único de la suscripción a la que se atribuye el uso (MAX 64; MIN 36). Debe existir en tu cuenta (`400 SUBSCRIPTION_NOT_FOUND`) y estar `ACTIVE`, `TRIALING` o `PAST_DUE` (`400 SUBSCRIPTION_NOT_ACTIVE`). El uso se mide por suscripción y se factura en la renovación de esa suscripción."
                  },
                  "value": {
                    "type": "number",
                    "format": "float",
                    "description": "La cantidad que se registra para este evento. Obligatoria para los medidores `SUM`, `LAST` y `MAX`. NO debe enviarse para un medidor `COUNT`: un `value` explícito se rechaza con `400 BAD_REQUEST` (\"The value must not be provided for a COUNT meter.\"); cada evento COUNT se registra como `1`."
                  },
                  "occurred_at": {
                    "type": "string",
                    "description": "Cuándo ocurrió el uso (ISO 8601 con desfase). Por defecto es el momento en que se recibe el evento. Se acepta una fecha anterior de hasta 35 días atrás; los valores más antiguos se rechazan con `400 INVALID_PARAMETERS`. `occurred_at` decide en qué ciclo de facturación cae el evento."
                  },
                  "metadata": {
                    "type": "array",
                    "description": "Pares opcionales de clave y valor almacenados con el evento (MAX 48 entradas; value MAX 512).",
                    "items": {
                      "type": "object",
                      "properties": {
                        "key": {
                          "type": "string"
                        },
                        "value": {
                          "type": "string"
                        }
                      }
                    }
                  },
                  "meter_id": {
                    "type": "string",
                    "description": "Protección opcional. Si se envía, debe coincidir con el medidor resuelto a partir de `event_name`; de lo contrario, la solicitud se rechaza con `400 BAD_REQUEST` (\"The meter_id does not match the meter resolved for event_name '<event_name>'.\")."
                  }
                }
              },
              "examples": {
                "Sum meter (tokens)": {
                  "summary": "SUM meter — tokens consumed",
                  "value": {
                    "event_id": "11111111-1111-1111-1111-111111111111",
                    "event_name": "ai_tokens",
                    "subscription_id": "33333333-3333-3333-3333-333333333333",
                    "value": 1500,
                    "occurred_at": "2026-08-18T09:00:04Z",
                    "metadata": [
                      {
                        "key": "model",
                        "value": "llm-large"
                      }
                    ]
                  }
                },
                "Count meter (API request)": {
                  "summary": "COUNT meter — value omitted, counts as 1",
                  "value": {
                    "event_id": "req_01J5Y3Q9K8ZC5G6E4Y2W7X8N9M",
                    "event_name": "api_request",
                    "subscription_id": "33333333-3333-3333-3333-333333333333"
                  }
                },
                "Last meter (storage)": {
                  "summary": "LAST meter — current gigabytes held",
                  "value": {
                    "event_id": "storage-2026-08-18T09:00-sub-3333",
                    "event_name": "storage_gb",
                    "subscription_id": "33333333-3333-3333-3333-333333333333",
                    "value": 128.4,
                    "occurred_at": "2026-08-18T09:00:00Z"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "201",
            "content": {
              "application/json": {
                "examples": {
                  "Result": {
                    "value": {
                      "id": "22222222-2222-2222-2222-222222222222",
                      "event_id": "11111111-1111-1111-1111-111111111111",
                      "event_name": "ai_tokens",
                      "meter_id": "55555555-5555-5555-5555-555555555555",
                      "subscription_id": "33333333-3333-3333-3333-333333333333",
                      "value": 1500,
                      "received_at": "2026-08-18T09:00:04.000000Z"
                    }
                  }
                },
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "description": "Identificador de Yuno para el evento almacenado."
                    },
                    "event_id": {
                      "type": "string"
                    },
                    "event_name": {
                      "type": "string"
                    },
                    "meter_id": {
                      "type": "string"
                    },
                    "subscription_id": {
                      "type": "string"
                    },
                    "value": {
                      "type": "number"
                    },
                    "received_at": {
                      "type": "string",
                      "description": "Cuándo recibió Yuno el evento."
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "400",
            "content": {
              "application/json": {
                "examples": {
                  "Missing event_id": {
                    "summary": "Missing event_id",
                    "value": {
                      "code": "INVALID_PARAMETERS",
                      "messages": [
                        "The event_id is required"
                      ]
                    }
                  },
                  "Unknown subscription": {
                    "summary": "Unknown subscription",
                    "value": {
                      "code": "SUBSCRIPTION_NOT_FOUND",
                      "messages": [
                        "The subscription does not exist or is not linked to this account."
                      ]
                    }
                  },
                  "Missing value on SUM meter": {
                    "summary": "Missing value on SUM meter",
                    "value": {
                      "code": "INVALID_PARAMETERS",
                      "messages": [
                        "The value is required for a SUM meter"
                      ]
                    }
                  },
                  "Subscription not active": {
                    "summary": "Subscription not active",
                    "value": {
                      "code": "SUBSCRIPTION_NOT_ACTIVE",
                      "messages": [
                        "The subscription is not active"
                      ]
                    }
                  },
                  "occurred_at too old": {
                    "summary": "occurred_at too old",
                    "value": {
                      "code": "INVALID_PARAMETERS",
                      "messages": [
                        "The field 'occurred_at' has an invalid value, it must not be more than 35 days in the past."
                      ]
                    }
                  },
                  "meter_id mismatch": {
                    "summary": "meter_id mismatch",
                    "value": {
                      "code": "INVALID_PARAMETERS",
                      "messages": [
                        "The meter_id does not match the meter resolved from event_name"
                      ]
                    }
                  },
                  "Result": {
                    "value": {
                      "code": "METER_NOT_FOUND",
                      "messages": [
                        "No active meter with event_name ai_tokens exists for this account"
                      ]
                    },
                    "summary": "Unknown or inactive meter"
                  }
                },
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "string"
                    },
                    "messages": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            }
          },
          "403": {
            "description": "403",
            "content": {
              "application/json": {
                "examples": {
                  "Product not enabled": {
                    "summary": "Product not enabled",
                    "value": {
                      "code": "PRODUCT_NOT_ENABLED",
                      "messages": [
                        "Usage-based billing is not enabled for this organization"
                      ]
                    }
                  }
                },
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "string",
                      "example": "PRODUCT_NOT_ENABLED"
                    },
                    "messages": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "deprecated": false
      }
    }
  },
  "x-readme": {
    "headers": [
      {
        "value": "utf-8",
        "key": "charset"
      }
    ],
    "explorer-enabled": true,
    "proxy-enabled": true
  },
  "x-readme-fauxas": true
}
