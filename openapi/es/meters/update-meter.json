{
  "openapi": "3.1.0",
  "info": {
    "title": "meters",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://api-sandbox.y.uno/v1",
      "description": "Sandbox"
    },
    {
      "url": "https://api.y.uno/v1",
      "description": "Production (US)"
    }
  ],
  "components": {
    "securitySchemes": {
      "sec0": {
        "type": "apiKey",
        "in": "header",
        "name": "public-api-key",
        "x-default": "<Your public-api-key>"
      },
      "sec1": {
        "type": "apiKey",
        "in": "header",
        "name": "private-secret-key",
        "x-default": "<Your private-secret-key>"
      }
    }
  },
  "security": [
    {
      "sec0": [],
      "sec1": []
    }
  ],
  "paths": {
    "/subscriptions/meters/{meter_id}": {
      "patch": {
        "summary": "Actualizar medidor",
        "description": "La facturación por uso debe estar habilitada para tu organización antes de que este endpoint acepte solicitudes (de lo contrario, `403 PRODUCT_NOT_ENABLED`). Actualiza los campos descriptivos, el precio por defecto o el estado de un medidor. Envía al menos un campo. `event_name` y `aggregation` no se pueden modificar: si los envías, se ignoran sin avisar (sin error) y la respuesta muestra los valores originales. Establece `status: INACTIVE` para archivar un medidor: deja de aceptar eventos de uso (`400 METER_NOT_FOUND`), no se puede asociar a planes y sus precios medidos existentes ya no se pueden editar (`400 PLAN_METER_NOT_FOUND`); establece `status: ACTIVE` para reactivarlo. Archivar no libera el `event_name`: sigue reservado por el medidor archivado.",
        "operationId": "update-meter",
        "parameters": [
          {
            "in": "header",
            "name": "X-Account-Code",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "El `account_id` que se encuentra en tu [Yuno Dashboard](https://dashboard.y.uno/developers) (UUID). Obligatorio: si lo omites, se devuelve `400 BAD_REQUEST` (\"Invalid x-account-code header.\")."
          },
          {
            "name": "meter_id",
            "in": "path",
            "required": true,
            "description": "El identificador único del medidor.",
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "header",
            "name": "X-Idempotency-Key",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Identificador único usado en los encabezados HTTP para garantizar que una solicitud se procese una sola vez, incluso si se reintenta por problemas de red o tiempos de espera agotados. Es opcional, igual que en el resto de la API de Yuno."
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "description": "El nombre visible del medidor (MAX 255; MIN 3)."
                  },
                  "description": {
                    "type": "string",
                    "description": "Qué cuenta el medidor y cómo."
                  },
                  "unit_label": {
                    "type": "string",
                    "description": "Etiqueta de unidad en singular."
                  },
                  "plural_unit_label": {
                    "type": "string",
                    "description": "Etiqueta de unidad en plural."
                  },
                  "default_price": {
                    "type": "object",
                    "required": [
                      "currency",
                      "value"
                    ],
                    "properties": {
                      "currency": {
                        "type": "string",
                        "description": "Debe ser `USD`; de lo contrario, `400 INVALID_PARAMETERS`."
                      },
                      "value": {
                        "type": "number",
                        "format": "float",
                        "description": "Precio por defecto por unidad por encima de los créditos incluidos (múltiplo de 0.0001)."
                      }
                    }
                  },
                  "status": {
                    "type": "string",
                    "enum": [
                      "ACTIVE",
                      "INACTIVE"
                    ],
                    "description": "Establécelo en `INACTIVE` para archivar el medidor o en `ACTIVE` para reactivarlo. No existe la opción de eliminar. Archivar no desasocia el medidor de los planes a los que ya está asociado, y su `event_name` sigue reservado."
                  }
                }
              },
              "examples": {
                "Archive": {
                  "summary": "Archive the meter",
                  "value": {
                    "status": "INACTIVE"
                  }
                },
                "Rename": {
                  "summary": "Rename and change the default price",
                  "value": {
                    "name": "LLM Tokens",
                    "default_price": {
                      "currency": "USD",
                      "value": 0.0025
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "200",
            "content": {
              "application/json": {
                "examples": {
                  "Result": {
                    "value": {
                      "id": "55555555-5555-5555-5555-555555555555",
                      "account_id": "00000000-0000-4000-8000-000000000002",
                      "name": "AI tokens",
                      "description": "LLM tokens consumed by model responses, reported once per response",
                      "event_name": "ai_tokens",
                      "aggregation": "SUM",
                      "unit_label": "token",
                      "plural_unit_label": "tokens",
                      "default_price": {
                        "currency": "USD",
                        "value": 0.002
                      },
                      "metadata": [
                        {
                          "key": "team",
                          "value": "platform"
                        }
                      ],
                      "status": "INACTIVE",
                      "created_at": "2026-08-18T09:00:04.000000Z",
                      "updated_at": "2026-08-18T12:15:00.000000Z"
                    }
                  }
                },
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "description": "El identificador único del medidor."
                    },
                    "account_id": {
                      "type": "string",
                      "description": "El identificador único de la cuenta propietaria del medidor."
                    },
                    "name": {
                      "type": "string"
                    },
                    "description": {
                      "type": "string",
                      "nullable": true
                    },
                    "event_name": {
                      "type": "string"
                    },
                    "aggregation": {
                      "type": "string",
                      "enum": [
                        "SUM",
                        "COUNT",
                        "LAST"
                      ]
                    },
                    "unit_label": {
                      "type": "string",
                      "nullable": true
                    },
                    "plural_unit_label": {
                      "type": "string",
                      "nullable": true
                    },
                    "default_price": {
                      "type": "object",
                      "properties": {
                        "currency": {
                          "type": "string"
                        },
                        "value": {
                          "type": "number"
                        }
                      }
                    },
                    "metadata": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "key": {
                            "type": "string"
                          },
                          "value": {
                            "type": "string"
                          }
                        }
                      }
                    },
                    "status": {
                      "type": "string",
                      "enum": [
                        "ACTIVE",
                        "INACTIVE"
                      ],
                      "example": "ACTIVE"
                    },
                    "created_at": {
                      "type": "string",
                      "description": "Lo establece Yuno al crearlo."
                    },
                    "updated_at": {
                      "type": "string",
                      "description": "Lo establece Yuno en cada actualización."
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "400",
            "content": {
              "application/json": {
                "examples": {
                  "Empty body": {
                    "summary": "Empty body",
                    "value": {
                      "code": "INVALID_PARAMETERS",
                      "messages": [
                        "At least one field must be provided to update the meter"
                      ]
                    }
                  },
                  "Non-USD default_price": {
                    "summary": "Non-USD default_price",
                    "value": {
                      "code": "INVALID_PARAMETERS",
                      "messages": [
                        "The default_price currency must be USD"
                      ]
                    }
                  },
                  "Result": {
                    "value": {
                      "code": "METER_NOT_FOUND",
                      "messages": [
                        "The meter does not exist or is not linked to this account."
                      ]
                    }
                  }
                },
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "string"
                    },
                    "messages": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            }
          },
          "403": {
            "description": "403",
            "content": {
              "application/json": {
                "examples": {
                  "Product not enabled": {
                    "summary": "Product not enabled",
                    "value": {
                      "code": "PRODUCT_NOT_ENABLED",
                      "messages": [
                        "Usage-based billing is not enabled for this organization"
                      ]
                    }
                  }
                },
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "string",
                      "example": "PRODUCT_NOT_ENABLED"
                    },
                    "messages": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "No encontrado. El medidor no existe para esta cuenta.",
            "content": {
              "application/json": {
                "examples": {
                  "Not Found": {
                    "value": {
                      "code": "METER_NOT_FOUND",
                      "messages": [
                        "Meter not found."
                      ]
                    }
                  }
                },
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "string",
                      "example": "METER_NOT_FOUND"
                    },
                    "messages": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "example": "Meter not found."
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "deprecated": false
      }
    }
  },
  "x-readme": {
    "headers": [
      {
        "value": "utf-8",
        "key": "charset"
      }
    ],
    "explorer-enabled": true,
    "proxy-enabled": true
  },
  "x-readme-fauxas": true
}
