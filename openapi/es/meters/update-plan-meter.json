{
  "openapi": "3.1.0",
  "info": {
    "title": "meters",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://api-sandbox.y.uno/v1",
      "description": "Sandbox"
    },
    {
      "url": "https://api.y.uno/v1",
      "description": "Production (US)"
    }
  ],
  "components": {
    "securitySchemes": {
      "sec0": {
        "type": "apiKey",
        "in": "header",
        "name": "public-api-key",
        "x-default": "<Your public-api-key>"
      },
      "sec1": {
        "type": "apiKey",
        "in": "header",
        "name": "private-secret-key",
        "x-default": "<Your private-secret-key>"
      }
    }
  },
  "security": [
    {
      "sec0": [],
      "sec1": []
    }
  ],
  "paths": {
    "/subscriptions/plans/{plan_id}/meters/{meter_id}": {
      "patch": {
        "summary": "Actualizar medidor de un plan",
        "description": "La facturación por uso debe estar habilitada para tu organización antes de que este endpoint acepte solicitudes (de lo contrario, `403 PRODUCT_NOT_ENABLED`). Actualiza un precio medido ya asociado a un plan: los `credits` incluidos, `pricing_strategy`, `price_per_credit` y `country_prices`. Envía al menos un campo. El cambio se aplica al uso valorado a partir del siguiente ciclo de facturación de la suscripción. `package_size`, `package_price`, `package_country_prices` y `tiers` no se pueden enviar aquí: cualquier solicitud que contenga alguno se rechaza con `400 PLAN_METER_PRICING_CONFIG_UNSUPPORTED`; la configuración `PACKAGE`/`TIERED` solo se define al asociar, y el cambio de `pricing_strategy` se valida contra la configuración del precio medido para la estrategia de destino. Si el medidor está `INACTIVE`, el precio medido queda congelado y esta llamada devuelve `400 PLAN_METER_NOT_FOUND`. Para dejar de facturar un medidor en un plan, archiva el medidor (Update Meter con `status: INACTIVE`): no existe un endpoint para desasociarlo.",
        "operationId": "update-plan-meter",
        "parameters": [
          {
            "in": "header",
            "name": "X-Account-Code",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "El `account_id` que se encuentra en tu [Yuno Dashboard](https://dashboard.y.uno/developers) (UUID). Obligatorio: si lo omites, se devuelve `400 BAD_REQUEST` (\"Invalid x-account-code header.\")."
          },
          {
            "name": "plan_id",
            "in": "path",
            "required": true,
            "description": "El identificador único del plan.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "meter_id",
            "in": "path",
            "required": true,
            "description": "El identificador único del medidor asociado al plan.",
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "header",
            "name": "X-Idempotency-Key",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Identificador único usado en los encabezados HTTP para garantizar que una solicitud se procese una sola vez, incluso si se reintenta por problemas de red o tiempos de espera agotados. Es opcional, igual que en el resto de la API de Yuno."
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "credits": {
                    "type": "integer",
                    "description": "Unidades incluidas en el plan por ciclo de facturación: la cantidad que un suscriptor puede consumir antes de que se facture cualquier uso. Debe ser >= 0. `0` significa que se factura cada unidad."
                  },
                  "pricing_strategy": {
                    "type": "string",
                    "enum": [
                      "PER_UNIT",
                      "PACKAGE",
                      "TIERED"
                    ],
                    "description": "Cómo se calcula el precio del uso que excede `credits`: `PER_UNIT` (unidades facturables × `price_per_credit`), `PACKAGE` (paquetes de N unidades; un paquete parcial cuenta como uno completo) o `TIERED` (niveles graduados, cada tramo con su propia tarifa)."
                  },
                  "price_per_credit": {
                    "type": "object",
                    "required": [
                      "currency",
                      "value"
                    ],
                    "properties": {
                      "currency": {
                        "type": "string",
                        "description": "MAX 3; MIN 3. Debe ser igual a la moneda de `base_amount` del plan; de lo contrario, `400 INVALID_PARAMETERS`."
                      },
                      "value": {
                        "type": "number",
                        "format": "float",
                        "description": "Precio por unidad por encima de los créditos incluidos (múltiplo de 0.0001). Es opcional solo cuando la moneda base del plan es `USD` y el medidor tiene un `default_price`: en ese caso se aplica el valor por defecto del medidor y el precio medido se devuelve con `price_per_credit: null`. En los demás casos es obligatorio."
                      }
                    }
                  },
                  "country_prices": {
                    "type": "array",
                    "description": "Precio explícito opcional por unidad para cada país. Una entrada por país: un país repetido se rechaza con `400 INVALID_PARAMETERS`. Un país que no figure en la lista usa `price_per_credit`.",
                    "items": {
                      "type": "object",
                      "required": [
                        "country",
                        "amount"
                      ],
                      "properties": {
                        "country": {
                          "type": "string",
                          "description": "MAX 2; MIN 2; [ISO 3166-1](/reference/country-reference)."
                        },
                        "amount": {
                          "type": "object",
                          "required": [
                            "currency",
                            "value"
                          ],
                          "properties": {
                            "currency": {
                              "type": "string",
                              "description": "MAX 3; MIN 3; [ISO 4217](/reference/country-reference)."
                            },
                            "value": {
                              "type": "number",
                              "format": "float",
                              "description": "Múltiplo de 0.0001."
                            }
                          }
                        }
                      }
                    }
                  }
                }
              },
              "examples": {
                "Raise the allowance and lower the unit price": {
                  "value": {
                    "credits": 250,
                    "price_per_credit": {
                      "currency": "USD",
                      "value": 0.04
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "200",
            "content": {
              "application/json": {
                "examples": {
                  "Result": {
                    "value": {
                      "id": "77777777-7777-7777-7777-777777777777",
                      "plan_id": "00000000-0000-4000-8000-000000000001",
                      "meter_id": "66666666-6666-6666-6666-666666666666",
                      "credits": 250,
                      "pricing_strategy": "PER_UNIT",
                      "price_per_credit": {
                        "currency": "USD",
                        "value": 0.04
                      },
                      "country_prices": [
                        {
                          "country": "US",
                          "amount": {
                            "currency": "USD",
                            "value": 0.06
                          }
                        }
                      ],
                      "created_at": "2026-08-18T09:00:04.000000Z",
                      "updated_at": "2026-08-18T12:15:00.000000Z",
                      "package_size": null,
                      "package_price": null,
                      "package_country_prices": [],
                      "tiers": []
                    }
                  }
                },
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "description": "El identificador único del precio medido (la relación plan-medidor)."
                    },
                    "plan_id": {
                      "type": "string"
                    },
                    "meter_id": {
                      "type": "string"
                    },
                    "credits": {
                      "type": "integer",
                      "description": "Unidades incluidas en el plan por ciclo de facturación."
                    },
                    "pricing_strategy": {
                      "type": "string",
                      "enum": [
                        "PER_UNIT",
                        "PACKAGE",
                        "TIERED"
                      ]
                    },
                    "price_per_credit": {
                      "type": "object",
                      "nullable": true,
                      "description": "`null` cuando se hereda del `default_price` del medidor (planes en USD).",
                      "properties": {
                        "currency": {
                          "type": "string"
                        },
                        "value": {
                          "type": "number"
                        }
                      }
                    },
                    "country_prices": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "country": {
                            "type": "string"
                          },
                          "amount": {
                            "type": "object",
                            "properties": {
                              "currency": {
                                "type": "string"
                              },
                              "value": {
                                "type": "number"
                              }
                            }
                          }
                        }
                      }
                    },
                    "created_at": {
                      "type": "string",
                      "description": "Lo establece Yuno al crearlo."
                    },
                    "updated_at": {
                      "type": "string",
                      "description": "Lo establece Yuno en cada actualización."
                    },
                    "package_size": {
                      "type": "integer",
                      "nullable": true,
                      "description": "null cuando el medidor no se vende en paquetes"
                    },
                    "package_price": {
                      "type": "number",
                      "nullable": true,
                      "description": "null cuando el medidor no se vende en paquetes"
                    },
                    "package_country_prices": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "country": {
                            "type": "string"
                          },
                          "amount": {
                            "type": "object",
                            "properties": {
                              "currency": {
                                "type": "string"
                              },
                              "value": {
                                "type": "number"
                              }
                            }
                          }
                        }
                      },
                      "description": "Precios por país del paquete."
                    },
                    "tiers": {
                      "type": "array",
                      "items": {},
                      "description": "Niveles."
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "400",
            "content": {
              "application/json": {
                "examples": {
                  "Empty body": {
                    "summary": "Empty body",
                    "value": {
                      "code": "INVALID_PARAMETERS",
                      "messages": [
                        "At least one field must be provided"
                      ]
                    }
                  },
                  "Currency mismatch": {
                    "summary": "Currency mismatch",
                    "value": {
                      "code": "INVALID_PARAMETERS",
                      "messages": [
                        "The price_per_credit currency must match the plan base currency"
                      ]
                    }
                  },
                  "Missing price on non-USD plan": {
                    "summary": "Missing price on non-USD plan",
                    "value": {
                      "code": "INVALID_PARAMETERS",
                      "messages": [
                        "A price_per_credit is required when the plan base currency is not USD"
                      ]
                    }
                  },
                  "Missing price and no default": {
                    "summary": "Missing price and no default",
                    "value": {
                      "code": "INVALID_PARAMETERS",
                      "messages": [
                        "A price_per_credit is required when the meter has no default_price"
                      ]
                    }
                  },
                  "Negative credits": {
                    "summary": "Negative credits",
                    "value": {
                      "code": "INVALID_PARAMETERS",
                      "messages": [
                        "The meter credits must be greater than or equal to 0"
                      ]
                    }
                  },
                  "Invalid strategy": {
                    "summary": "Invalid strategy",
                    "value": {
                      "code": "INVALID_PARAMETERS",
                      "messages": [
                        "The meter pricing_strategy must be one of PER_UNIT, PACKAGE, TIERED"
                      ]
                    }
                  },
                  "Duplicate country": {
                    "summary": "Duplicate country",
                    "value": {
                      "code": "INVALID_PARAMETERS",
                      "messages": [
                        "The country_prices must not contain duplicate countries"
                      ]
                    }
                  },
                  "Unknown or inactive meter": {
                    "summary": "Unknown or inactive meter",
                    "value": {
                      "code": "METER_NOT_FOUND",
                      "messages": [
                        "The meter does not exist, is inactive or is not linked to this account."
                      ]
                    }
                  },
                  "Unknown plan": {
                    "summary": "Unknown plan",
                    "value": {
                      "code": "PLAN_NOT_FOUND",
                      "messages": [
                        "The plan does not exist or is not linked to this account."
                      ]
                    }
                  },
                  "Meter not attached to the plan, or inactive": {
                    "summary": "Meter not attached to the plan, or inactive",
                    "value": {
                      "code": "PLAN_METER_NOT_FOUND",
                      "messages": [
                        "The meter 66666666-6666-6666-6666-666666666666 is not assigned to this plan"
                      ]
                    }
                  }
                },
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "string"
                    },
                    "messages": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            }
          },
          "403": {
            "description": "403",
            "content": {
              "application/json": {
                "examples": {
                  "Product not enabled": {
                    "summary": "Product not enabled",
                    "value": {
                      "code": "PRODUCT_NOT_ENABLED",
                      "messages": [
                        "Usage-based billing is not enabled for this organization"
                      ]
                    }
                  }
                },
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "string",
                      "example": "PRODUCT_NOT_ENABLED"
                    },
                    "messages": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "404",
            "content": {
              "application/json": {
                "examples": {
                  "PLAN METER NOT FOUND": {
                    "value": {
                      "code": "PLAN_METER_NOT_FOUND",
                      "messages": [
                        "This meter is not attached to this plan."
                      ]
                    },
                    "summary": "The meter exists and the plan exists, but the meter is not attached to that plan."
                  }
                }
              }
            }
          }
        },
        "deprecated": false
      }
    }
  },
  "x-readme": {
    "headers": [
      {
        "value": "utf-8",
        "key": "charset"
      }
    ],
    "explorer-enabled": true,
    "proxy-enabled": true
  },
  "x-readme-fauxas": true
