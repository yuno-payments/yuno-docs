{
  "openapi": "3.1.0",
  "info": {
    "title": "plans",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://api-sandbox.y.uno/v1",
      "description": "Sandbox"
    },
    {
      "url": "https://api.y.uno/v1",
      "description": "Production (US)"
    },
    {
      "url": "https://api.eu.y.uno/v1",
      "description": "Production (EMEA)"
    }
  ],
  "components": {
    "securitySchemes": {
      "sec0": {
        "type": "apiKey",
        "in": "header",
        "name": "public-api-key",
        "x-default": "<Your public-api-key>"
      },
      "sec1": {
        "type": "apiKey",
        "in": "header",
        "name": "private-secret-key",
        "x-default": "<Your private-secret-key>"
      }
    }
  },
  "security": [
    {
      "sec0": [],
      "sec1": []
    }
  ],
  "paths": {
    "/subscriptions/plans/{plan_id}/promotions/{promotion_id}": {
      "delete": {
        "summary": "Eliminar promoción del plan",
        "description": "Elimina la asociación de una promoción con el plan. Las suscripciones que ya tienen la promoción no cambian: conservan su copia hasta que esté en `COMPLETED` o `ENDED`.",
        "operationId": "remove-plan-promotion",
        "parameters": [
          {
            "in": "header",
            "name": "X-Account-Code",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "El `account_id` que se encuentra en tu [Yuno Dashboard](https://dashboard.y.uno/developers) (UUID). Obligatorio: si lo omites, se devuelve `400 BAD_REQUEST` (\"Invalid x-account-code header.\")."
          },
          {
            "name": "plan_id",
            "in": "path",
            "description": "El identificador único del plan.",
            "schema": {
              "type": "string"
            },
            "required": true
          },
          {
            "name": "promotion_id",
            "in": "path",
            "description": "El ID de la promoción que se elimina del plan (UUID).",
            "schema": {
              "type": "string"
            },
            "required": true
          }
        ],
        "responses": {
          "204": {
            "description": "204. La promoción se eliminó del plan. La respuesta no tiene cuerpo."
          },
          "404": {
            "description": "404. El plan no existe (`PLAN_NOT_FOUND`) o la promoción no está asociada a este plan (`PROMOTION_NOT_FOUND`).",
            "content": {
              "application/json": {
                "examples": {
                  "Result": {
                    "value": {
                      "code": "PROMOTION_NOT_FOUND",
                      "messages": [
                        "Promotion not found."
                      ]
                    }
                  }
                },
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "string"
                    },
                    "messages": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "x-readme": {
    "headers": [
      {
        "value": "utf-8",
        "key": "charset"
      }
    ],
    "explorer-enabled": true,
    "proxy-enabled": true
  },
  "x-readme-fauxas": true
}
