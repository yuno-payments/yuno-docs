                        "updated_at": "2022-05-16T20:46:54.786342Z",
                        "expires_at": "2022-05-16T20:46:54.786342Z",
                        "status": "DOWNLOADED"
                      }
                    ]
                  }
                },
                "schema": {
                  "type": "array",
