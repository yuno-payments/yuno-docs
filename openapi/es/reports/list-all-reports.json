  "paths": {
    "/reports/list": {
      "get": {
        "summary": "Listar todos los reportes",
        "description": "",
        "operationId": "list-all-reports",
        "parameters": [
          {
            "name": "X-Organization-Code",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Código de la organización asociado a la solicitud."
          },
          {
            "name": "account_id",
            "in": "query",
            "description": "Identificador único de la cuenta. Para solicitar la creación de un reporte con todas las cuentas, no envíes este parámetro. De lo contrario, indica todos los account_id que quieras incluir (MAX 64; MIN 36).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "page_size",
            "in": "query",
            "description": "Límite de reportes que se obtendrán. Valor predeterminado 1 y máximo 99 (MAX 2; MIN 1).",
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          },
          {
            "name": "page_number",
            "in": "query",
            "required": false,
            "description": "Página inicial de los reportes. Valor predeterminado 1 y máximo 10 (MAX 2; MIN 1).",
            "schema": {
              "type": "integer",
              "format": "int32",
              "default": 1
            }
          },
          {
            "name": "start_date",
            "in": "query",
            "description": "Reportes creados en esta fecha o después (ISO 8601 MAX 27; MIN 27).",
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "end_date",
            "in": "query",
            "description": "Reportes creados en esta fecha o antes (ISO 8601 MAX 27; MIN 27).",
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "200",
            "content": {
              "application/json": {
                "examples": {
                  "Result": {
                    "value": [
                      {
