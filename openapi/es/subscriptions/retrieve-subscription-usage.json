{
  "openapi": "3.1.0",
  "info": {
    "title": "subscription",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://api-sandbox.y.uno/v1"
    },
    {
      "url": "https://api.y.uno/v1"
    }
  ],
  "components": {
    "securitySchemes": {
      "sec0": {
        "type": "apiKey",
        "in": "header",
        "name": "public-api-key",
        "x-default": "<Your public-api-key>"
      },
      "sec1": {
        "type": "apiKey",
        "in": "header",
        "name": "private-secret-key",
        "x-default": "<Your private-secret-key>"
      }
    }
  },
  "security": [
    {
      "sec0": [],
      "sec1": []
    }
  ],
  "paths": {
    "/subscriptions/{subscription_id}/usage": {
      "get": {
        "summary": "Retrieve Subscription Usage",
        "description": "Devuelve el uso medido que una suscripción ha acumulado en su período de facturación actual, valorado según los medidores asociados a su plan. Un ítem por medidor, con la cantidad agregada, la cantidad que realmente se factura después de consumir los créditos incluidos, el precio unitario y el monto resultante, más un total del período.",
        "operationId": "retrieve-subscription-usage",
        "parameters": [
          {
            "name": "subscription_id",
            "in": "path",
            "description": "El identificador único de la suscripción.",
            "schema": {
              "type": "string"
            },
            "required": true
          },
          {
            "in": "header",
            "name": "X-Account-Code",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "El `account_id` que encuentras en tu [Dashboard de Yuno](https://dashboard.y.uno/developers) (UUID)."
          }
        ],
        "responses": {
          "200": {
            "description": "200",
            "content": {
              "application/json": {
                "examples": {
                  "Result": {
                    "value": {
                      "subscription_code": "c2094820-df10-4bd4-b7ef-dbe0d28db857",
                      "period": {
                        "start": "2026-09-15T15:54:32.436443Z",
                        "end": "2026-10-15T15:54:32.272111Z"
                      },
                      "currency": "COP",
                      "items": [
                        {
                          "meter_code": "b7cb6aad-0fcc-4898-ae8b-f500ee6dfbb3",
                          "event_name": "lifecycle_1789487669444",
                          "aggregation": "SUM",
                          "quantity": 20,
                          "credits": 0,
                          "billable_quantity": 20,
                          "remaining_credits": 0,
                          "unit_price": {
                            "currency": "COP",
                            "value": 500
                          },
                          "amount": {
                            "currency": "COP",
                            "value": 10000
                          },
                          "events_count": 2,
                          "last_event_at": "2026-09-15T15:54:46.620383Z"
                        }
                      ],
                      "total": {
                        "currency": "COP",
                        "value": 10000
                      }
                    }
                  }
                },
                "schema": {
                  "type": "object",
                  "properties": {
                    "subscription_code": {
                      "type": "string",
                      "example": "c2094820-df10-4bd4-b7ef-dbe0d28db857"
                    },
                    "period": {
                      "type": "object",
                      "description": "El período de facturación actual de la suscripción.",
                      "properties": {
                        "start": {
                          "type": "string",
                          "example": "2026-09-15T15:54:32.436443Z"
                        },
                        "end": {
                          "type": "string",
                          "example": "2026-10-15T15:54:32.272111Z"
                        }
                      }
                    },
                    "currency": {
                      "type": "string",
                      "example": "COP"
                    },
                    "items": {
                      "type": "array",
                      "description": "Una entrada por cada medidor asociado al plan de la suscripción. Vacío cuando el plan no tiene medidores o la suscripción no tiene plan.",
                      "items": {
                        "type": "object",
                        "properties": {
                          "meter_code": {
                            "type": "string"
                          },
                          "event_name": {
                            "type": "string"
                          },
                          "aggregation": {
                            "type": "string",
                            "description": "SUM, COUNT o LAST: consulta Meters."
                          },
                          "quantity": {
                            "type": "number",
                            "description": "La cantidad agregada informada para este medidor en el período."
                          },
                          "credits": {
                            "type": "number",
                            "description": "Créditos incluidos consumidos contra la cantidad de este medidor."
                          },
                          "billable_quantity": {
                            "type": "number",
                            "description": "La cantidad que realmente se factura después de consumir los créditos."
                          },
                          "remaining_credits": {
                            "type": "number"
                          },
                          "unit_price": {
                            "type": "object",
                            "properties": {
                              "currency": {
                                "type": "string"
                              },
                              "value": {
                                "type": "number"
                              }
                            }
                          },
                          "amount": {
                            "type": "object",
                            "description": "billable_quantity valorada a unit_price.",
                            "properties": {
                              "currency": {
                                "type": "string"
                              },
                              "value": {
                                "type": "number"
                              }
                            }
                          },
                          "events_count": {
                            "type": "integer",
                            "description": "Cuántos eventos de uso se informaron para este medidor en el período."
                          },
                          "last_event_at": {
                            "type": "string"
                          }
                        }
                      }
                    },
                    "total": {
                      "type": "object",
                      "description": "La suma del monto de todos los ítems del período. Cero cuando items está vacío.",
                      "properties": {
                        "currency": {
                          "type": "string"
                        },
                        "value": {
                          "type": "number"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "401",
            "content": {
              "application/json": {
                "examples": {
                  "Invalid credentials": {
                    "value": {
                      "code": "INVALID_CREDENTIALS",
                      "messages": [
                        "Invalid Credentials"
                      ]
                    },
                    "summary": "Invalid credentials"
                  }
                },
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "string",
                      "example": "INVALID_CREDENTIALS"
                    },
                    "messages": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "example": "Invalid Credentials"
                      }
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "404",
            "content": {
              "application/json": {
                "examples": {
                  "NOT_FOUND": {
                    "value": {
                      "code": "NOT_FOUND",
                      "messages": [
                        "Subscription not found."
                      ]
                    }
                  }
                },
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "string",
                      "example": "NOT_FOUND"
                    },
                    "messages": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "deprecated": false
      }
    }
  },
  "x-readme": {
    "headers": [
      {
        "value": "utf-8",
        "key": "charset"
      }
    ],
    "explorer-enabled": true,
    "proxy-enabled": true
  },
  "x-readme-fauxas": true
}
