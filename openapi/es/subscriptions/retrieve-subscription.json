                    "retries": {
                      "type": "object",
                      "nullable": true,
                      "description": "La política de reintentos que se aplica cuando se rechaza un cobro recurrente. Consulta [Reintentos](/es/docs/payment-features/subscriptions/retries).",
                      "properties": {
                        "retry_on_decline": {
                          "type": "boolean",
                          "description": "Indica si los cobros rechazados se reintentan o no.",
                          "example": true
                        },
                        "amount": {
                          "type": "integer",
                          "description": "Cuántos reintentos tiene un ciclo de facturación. Limitado por la longitud del calendario de reintentos de tu entorno (6 en producción).",
                          "example": 4
                        },
                        "strategy": {
                          "type": "string",
                          "description": "Cómo se decide el momento de cada reintento: `DEFAULT`, `SMART` o `CUSTOM_SCHEDULE`. Trátalo como un valor abierto: maneja los valores no reconocidos de forma adecuada.",
                          "example": "DEFAULT"
                        },
                        "schedule": {
                          "type": "array",
                          "nullable": true,
                          "description": "El calendario por intento, que solo se define cuando `strategy` es `CUSTOM_SCHEDULE`; en caso contrario es `null`.",
                          "items": {
                            "type": "object"
                          }
                        },
                        "stop_on_hard_decline": {
                          "type": "boolean",
                          "nullable": true,
                          "description": "Cuando es true, un rechazo definitivo detiene los reintentos del ciclo de facturación actual."
                        },
                        "cancel_on_exhausted_retries": {
                          "type": "boolean",
                          "nullable": true,
                          "description": "Cuando es true, la suscripción se cancela cuando terminan los reintentos de un ciclo sin un pago exitoso, con `cancellation_source` definido como `RETRIES_EXHAUSTED`."
                        },
                        "profile": {
                          "type": "string",
                          "description": "La escalera de reintentos fija que sigue la suscripción en lugar del calendario configurable. Siempre es `PIX_AUTOMATIC`. Este campo y los tres siguientes solo están presentes en las suscripciones `PIX_AUTOMATIC` que ejecuta Yuno; están ausentes, no son `null`, en cualquier otro método de pago. Consulta [Pix Automático](/es/docs/payment-features/subscriptions/pix-automatico#the-retry-ladder).",
                          "example": "PIX_AUTOMATIC"
                        },
                        "max_attempts": {
                          "type": "integer",
                          "description": "Cuántos reintentos ejecuta la escalera de Pix. Siempre es 3, igual que el `amount` informado para estas suscripciones.",
                          "example": 3
                        },
                        "min_gap_hours": {
                          "type": "integer",
                          "description": "Siempre 24: el intervalo entre las fechas de débito de la escalera (`D`, `D+1`, `D+2`, `D+3`), no entre los intentos de envío.",
                          "example": 24
                        },
                        "until": {
                          "type": "string",
                          "description": "Cuándo se detiene la escalera: `billing_cycles.next_at` más 7 días. Se mueve con `next_at` en cada renovación."
                        },
                        "stopped": {
                          "type": "boolean",
                          "description": "Solo está presente cuando la suscripción está en PAST_DUE o tiene cancel_scheduled pendiente."
                        },
                        "attempts_made": {
                          "type": "integer",
                          "description": "Solo está presente cuando la suscripción está en PAST_DUE o tiene cancel_scheduled pendiente."
                        },
                        "outcome": {
                          "type": "string",
                          "description": "RECOVERED, EXHAUSTED o ABANDONED. Solo está presente cuando la suscripción está en PAST_DUE o tiene cancel_scheduled pendiente."
                        },
                        "next_retry_at": {
                          "type": "string",
                          "description": "Solo está presente cuando la suscripción está en PAST_DUE o tiene cancel_scheduled pendiente."
                        }
                      }
                    },
                    "trial_period": {
                      "type": "object",
                      "properties": {
                        "billing_cycles": {
                          "type": "integer",
                          "example": 1,
                          "default": 0
