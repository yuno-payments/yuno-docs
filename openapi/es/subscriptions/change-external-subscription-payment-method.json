{
  "openapi": "3.1.0",
  "info": {
    "title": "subscription",
    "version": "1.0.2"
  },
  "servers": [
    {
      "url": "https://api-sandbox.y.uno/v1",
      "description": "Sandbox"
    },
    {
      "url": "https://api.y.uno/v1",
      "description": "Production (US)"
    }
  ],
  "security": [
    {
      "sec0": [],
      "sec1": []
    }
  ],
  "paths": {
    "/external-subscriptions/{external_subscription_id}/payment-method": {
      "post": {
        "summary": "Set External Subscription Payment Method",
        "description": "Define el método de pago que cobra una suscripción de Stripe Billing, sin un pago. Úsalo en dos casos:\n\n- **La suscripción todavía no está vinculada a Yuno**: Yuno la vincula a una tarjeta que el cliente ya verificó en Yuno. La suscripción de Stripe tiene que estar `active` o `trialing`, cobrarse automáticamente (`collection_method: charge_automatically`) y pertenecer a `external_customer_id`. La tarjeta tiene que haberse verificado antes, para que Yuno pueda cobrar las renovaciones como iniciadas por el comercio.\n- **La suscripción ya está vinculada**: Yuno la mueve a otro método de pago que el cliente ya inscribió en Yuno.\n\nNo se realiza ningún pago: Yuno no cobra al cliente y no ejecuta una verificación de $0 ni 3DS. Las próximas renovaciones cobran el método de pago de `vaulted_token`.\n\n`customer_payer.id` es el ID de cliente de Yuno; `external_customer_id` es el ID de cliente de Stripe (`cus_...`). Enviar el método de pago que la suscripción ya cobra devuelve `200` con `result` `NO_CHANGE`.\n\nEsta API se habilita por cuenta: contacta a tu Key Account Manager para solicitar acceso.",
        "operationId": "change-external-subscription-payment-method",
        "parameters": [
          {
            "name": "external_subscription_id",
            "in": "path",
            "description": "El ID de la suscripción en la plataforma de facturación, por ejemplo el ID de suscripción de Stripe (`sub_...`). Entre 3 y 255 caracteres.",
            "schema": {
              "type": "string",
              "minLength": 3,
              "maxLength": 255
            },
            "required": true,
            "example": "sub_1QF2abc"
          },
          {
            "name": "X-Idempotency-Key",
            "in": "header",
            "description": "Clave única para este cambio, por ejemplo un UUID. Obligatoria: una solicitud sin ella devuelve `400` `INVALID_PARAMETERS`. Repetir la misma clave con la misma solicitud devuelve el resultado de la primera solicitud. Reutilizar una clave para otra suscripción u otro método de pago devuelve `400` `INVALID_PARAMETERS`. Para reintentar después de un `502`, envía una clave nueva.",
            "schema": {
              "type": "string"
            },
            "required": true,
            "example": "7c2e0a4b-3f5d-4c1e-9b8a-6d2f1e0c9a77"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "account_id",
                  "customer_payer",
                  "vaulted_token",
                  "external_customer_id"
                ],
                "properties": {
                  "account_id": {
                    "type": "string",
                    "format": "uuid",
                    "description": "El identificador único (UUID) de la cuenta de Yuno incorporada al billing bridge.",
                    "examples": [
                      "9104911d-5df9-429e-8488-ad41abea1a4b"
                    ]
                  },
                  "customer_payer": {
                    "type": "object",
                    "required": [
                      "id"
                    ],
                    "description": "El cliente que es dueño de la suscripción y del método de pago.",
                    "properties": {
                      "id": {
                        "type": "string",
                        "format": "uuid",
                        "description": "El ID de cliente de Yuno (UUID) que es dueño de la suscripción. No es el ID de cliente de Stripe (`cus_...`).",
                        "examples": [
                          "cfae0941-7234-427a-a739-ef4fce966c79"
                        ]
                      }
                    }
                  },
                  "vaulted_token": {
                    "type": "string",
                    "format": "uuid",
                    "description": "El token del vault (UUID) de uno de los métodos de pago inscritos del cliente. La suscripción lo cobra a partir de ahora.",
                    "examples": [
                      "2deff5c9-da62-4888-8f05-df76ab2967a5"
                    ]
                  },
                  "external_customer_id": {
                    "type": "string",
                    "minLength": 3,
                    "maxLength": 255,
                    "description": "El ID de cliente de Stripe (`cus_...`) de la suscripción. Entre 3 y 255 caracteres. Yuno verifica que la suscripción de Stripe pertenezca a este cliente.",
                    "examples": [
                      "cus_RplXYZ"
                    ]
                  }
                }
              },
              "examples": {
                "Change the payment method": {
                  "value": {
                    "account_id": "9104911d-5df9-429e-8488-ad41abea1a4b",
                    "customer_payer": {
                      "id": "cfae0941-7234-427a-a739-ef4fce966c79"
                    },
                    "vaulted_token": "2deff5c9-da62-4888-8f05-df76ab2967a5",
                    "external_customer_id": "cus_RplXYZ"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "La suscripción ahora cobra el método de pago de `vaulted_token`. `result` indica si se vinculó, si cambió o si ya usaba ese método de pago.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "external_subscription_id": {
                      "type": "string",
                      "description": "El ID de la suscripción en la plataforma de facturación externa."
                    },
                    "account_id": {
                      "type": "string",
                      "format": "uuid",
                      "description": "El ID de cuenta de Yuno de la solicitud."
                    },
                    "customer_payer": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "string",
                          "format": "uuid",
                          "description": "El ID de cliente de Yuno de la solicitud."
                        }
                      }
                    },
                    "vaulted_token": {
                      "type": "string",
                      "format": "uuid",
                      "description": "El token del vault que la suscripción cobra a partir de ahora."
                    },
                    "external_customer_id": {
                      "type": "string",
                      "description": "El ID de cliente de Stripe de la solicitud."
                    },
                    "result": {
                      "type": "string",
                      "enum": [
                        "LINKED",
                        "PAYMENT_METHOD_CHANGED",
                        "NO_CHANGE"
                      ],
                      "description": "`LINKED` cuando la suscripción todavía no estaba vinculada a Yuno, `PAYMENT_METHOD_CHANGED` cuando pasó a este método de pago, `NO_CHANGE` cuando ya lo cobraba."
                    }
                  }
                },
                "examples": {
                  "Subscription linked": {
                    "value": {
                      "external_subscription_id": "sub_1QF2abc",
                      "account_id": "9104911d-5df9-429e-8488-ad41abea1a4b",
                      "customer_payer": {
                        "id": "cfae0941-7234-427a-a739-ef4fce966c79"
                      },
                      "vaulted_token": "2deff5c9-da62-4888-8f05-df76ab2967a5",
                      "external_customer_id": "cus_RplXYZ",
                      "result": "LINKED"
                    }
                  },
                  "Payment method changed": {
                    "value": {
                      "external_subscription_id": "sub_1QF2abc",
                      "account_id": "9104911d-5df9-429e-8488-ad41abea1a4b",
                      "customer_payer": {
                        "id": "cfae0941-7234-427a-a739-ef4fce966c79"
                      },
                      "vaulted_token": "2deff5c9-da62-4888-8f05-df76ab2967a5",
                      "external_customer_id": "cus_RplXYZ",
                      "result": "PAYMENT_METHOD_CHANGED"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "La solicitud no es válida, no se encontró el cliente, el método de pago o la suscripción o no coinciden, o la suscripción o la tarjeta no se pueden vincular.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "examples": {
                  "INVALID_PARAMETERS": {
                    "value": {
                      "code": "INVALID_PARAMETERS",
                      "messages": [
                        "The field 'customer_payer.id' is required and must be a UUID."
                      ]
                    }
                  },
                  "CUSTOMER_NOT_FOUND": {
                    "value": {
                      "code": "CUSTOMER_NOT_FOUND",
                      "messages": [
                        "The customer does not exist in the account."
                      ]
                    }
                  },
                  "VAULTED_TOKEN_NOT_FOUND": {
                    "value": {
                      "code": "VAULTED_TOKEN_NOT_FOUND",
                      "messages": [
                        "The vaulted_token is not one of the customer's payment methods."
                      ]
                    }
                  },
                  "EXTERNAL_SUBSCRIPTION_NOT_FOUND": {
                    "value": {
                      "code": "EXTERNAL_SUBSCRIPTION_NOT_FOUND",
                      "messages": [
                        "The billing platform has no subscription with this id for the account."
                      ]
                    }
                  },
                  "CUSTOMER_MISMATCH": {
                    "value": {
                      "code": "CUSTOMER_MISMATCH",
                      "messages": [
                        "The external subscription belongs to another customer or to another external_customer_id."
                      ]
                    }
                  },
                  "VAULTED_TOKEN_NOT_ENROLLED": {
                    "value": {
                      "code": "VAULTED_TOKEN_NOT_ENROLLED",
                      "messages": [
                        "The vaulted_token is not enrolled."
                      ]
                    }
                  },
                  "VAULTED_TOKEN_WITHOUT_COUNTRY": {
                    "value": {
                      "code": "VAULTED_TOKEN_WITHOUT_COUNTRY",
                      "messages": [
                        "The vaulted_token has no country."
                      ]
                    }
                  },
                  "VAULTED_TOKEN_WITHOUT_NETWORK_TRANSACTION_ID": {
                    "value": {
                      "code": "VAULTED_TOKEN_WITHOUT_NETWORK_TRANSACTION_ID",
                      "messages": [
                        "The vaulted_token has no network transaction id to charge the renewals merchant-initiated."
                      ]
                    }
                  },
                  "EXTERNAL_SUBSCRIPTION_NOT_ACTIVE": {
                    "value": {
                      "code": "EXTERNAL_SUBSCRIPTION_NOT_ACTIVE",
                      "messages": [
                        "The external subscription is neither active nor trialing."
                      ]
                    }
                  },
                  "EXTERNAL_SUBSCRIPTION_NOT_CHARGED_AUTOMATICALLY": {
                    "value": {
                      "code": "EXTERNAL_SUBSCRIPTION_NOT_CHARGED_AUTOMATICALLY",
                      "messages": [
                        "The external subscription is not charged automatically."
                      ]
                    }
                  }
                }
              }
            }
          },
          "403": {
            "description": "PRODUCT_NOT_ENABLED: la cuenta no está habilitada para el billing bridge. Contacta a tu Key Account Manager.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "examples": {
                  "PRODUCT_NOT_ENABLED": {
                    "value": {
                      "code": "PRODUCT_NOT_ENABLED",
                      "messages": [
                        "External subscriptions are not enabled for this account. Please contact your Key Account Manager."
                      ]
                    }
                  }
                }
              }
            }
          },
          "409": {
            "description": "CONCURRENT_CHANGE: otro cambio de método de pago para esta suscripción se completó primero. EXTERNAL_SUBSCRIPTION_PENDING_ACTIVATION: la suscripción se está migrando a Yuno; reintenta cuando termine la migración.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "examples": {
                  "CONCURRENT_CHANGE": {
                    "value": {
                      "code": "CONCURRENT_CHANGE",
                      "messages": [
                        "Another payment method change for this subscription completed first."
                      ]
                    }
                  },
                  "EXTERNAL_SUBSCRIPTION_PENDING_ACTIVATION": {
                    "value": {
                      "code": "EXTERNAL_SUBSCRIPTION_PENDING_ACTIVATION",
                      "messages": [
                        "The external subscription is being migrated to Yuno. Retry once the migration finishes."
                      ]
                    }
                  }
                }
              }
            }
          },
          "502": {
            "description": "BILLING_PLATFORM_ERROR: la plataforma de facturación no pudo confirmar el cambio. La suscripción sigue cobrando lo mismo que antes. Reintenta con una nueva clave de idempotencia.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "examples": {
                  "BILLING_PLATFORM_ERROR": {
                    "value": {
                      "code": "BILLING_PLATFORM_ERROR",
                      "messages": [
                        "The billing platform could not confirm the change. The subscription keeps charging what it charged before. Retry with a new idempotency key."
                      ]
                    }
                  }
                }
              }
            }
          }
        },
        "deprecated": false
      }
    }
  },
  "components": {
    "securitySchemes": {
      "sec0": {
        "type": "apiKey",
        "in": "header",
        "name": "public-api-key"
      },
      "sec1": {
        "type": "apiKey",
        "in": "header",
        "name": "private-secret-key"
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "description": "El código de error."
          },
          "messages": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Detalles legibles sobre el error."
          }
        }
      }
    }
  }
}
