{
  "openapi": "3.1.0",
  "info": {
    "title": "Account Groups API - Retrieve",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://api-sandbox.y.uno/v1",
      "description": "Sandbox"
    },
    {
      "url": "https://api.y.uno/v1",
      "description": "Production (US)"
    }
  ],
  "components": {
    "securitySchemes": {
      "sec0": {
        "type": "apiKey",
        "in": "header",
        "name": "PUBLIC-API-KEY",
        "x-default": "<Your PUBLIC-API-KEY>"
      },
      "sec1": {
        "type": "apiKey",
        "in": "header",
        "name": "PRIVATE-SECRET-KEY",
        "x-default": "<Your PRIVATE-SECRET-KEY>"
      }
    }
  },
  "security": [
    {
      "sec0": [],
      "sec1": []
    }
  ],
  "paths": {
    "/organizations/account-groups/{account_group_id}": {
      "get": {
        "summary": "Recuperar un grupo de cuentas",
        "operationId": "retrieve-account-group",
        "description": "Obtiene un grupo de cuentas específico por UUID.",
        "parameters": [
          {
            "name": "account_group_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "UUID del grupo de cuentas."
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "format": "uuid"
                    },
                    "name": {
                      "type": "string"
                    },
                    "merchant_id": {
                      "type": "string"
                    },
                    "parent_code": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "format": "uuid",
                      "description": "El `id` del grupo bajo el cual se anida este grupo. `null` para un grupo raíz (de nivel superior)."
                    },
                    "created_at": {
                      "type": "string",
                      "format": "date-time"
                    },
                    "updated_at": {
                      "type": "string",
                      "format": "date-time"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "No encontrado. Cuando ningún grupo de cuentas coincide con el id, la API devuelve HTTP 400 con `code` establecido en `\"404\"`.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "string",
                      "example": "404"
                    },
                    "messages": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  }
                },
                "example": {
                  "code": "404",
                  "messages": [
                    "Account group not found"
                  ]
                }
              }
            }
          }
        }
      }
    }
  }
}
