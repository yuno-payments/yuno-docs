{
  "openapi": "3.1.0",
  "info": {
    "title": "Roles API - Delete",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://api-sandbox.y.uno/v1",
      "description": "Sandbox"
    },
    {
      "url": "https://api.y.uno/v1",
      "description": "Production (US)"
    }
  ],
  "components": {
    "securitySchemes": {
      "sec0": {
        "type": "apiKey",
        "in": "header",
        "name": "PUBLIC-API-KEY",
        "x-default": "<Your PUBLIC-API-KEY>"
      },
      "sec1": {
        "type": "apiKey",
        "in": "header",
        "name": "PRIVATE-SECRET-KEY",
        "x-default": "<Your PRIVATE-SECRET-KEY>"
      }
    }
  },
  "security": [
    {
      "sec0": [],
      "sec1": []
    }
  ],
  "paths": {
    "/organizations/roles/{role_id}": {
      "delete": {
        "summary": "Eliminar un rol",
        "operationId": "delete-role",
        "description": "Elimina un rol personalizado. Los usuarios asignados a este rol se reasignarán a ReadOnly.",
        "parameters": [
          {
            "name": "role_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "El identificador único del rol que se eliminará."
          }
        ],
        "responses": {
          "204": {
            "description": "Sin contenido: eliminado correctamente"
          }
        }
      }
    }
  }
}
