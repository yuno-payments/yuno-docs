{
  "openapi": "3.1.0",
  "info": {
    "title": "Account Groups API - Create",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://api-sandbox.y.uno/v1",
      "description": "Sandbox"
    },
    {
      "url": "https://api.y.uno/v1",
      "description": "Production (US)"
    }
  ],
  "components": {
    "securitySchemes": {
      "sec0": {
        "type": "apiKey",
        "in": "header",
        "name": "PUBLIC-API-KEY",
        "x-default": "<Your PUBLIC-API-KEY>"
      },
      "sec1": {
        "type": "apiKey",
        "in": "header",
        "name": "PRIVATE-SECRET-KEY",
        "x-default": "<Your PRIVATE-SECRET-KEY>"
      }
    }
  },
  "security": [
    {
      "sec0": [],
      "sec1": []
    }
  ],
  "paths": {
    "/organizations/account-groups": {
      "post": {
        "summary": "Crear un grupo de cuentas",
        "operationId": "create-account-group",
        "description": "Crea un nuevo grupo (suborganización).",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "name",
                  "merchant_id"
                ],
                "properties": {
                  "name": {
                    "type": "string",
                    "description": "Nombre del grupo de cuentas (min=1, max=255)."
                  },
                  "merchant_id": {
                    "type": "string",
                    "description": "Identificador único que el comercio usa en sus sistemas (min=1, max=255)."
                  },
                  "account_codes": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "format": "uuid"
                    },
                    "description": "Opcional. Los `id` de las cuentas existentes que se asociarán al nuevo grupo en la misma transacción. Una cuenta pertenece a un solo grupo a la vez, por lo que una cuenta que ya está en otro grupo se mueve al nuevo. Si algún código no coincide con una cuenta activa de la organización, toda la solicitud falla y no se crea ningún grupo. El valor predeterminado es una lista vacía."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Creado",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "format": "uuid",
                      "description": "El identificador único del grupo de cuentas."
                    },
                    "name": {
                      "type": "string"
                    },
                    "merchant_id": {
                      "type": "string"
                    },
                    "parent_code": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "format": "uuid",
                      "description": "El `id` del grupo bajo el cual se anida este grupo. Siempre es `null` al crear: un grupo nuevo se crea como raíz y se anida después con Update Account Group."
                    },
                    "created_at": {
                      "type": "string",
                      "format": "date-time"
                    },
                    "updated_at": {
                      "type": "string",
                      "format": "date-time"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
