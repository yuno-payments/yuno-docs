{
  "openapi": "3.1.0",
  "info": {
    "title": "User Account Permissions API - Replace",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://api-sandbox.y.uno/v1",
      "description": "Sandbox"
    },
    {
      "url": "https://api.y.uno/v1",
      "description": "Production (US)"
    }
  ],
  "components": {
    "securitySchemes": {
      "sec0": {
        "type": "apiKey",
        "in": "header",
        "name": "PUBLIC-API-KEY",
        "x-default": "<Your PUBLIC-API-KEY>"
      },
      "sec1": {
        "type": "apiKey",
        "in": "header",
        "name": "PRIVATE-SECRET-KEY",
        "x-default": "<Your PRIVATE-SECRET-KEY>"
      }
    }
  },
  "security": [
    {
      "sec0": [],
      "sec1": []
    }
  ],
  "paths": {
    "/organizations/users/{user_id}/account-permissions": {
      "put": {
        "summary": "Reemplazar los permisos de cuentas de un usuario",
        "operationId": "replace-user-account-permissions",
        "description": "Reemplaza todas las asignaciones de permisos de cuentas de un usuario. Es un reemplazo completo.",
        "parameters": [
          {
            "name": "user_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "UUID del usuario."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "account_permissions"
                ],
                "properties": {
                  "account_permissions": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "required": [
                        "account_id",
                        "role_id"
                      ],
                      "properties": {
                        "account_id": {
                          "type": "string",
                          "format": "uuid"
                        },
                        "role_id": {
                          "type": "string"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "user_id": {
                      "type": "string",
                      "format": "uuid"
                    },
                    "account_permissions": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "account_id": {
                            "type": "string",
                            "format": "uuid"
                          },
                          "account_name": {
                            "type": "string"
                          },
                          "role_id": {
                            "type": "string"
                          },
                          "role_name": {
                            "type": "string"
                          },
                          "account_group_id": {
                            "type": [
                              "string",
                              "null"
                            ],
                            "format": "uuid",
                            "description": "Se establece cuando el acceso proviene de la concesión de un grupo de cuentas, `null` en caso contrario."
                          }
                        }
                      }
                    },
                    "updated_at": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "format": "date-time"
                    }
                  }
                },
                "example": {
                  "user_id": "bf3d9b16-1523-4a48-a425-95cb7dc426cc",
                  "account_permissions": [
                    {
                      "account_id": "a858ec8f-cb93-45c0-ad61-b9fa1f893b72",
                      "account_name": "Account 1",
                      "role_id": "rol_sAnEykYxo6e4x2wY",
                      "role_name": "Admin",
                      "account_group_id": null
                    }
                  ],
                  "updated_at": null
                }
              }
            }
          }
        }
      }
    }
  }
}
