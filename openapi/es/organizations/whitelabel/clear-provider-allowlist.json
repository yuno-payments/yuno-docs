{
  "openapi": "3.1.0",
  "info": {
    "title": "White-label Providers API - Clear Allowlist",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://api-sandbox.y.uno/v1",
      "description": "Sandbox"
    },
    {
      "url": "https://api.y.uno/v1",
      "description": "Production (US)"
    }
  ],
  "components": {
    "securitySchemes": {
      "sec0": {
        "type": "apiKey",
        "in": "header",
        "name": "PUBLIC-API-KEY",
        "x-default": "<Your PUBLIC-API-KEY>"
      },
      "sec1": {
        "type": "apiKey",
        "in": "header",
        "name": "PRIVATE-SECRET-KEY",
        "x-default": "<Your PRIVATE-SECRET-KEY>"
      }
    }
  },
  "security": [
    {
      "sec0": [],
      "sec1": []
    }
  ],
  "paths": {
    "/whitelabel/providers": {
      "delete": {
        "summary": "Borrar la lista de proveedores permitidos",
        "operationId": "clear-whitelabel-provider-allowlist",
        "description": "Elimina todas las entradas de la lista de permitidos y deja la organización en `filtered: false`. Es idempotente y conserva todas las personalizaciones de instrucciones, por lo que volver a habilitar un proveedor más adelante restaura tu redacción con él.",
        "responses": {
          "204": {
            "description": "Lista de permitidos borrada. Sin contenido."
          },
          "401": {
            "description": "No autorizado: las claves de API no son válidas o faltan.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "string",
                      "example": "NOT_AUTHENTICATED"
                    },
                    "messages": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      },
                      "example": [
                        "Not authenticated"
                      ]
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
