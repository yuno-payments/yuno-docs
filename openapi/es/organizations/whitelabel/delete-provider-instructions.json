{
  "openapi": "3.1.0",
  "info": {
    "title": "White-label Providers API - Delete Instructions",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://api-sandbox.y.uno/v1",
      "description": "Sandbox"
    },
    {
      "url": "https://api.y.uno/v1",
      "description": "Production (US)"
    }
  ],
  "components": {
    "securitySchemes": {
      "sec0": {
        "type": "apiKey",
        "in": "header",
        "name": "PUBLIC-API-KEY",
        "x-default": "<Your PUBLIC-API-KEY>"
      },
      "sec1": {
        "type": "apiKey",
        "in": "header",
        "name": "PRIVATE-SECRET-KEY",
        "x-default": "<Your PRIVATE-SECRET-KEY>"
      }
    }
  },
  "security": [
    {
      "sec0": [],
      "sec1": []
    }
  ],
  "paths": {
    "/whitelabel/providers/{provider_id}/instructions": {
      "delete": {
        "summary": "Eliminar la personalización de instrucciones de un proveedor",
        "operationId": "delete-whitelabel-provider-instructions",
        "description": "Elimina tu personalización de instrucciones para este proveedor, de modo que vuelve por completo a la redacción, el nombre y el enlace de documentación del catálogo de Yuno. Es idempotente y no cambia si ofreces o no el proveedor. El logotipo del proveedor se almacena por separado y no se modifica: restablécelo con `DELETE /v1/whitelabel/providers/{provider_id}/logo`.",
        "parameters": [
          {
            "name": "provider_id",
            "in": "path",
            "required": true,
            "description": "ID del proveedor del catálogo de Yuno en UPPER_SNAKE_CASE. No distingue mayúsculas de minúsculas; se normaliza a mayúsculas.",
            "schema": {
              "type": "string",
              "example": "STRIPE"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Personalización restablecida. Sin contenido."
          },
          "400": {
            "description": "provider_id no válido.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "string",
                      "example": "VALIDATION_ERROR"
                    },
                    "messages": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      },
                      "example": [
                        "provider_id is invalid"
                      ]
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "No autorizado: las claves de API no son válidas o faltan.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "string",
                      "example": "NOT_AUTHENTICATED"
                    },
                    "messages": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      },
                      "example": [
                        "Not authenticated"
                      ]
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
