{
  "openapi": "3.1.0",
  "info": {
    "title": "Users API - Create",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://api-sandbox.y.uno/v1",
      "description": "Sandbox"
    },
    {
      "url": "https://api.y.uno/v1",
      "description": "Production (US)"
    }
  ],
  "components": {
    "securitySchemes": {
      "sec0": {
        "type": "apiKey",
        "in": "header",
        "name": "PUBLIC-API-KEY",
        "x-default": "<Your PUBLIC-API-KEY>"
      },
      "sec1": {
        "type": "apiKey",
        "in": "header",
        "name": "PRIVATE-SECRET-KEY",
        "x-default": "<Your PRIVATE-SECRET-KEY>"
      }
    }
  },
  "security": [
    {
      "sec0": [],
      "sec1": []
    }
  ],
  "paths": {
    "/organizations/users": {
      "post": {
        "summary": "Crear un usuario",
        "operationId": "create-user",
        "description": "Crea un usuario nuevo. Los usuarios creados de esta forma no tienen acceso al Dashboard y solo pueden autenticarse con la API [Authenticate Whitelabel User](/reference/organizations/authenticate-whitelabel-user). El usuario debe crearse con al menos una asignación de permisos: account_permissions, account_group_permissions, o ambos.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "email",
                  "first_name",
                  "last_name"
                ],
                "properties": {
                  "email": {
                    "type": "string",
                    "format": "email",
                    "description": "Dirección de correo electrónico del usuario."
                  },
                  "first_name": {
                    "type": "string",
                    "description": "Nombre."
                  },
                  "last_name": {
                    "type": "string",
                    "description": "Apellido."
                  },
                  "account_permissions": {
                    "type": "array",
                    "description": "Asignaciones de permisos directos a cuentas.",
                    "items": {
                      "type": "object",
                      "required": [
                        "account_id",
                        "role_id"
                      ],
                      "properties": {
                        "account_id": {
                          "type": "string",
                          "format": "uuid",
                          "description": "UUID de la cuenta (debe pertenecer a la organización)."
                        },
                        "role_id": {
                          "type": "string",
                          "description": "ID del rol (no administrador, no staff, con alcance de organización)."
                        }
                      }
                    }
                  },
                  "account_group_permissions": {
                    "type": "array",
                    "description": "Asignaciones de permisos de grupos de cuentas.",
                    "items": {
                      "type": "object",
                      "required": [
                        "account_group_id",
                        "role_id"
                      ],
                      "properties": {
                        "account_group_id": {
                          "type": "string",
                          "format": "uuid",
                          "description": "UUID del grupo de cuentas (debe pertenecer a la organización)."
                        },
                        "role_id": {
                          "type": "string",
                          "description": "ID del rol (no administrador, no staff, con alcance de organización)."
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Creado",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "format": "uuid"
                    },
                    "email": {
                      "type": "string"
                    },
                    "first_name": {
                      "type": "string"
                    },
                    "last_name": {
                      "type": "string"
                    },
                    "account_permissions": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "account_id": {
                            "type": "string",
                            "format": "uuid"
                          },
                          "role_id": {
                            "type": "string"
                          }
                        }
                      }
                    },
                    "account_group_permissions": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "account_group_id": {
                            "type": "string",
                            "format": "uuid"
                          },
                          "role_id": {
                            "type": "string"
                          }
                        }
                      }
                    },
                    "created_at": {
                      "type": "string",
                      "format": "date-time"
                    },
                    "updated_at": {
                      "type": "string",
                      "format": "date-time"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
