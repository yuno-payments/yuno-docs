{
  "openapi": "3.1.0",
  "info": {
    "title": "Roles API - Update",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://api-sandbox.y.uno/v1",
      "description": "Sandbox"
    },
    {
      "url": "https://api.y.uno/v1",
      "description": "Production (US)"
    }
  ],
  "components": {
    "securitySchemes": {
      "sec0": {
        "type": "apiKey",
        "in": "header",
        "name": "PUBLIC-API-KEY",
        "x-default": "<Your PUBLIC-API-KEY>"
      },
      "sec1": {
        "type": "apiKey",
        "in": "header",
        "name": "PRIVATE-SECRET-KEY",
        "x-default": "<Your PRIVATE-SECRET-KEY>"
      }
    }
  },
  "security": [
    {
      "sec0": [],
      "sec1": []
    }
  ],
  "paths": {
    "/organizations/roles/{role_id}": {
      "patch": {
        "summary": "Actualizar un rol",
        "operationId": "update-role",
        "description": "Actualización parcial de un rol personalizado. Nota: role_type es inmutable.",
        "parameters": [
          {
            "name": "role_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "El identificador único del rol."
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "maxLength": 255
                  },
                  "description": {
                    "type": "string",
                    "maxLength": 1024
                  },
                  "permission_ids": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "testing_permission_ids": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "name": {
                      "type": "string"
                    },
                    "description": {
                      "type": "string",
                      "nullable": true
                    },
                    "admin": {
                      "type": "boolean"
                    },
                    "permission_ids": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "testing_permission_ids": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "role_type": {
                      "type": "string"
                    },
                    "created_at": {
                      "type": "string",
                      "format": "date-time"
                    },
                    "updated_at": {
                      "type": "string",
                      "format": "date-time"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Solicitud incorrecta: error de validación"
          },
          "404": {
            "description": "No encontrado: el rol no se encontró en la organización"
          }
        }
      }
    }
  }
}
