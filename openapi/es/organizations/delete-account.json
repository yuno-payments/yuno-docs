{
  "openapi": "3.1.0",
  "info": {
    "title": "Accounts API - Delete",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://api-sandbox.y.uno/v1",
      "description": "Sandbox"
    },
    {
      "url": "https://api.y.uno/v1",
      "description": "Production (US)"
    }
  ],
  "components": {
    "securitySchemes": {
      "sec0": {
        "type": "apiKey",
        "in": "header",
        "name": "PUBLIC-API-KEY",
        "x-default": "<Your PUBLIC-API-KEY>"
      },
      "sec1": {
        "type": "apiKey",
        "in": "header",
        "name": "PRIVATE-SECRET-KEY",
        "x-default": "<Your PRIVATE-SECRET-KEY>"
      }
    }
  },
  "security": [
    {
      "sec0": [],
      "sec1": []
    }
  ],
  "paths": {
    "/organizations/accounts/{account_id}": {
      "delete": {
        "summary": "Eliminar una cuenta",
        "operationId": "delete-account",
        "description": "Elimina una cuenta. La eliminación es permanente: la cuenta deja de aparecer en los listados y no se puede recuperar por id, y la API no puede restaurarla.",
        "parameters": [
          {
            "name": "account_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "UUID de la cuenta."
          }
        ],
        "responses": {
          "204": {
            "description": "Sin contenido: la cuenta se eliminó."
          }
        }
      }
    }
  }
}
