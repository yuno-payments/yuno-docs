{
  "openapi": "3.1.0",
  "info": {
    "title": "Users API - Find by Email",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://api-sandbox.y.uno/v1",
      "description": "Sandbox"
    },
    {
      "url": "https://api.y.uno/v1",
      "description": "Production (US)"
    }
  ],
  "components": {
    "securitySchemes": {
      "sec0": {
        "type": "apiKey",
        "in": "header",
        "name": "PUBLIC-API-KEY",
        "x-default": "<Your PUBLIC-API-KEY>"
      },
      "sec1": {
        "type": "apiKey",
        "in": "header",
        "name": "PRIVATE-SECRET-KEY",
        "x-default": "<Your PRIVATE-SECRET-KEY>"
      }
    }
  },
  "security": [
    {
      "sec0": [],
      "sec1": []
    }
  ],
  "paths": {
    "/organizations/users": {
      "get": {
        "summary": "Buscar usuarios por correo electrónico",
        "operationId": "find-user-by-email",
        "description": "Devuelve los usuarios cuyo correo electrónico coincide con la dirección indicada, dentro del alcance de la organización autenticada. Una dirección de correo electrónico puede pertenecer a usuarios de varias organizaciones; solo se devuelven las coincidencias dentro de la organización que realiza la llamada. Cuando ningún usuario tiene ese correo electrónico, la respuesta contiene un arreglo `data` vacío: no es un error.",
        "parameters": [
          {
            "name": "email",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "email"
            },
            "description": "Dirección de correo electrónico que se desea buscar. Debe ser una coincidencia exacta, sin distinguir mayúsculas de minúsculas."
          }
        ],
        "responses": {
          "200": {
            "description": "OK: cero o más usuarios que coinciden con la dirección de correo electrónico.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "description": "Lista de usuarios cuyo correo electrónico coincide con la dirección solicitada dentro de la organización que realiza la llamada. Está vacía cuando no hay coincidencias.",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "string",
                            "format": "uuid",
                            "description": "Identificador único del usuario generado por Yuno."
                          },
                          "email": {
                            "type": "string",
                            "description": "Dirección de correo electrónico del usuario."
                          },
                          "first_name": {
                            "type": "string",
                            "description": "Nombre del usuario."
                          },
                          "last_name": {
                            "type": "string",
                            "description": "Apellido del usuario."
                          },
                          "account_permissions": {
                            "type": "array",
                            "description": "Lista de permisos a nivel de cuenta asignados a este usuario.",
                            "items": {
                              "type": "object",
                              "properties": {
                                "account_id": {
                                  "type": "string",
                                  "format": "uuid",
                                  "description": "Cuenta a la que se aplica el permiso."
                                },
                                "role_id": {
                                  "type": "string",
                                  "description": "Rol asignado al usuario en esta cuenta."
                                }
                              }
                            }
                          },
                          "account_group_permissions": {
                            "type": "array",
                            "description": "Lista de permisos a nivel de grupo de cuentas asignados a este usuario.",
                            "items": {
                              "type": "object",
                              "properties": {
                                "account_group_id": {
                                  "type": "string",
                                  "format": "uuid",
                                  "description": "Grupo de cuentas al que se aplica el permiso."
                                },
                                "role_id": {
                                  "type": "string",
                                  "description": "Rol asignado al usuario en este grupo de cuentas."
                                }
                              }
                            }
                          },
                          "created_at": {
                            "type": "string",
                            "format": "date-time",
                            "description": "Marca de tiempo ISO 8601 de la creación del usuario."
                          },
                          "updated_at": {
                            "type": "string",
                            "format": "date-time",
                            "description": "Marca de tiempo ISO 8601 de la última actualización."
                          }
                        }
                      }
                    },
                    "pagination": {
                      "type": "object",
                      "properties": {
                        "page": {
                          "type": "integer"
                        },
                        "page_size": {
                          "type": "integer"
                        },
                        "total_items": {
                          "type": "integer"
                        },
                        "total_pages": {
                          "type": "integer"
                        },
                        "has_next": {
                          "type": "boolean"
                        },
                        "has_previous": {
                          "type": "boolean"
                        }
                      }
                    }
                  }
                },
                "examples": {
                  "match_found": {
                    "summary": "User found",
                    "value": {
                      "data": [
                        {
                          "id": "f1e2d3c4-b5a6-7890-fedc-ba0987654321",
                          "email": "jane.doe@acme.com",
                          "first_name": "Jane",
                          "last_name": "Doe",
                          "account_permissions": [
                            {
                              "account_id": "a1b2c3d4-e5f6-7890-abcd-ef1234567890",
                              "role_id": "ADMIN"
                            }
                          ],
                          "account_group_permissions": [],
                          "created_at": "2024-01-10T09:00:00Z",
                          "updated_at": "2024-05-20T14:15:00Z"
                        }
                      ],
                      "pagination": {
                        "page": 1,
                        "page_size": 20,
                        "total_items": 1,
                        "total_pages": 1,
                        "has_next": false,
                        "has_previous": false
                      }
                    }
                  },
                  "no_match": {
                    "summary": "No user matched — empty result",
                    "value": {
                      "data": [],
                      "pagination": {
                        "page": 1,
                        "page_size": 20,
                        "total_items": 0,
                        "total_pages": 0,
                        "has_next": false,
                        "has_previous": false
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Solicitud incorrecta: el parámetro de consulta `email` falta o no es una dirección de correo electrónico válida."
          },
          "401": {
            "description": "No autorizado: las credenciales de la API no son válidas o faltan."
          }
        }
      }
    }
  }
}
