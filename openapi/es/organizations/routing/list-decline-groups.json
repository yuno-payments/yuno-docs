{
  "openapi": "3.1.0",
  "info": {
    "title": "Routing API - List Decline Groups",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://api-sandbox.y.uno/v1",
      "description": "Sandbox"
    },
    {
      "url": "https://api.y.uno/v1",
      "description": "Production (US)"
    }
  ],
  "components": {
    "securitySchemes": {
      "sec0": {
        "type": "apiKey",
        "in": "header",
        "name": "PUBLIC-API-KEY",
        "x-default": "<Your PUBLIC-API-KEY>"
      },
      "sec1": {
        "type": "apiKey",
        "in": "header",
        "name": "PRIVATE-SECRET-KEY",
        "x-default": "<Your PRIVATE-SECRET-KEY>"
      }
    }
  },
  "security": [
    {
      "sec0": [],
      "sec1": []
    }
  ],
  "paths": {
    "/routing/decline-groups": {
      "get": {
        "summary": "Listar grupos de rechazos",
        "operationId": "list-decline-groups",
        "description": "Lista los grupos de rechazos (DECLINE_GROUP), los grupos de Merchant Advice Code (MAC_CODE_GROUP) y los grupos de códigos ISO 8583 (ISO_CODE_GROUP, solo pagos con tarjeta) de una cuenta, para referenciarlos por group_id desde las salidas del enrutamiento. Solo lectura. Los grupos de códigos ISO guardados se crean en el dashboard, no a través de la API pública; una salida de enrutamiento ISO_CODE_GROUP enviada con decline_types y sin group_id recibe un grupo auto_, igual que en DECLINE_GROUP.",
        "parameters": [
          {
            "name": "account_id",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "Cuenta de la que se listarán los grupos. Debe pertenecer a la organización de tus credenciales de API."
          }
        ],
        "responses": {
          "200": {
            "description": "Los grupos de la cuenta, o un arreglo vacío si no tiene ninguno.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "integer",
                        "example": 1044,
                        "description": "El valor que se debe enviar como group_id en una salida de enrutamiento."
                      },
                      "name": {
                        "type": "string",
                        "example": "Soft declines"
                      },
                      "type": {
                        "type": "string",
                        "enum": [
                          "DECLINE_GROUP",
                          "MAC_CODE_GROUP",
                          "ISO_CODE_GROUP"
                        ],
                        "description": "El estado de salida con el que se usa el grupo."
                      },
                      "decline_types": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        },
                        "example": [
                          "DECLINED_BY_BANK",
                          "RESTRICTED_BY_BANK"
                        ],
                        "description": "Miembros del grupo: subestados de rechazo para DECLINE_GROUP, Merchant Advice Codes normalizados para MAC_CODE_GROUP, códigos de respuesta ISO 8583 (de 1 a 30 caracteres después de quitar los espacios, comparados sin distinguir mayúsculas de minúsculas) para ISO_CODE_GROUP."
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Solicitud incorrecta. `ROUTING_VALIDATION_FAILED` cuando falta `account_id`, `INVALID_ACCOUNT_ID` cuando pertenece a otra organización.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "string",
                      "example": "ROUTING_VALIDATION_FAILED"
                    },
                    "messages": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      },
                      "example": [
                        "account_id is required."
                      ]
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "No autorizado",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "string",
                      "example": "NOT_AUTHENTICATED"
                    },
                    "messages": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      },
                      "example": [
                        "Not authenticated"
                      ]
                    }
                  }
                }
              }
            }
          },
          "502": {
            "description": "Bad Gateway",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "string",
                      "example": "ROUTING_UPSTREAM_ERROR"
                    },
                    "messages": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      },
                      "example": [
                        "routing service unavailable."
                      ]
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
