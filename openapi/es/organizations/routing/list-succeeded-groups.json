{
  "openapi": "3.1.0",
  "info": {
    "title": "Routing API - List Succeeded Groups",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://api-sandbox.y.uno/v1",
      "description": "Sandbox"
    },
    {
      "url": "https://api.y.uno/v1",
      "description": "Production (US)"
    }
  ],
  "components": {
    "securitySchemes": {
      "sec0": {
        "type": "apiKey",
        "in": "header",
        "name": "PUBLIC-API-KEY",
        "x-default": "<Your PUBLIC-API-KEY>"
      },
      "sec1": {
        "type": "apiKey",
        "in": "header",
        "name": "PRIVATE-SECRET-KEY",
        "x-default": "<Your PRIVATE-SECRET-KEY>"
      }
    }
  },
  "security": [
    {
      "sec0": [],
      "sec1": []
    }
  ],
  "paths": {
    "/routing/succeeded-groups": {
      "get": {
        "summary": "Listar grupos de éxitos",
        "operationId": "list-succeeded-groups",
        "description": "Lista los grupos de éxitos de una cuenta, para referenciarlos por group_id desde las salidas de enrutamiento SUCCEEDED_GROUP. Solo lectura.",
        "parameters": [
          {
            "name": "account_id",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "Cuenta de la que se listarán los grupos. Debe pertenecer a la organización de tus credenciales de API."
          }
        ],
        "responses": {
          "200": {
            "description": "Los grupos de la cuenta, o un arreglo vacío si no tiene ninguno.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "integer",
                        "example": 430,
                        "description": "El valor que se debe enviar como group_id en una salida de enrutamiento."
                      },
                      "name": {
                        "type": "string",
                        "example": "Pending review"
                      },
                      "type": {
                        "type": "string",
                        "enum": [
                          "SUCCEEDED_GROUP"
                        ],
                        "description": "Siempre SUCCEEDED_GROUP, el estado de salida con el que se usa el grupo."
                      },
                      "succeeded_types": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        },
                        "example": [
                          "PENDING_IN_REVIEW"
                        ],
                        "description": "Miembros del grupo. Hoy el único subestado de éxito que se puede agrupar es PENDING_IN_REVIEW."
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Solicitud incorrecta. `ROUTING_VALIDATION_FAILED` cuando falta `account_id`, `INVALID_ACCOUNT_ID` cuando pertenece a otra organización.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "string",
                      "example": "ROUTING_VALIDATION_FAILED"
                    },
                    "messages": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      },
                      "example": [
                        "account_id is required."
                      ]
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "No autorizado",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "string",
                      "example": "NOT_AUTHENTICATED"
                    },
                    "messages": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      },
                      "example": [
                        "Not authenticated"
                      ]
                    }
                  }
                }
              }
            }
          },
          "502": {
            "description": "Bad Gateway",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "string",
                      "example": "ROUTING_UPSTREAM_ERROR"
                    },
                    "messages": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      },
                      "example": [
                        "routing service unavailable."
                      ]
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
