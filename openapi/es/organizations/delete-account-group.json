{
  "openapi": "3.1.0",
  "info": {
    "title": "Account Groups API - Delete",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://api-sandbox.y.uno/v1",
      "description": "Sandbox"
    },
    {
      "url": "https://api.y.uno/v1",
      "description": "Production (US)"
    }
  ],
  "components": {
    "securitySchemes": {
      "sec0": {
        "type": "apiKey",
        "in": "header",
        "name": "PUBLIC-API-KEY",
        "x-default": "<Your PUBLIC-API-KEY>"
      },
      "sec1": {
        "type": "apiKey",
        "in": "header",
        "name": "PRIVATE-SECRET-KEY",
        "x-default": "<Your PRIVATE-SECRET-KEY>"
      }
    }
  },
  "security": [
    {
      "sec0": [],
      "sec1": []
    }
  ],
  "paths": {
    "/organizations/account-groups/{account_group_id}": {
      "delete": {
        "summary": "Eliminar un grupo de cuentas",
        "operationId": "delete-account-group",
        "description": "Elimina un grupo de cuentas. Un grupo solo puede eliminarse cuando está vacío: primero quita, mueve o elimina sus cuentas (consulta Remove Account from Group) y mueve o elimina sus subgrupos. Las cuentas nunca se reasignan automáticamente.",
        "parameters": [
          {
            "name": "account_group_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "UUID del grupo de cuentas."
          }
        ],
        "responses": {
          "204": {
            "description": "Sin contenido: el grupo se eliminó."
          },
          "400": {
            "description": "Solicitud incorrecta. El campo `code` indica el motivo:\n\n- `GROUP_HAS_ACCOUNTS`: el grupo todavía tiene cuentas. Quítalas primero del grupo.\n- `GROUP_HAS_SUBGROUPS`: el grupo todavía tiene subgrupos. Muévelos a otro padre (o desvincúlalos con Update Account Group) o elimínalos primero.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "string",
                      "description": "Código de error legible por máquina."
                    },
                    "messages": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      },
                      "description": "Detalles legibles por personas."
                    }
                  }
                },
                "example": {
                  "code": "GROUP_HAS_SUBGROUPS",
                  "messages": [
                    "Cannot delete account group that still has sub-groups"
                  ]
                }
              }
            }
          },
          "404": {
            "description": "No encontrado: no hay ningún grupo de cuentas con ese `account_group_id` en esta organización."
          }
        }
      }
    }
  }
}
