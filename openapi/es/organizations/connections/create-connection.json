{
  "openapi": "3.1.0",
  "info": {
    "title": "Connections API - Create",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://api-sandbox.y.uno/v1",
      "description": "Sandbox"
    },
    {
      "url": "https://api.y.uno/v1",
      "description": "Production (US)"
    }
  ],
  "components": {
    "securitySchemes": {
      "sec0": {
        "type": "apiKey",
        "in": "header",
        "name": "PUBLIC-API-KEY",
        "x-default": "<Your PUBLIC-API-KEY>"
      },
      "sec1": {
        "type": "apiKey",
        "in": "header",
        "name": "PRIVATE-SECRET-KEY",
        "x-default": "<Your PRIVATE-SECRET-KEY>"
      }
    }
  },
  "security": [
    {
      "sec0": [],
      "sec1": []
    }
  ],
  "paths": {
    "/connections": {
      "post": {
        "summary": "Crear una conexión",
        "operationId": "create-connection",
        "description": "Crea una conexión con estado ACTIVE.",
        "parameters": [
          {
            "name": "X-account-code",
            "in": "header",
            "required": true,
            "description": "La cuenta propietaria de la conexión.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "X-Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "merchant_connection_id",
                  "provider_id",
                  "params"
                ],
                "properties": {
                  "merchant_connection_id": {
                    "type": "string",
                    "example": "stripe-us-prod-001"
                  },
                  "provider_id": {
                    "type": "string",
                    "example": "STRIPE"
                  },
                  "flow_type": {
                    "type": "string",
                    "description": "Opcional. El valor predeterminado es PAYIN.",
                    "example": "PAYIN"
                  },
                  "payment_methods": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "minItems": 1,
                    "description": "Opcional. Subconjunto de payment_method_type[] del proveedor. Omítelo para habilitar todos los métodos de pago que admite el proveedor, incluidos los que se agreguen más adelante. Si lo envías, debe contener al menos un valor: un arreglo vacío se rechaza con 400 VALIDATION_ERROR.",
                    "example": [
                      "CARD"
                    ]
                  },
                  "params": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "param_id": {
                          "type": "string"
                        },
                        "value": {
                          "type": [
                            "string",
                            "boolean",
                            "number",
                            "array"
                          ]
                        }
                      }
                    }
                  },
                  "costs": {
                    "type": "array",
                    "description": "Opcional. Configuración de costos por conexión.",
                    "items": {
                      "type": "object",
                      "properties": {
                        "sort_number": {
                          "type": "integer"
                        },
                        "cost_name": {
                          "type": "string"
                        },
                        "currency": {
                          "type": "string"
                        },
                        "cost_values": {
                          "type": "object"
                        }
                      }
                    }
                  }
                }
              },
              "example": {
                "merchant_connection_id": "stripe-us-prod-001",
                "provider_id": "STRIPE",
                "flow_type": "PAYIN",
                "payment_methods": [
                  "CARD"
                ],
                "params": [
                  {
                    "param_id": "INTEGRATION_TYPE",
                    "value": "STRIPE_CHARGES"
                  },
                  {
                    "param_id": "SECRET_KEY",
                    "value": "sk_live_..."
                  },
                  {
                    "param_id": "RADAR_FRAUD_ANALYSIS",
                    "value": false
                  },
                  {
                    "param_id": "SEND_RECEIPT_EMAIL_PARAMETER",
                    "value": false
                  },
                  {
                    "param_id": "SETUP_FUTURE_USAGE",
                    "value": false
                  },
                  {
                    "param_id": "ORDER_ID",
                    "value": "DEFAULT"
                  }
                ],
                "costs": [
                  {
                    "sort_number": 1,
                    "cost_name": "Transaction Fee",
                    "currency": "USD",
                    "cost_values": {
                      "successful": {
                        "fixed_fee": 0.3,
                        "percentage": 2.9
                      },
                      "unsuccessful": {
                        "fixed_fee": 0.0,
                        "percentage": 0.0
                      }
                    }
                  }
                ]
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Creado",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "connection_id": {
                      "type": "string",
                      "example": "f1a3c4d5-7b8e-4a2c-9d1e-3f4a5b6c7d8e"
                    },
                    "merchant_connection_id": {
                      "type": "string",
                      "example": "stripe-us-prod-001"
                    },
                    "provider_id": {
                      "type": "string",
                      "example": "STRIPE"
                    },
                    "status": {
                      "type": "string",
                      "example": "ACTIVE"
                    },
                    "flow_type": {
                      "type": "string",
                      "example": "PAYIN"
                    },
                    "payment_methods": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      },
                      "example": [
                        "CARD"
                      ]
                    },
                    "params": {
                      "type": "array",
                      "items": {
                        "type": "object"
                      }
                    },
                    "costs": {
                      "type": "array",
                      "items": {
                        "type": "object"
                      }
                    },
                    "created_at": {
                      "type": "string",
                      "format": "date-time",
                      "example": "2026-05-12T10:24:00Z"
                    },
                    "updated_at": {
                      "type": "string",
                      "format": "date-time",
                      "example": "2026-05-12T10:24:00Z"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Solicitud incorrecta",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string",
                      "example": "validation_error"
                    },
                    "code": {
                      "type": "string",
                      "example": "MISSING_REQUIRED_PARAM"
                    },
                    "message": {
                      "type": "string",
                      "example": "Required param 'SECRET_KEY' is missing"
                    },
                    "details": {
                      "type": "object"
                    }
                  }
                }
              }
            }
          },
          "409": {
            "description": "Conflicto",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string",
                      "example": "conflict"
                    },
                    "code": {
                      "type": "string",
                      "example": "CONNECTION_MERCHANT_ID_CONFLICT"
                    },
                    "message": {
                      "type": "string",
                      "example": "A connection with this merchant_connection_id already exists"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "No autorizado",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string",
                      "example": "auth_error"
                    },
                    "code": {
                      "type": "string",
                      "example": "NOT_AUTHENTICATED"
                    },
                    "message": {
                      "type": "string",
                      "example": "Not authenticated"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
