            "example": "fe14c7c6-c75e-43b7-bdbe-4c87ad52c482"
          },
          "merchant_recipient_id": {
            "type": "string",
            "description": "Identificador único del destinatario definido por el comercio.",
            "example": "MERCHANT_182acf1d-faeb-4ff0-94cd-7fab11b282f6"
          },
          "national_entity": {
            "type": "string",
            "description": "Tipo de entidad nacional del beneficiario.",
            "example": "INDIVIDUAL"
          },
          "entity_type": {
            "type": "string",
            "description": "Tipo de organización del beneficiario.",
            "example": "PRIVATE"
          },
          "first_name": {
            "type": "string",
            "description": "Nombre del beneficiario.",
            "example": "Juan"
          },
          "last_name": {
            "type": "string",
            "description": "Apellido del beneficiario.",
            "example": "Perez"
          },
          "legal_name": {
            "type": [
              "string",
              "null"
