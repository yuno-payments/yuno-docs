                "provider": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "example": "ALELO"
                    },
                    "connection_id": {
                      "type": "string",
                      "example": "cc389b51-53a1-4a29-af40-c8cee26c3399"
                    },
                    "recipient_id": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "example": null
                    },
                    "redirect_url": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "example": null
                    },
                    "onboarding_url": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "example": null
                    },
                    "legal_entity": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "example": null
                    },
                    "balance_account_id": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "example": null
