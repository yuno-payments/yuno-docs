  "paths": {
    "/recipients/{recipient_id}": {
      "parameters": [
        {
          "name": "recipient_id",
          "in": "path",
          "required": true,
          "description": "El identificador único del destinatario",
          "schema": {
            "type": "string"
          }
        }
      ],
      "patch": {
        "summary": "Actualizar destinatario",
        "operationId": "update-recipient",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "onboarding_id": {
                    "type": "string",
                    "format": "uuid",
                    "description": "ID de un onboarding existente que pertenece al destinatario. Cuando se establece, los campos de identidad enviados en esta solicitud (por ejemplo, first_name, email, phone, address) se almacenan como una sobrescritura por onboarding solo para ese onboarding, sin modificar el destinatario compartido; cuando se omite, la actualización se aplica al destinatario compartido y se propaga a todos los onboardings no terminales. Solo de solicitud, no se devuelve en las respuestas ni en los webhooks.",
                    "example": "1b9d6bcd-bbfd-4b2d-9b5d-ab8dfbbd4bed"
                  },
                  "merchant_recipient_id": {
                    "type": "string",
                    "description": "Identificador único del destinatario definido por el comercio (MAX 255; MIN 1)."
                  },
                  "first_name": {
                    "type": "string",
                    "description": "Nombre del beneficiario. (MAX 80; MIN 1)."
                  },
                  "last_name": {
                    "type": "string",
                    "description": "Apellido del beneficiario. (MAX 80; MIN 1)."
                  },
                  "date_of_birth": {
                    "type": "string",
                    "description": "Fecha de nacimiento del beneficiario en formato YYYY-MM-DD (MAX 10; MIN 10)."
                  },
                  "entity_type": {
                    "type": "string",
                    "enum": [
                      "GOVERNMENTAL",
                      "PUBLIC",
                      "NON_PROFIT",
                      "PRIVATE"
                    ],
                    "description": "Tipo de organización del beneficiario. GOVERNMENTAL, PUBLIC, NON_PROFIT, PRIVATE"
                  },
                  "website": {
                    "type": "string",
                    "description": "La URL del sitio web del vendedor (MAX 255; MIN 3)."
                  },
                  "industry": {
                    "type": "string",
                    "description": "Industria del vendedor (MAX 235; MIN 1). Para más información, accede a la página de referencia de categorías de industria."
                  },
                  "merchant_category_code": {
                    "type": "string",
                    "description": "MCC: el código de categoría del comercio (MAX 235; MIN 1)."
                  },
                  "email": {
                    "type": "string",
                    "description": "Email del beneficiario (MAX 255; MIN 3)."
                  },
                  "phone": {
                    "type": "object",
                    "properties": {
                      "country_code": {
                        "type": "string",
                        "description": "Código de área del teléfono celular del beneficiario. (MAX 3; MIN 2)."
                      },
                      "number": {
                        "type": "string",
                        "description": "Número de teléfono celular del beneficiario. (MAX 32; MIN 1)."
                      }
                    }
                  },
                  "address": {
                    "type": "object",
                    "properties": {
                      "address_line_1": {
                        "type": "string",
                        "description": "La línea principal de la dirección de facturación del cliente (MAX 255; MIN 3)."
                      },
                      "address_line_2": {
                        "type": "string",
                        "description": "La línea secundaria de la dirección de facturación del cliente (MAX 255; MIN 3)."
                      },
                      "city": {
                        "type": "string",
                        "description": "La ciudad considerada para la dirección de facturación (MAX 255; MIN 3)."
                      },
                      "state": {
                        "type": "string",
                        "description": "Estado / provincia considerado para la dirección de facturación (MAX 255; MIN 3)."
                      },
                      "zip_code": {
                        "type": "string",
                        "description": "Código postal considerado para la dirección de facturación (MAX 11; MIN 4)."
                      }
                    }
                  },
                  "withdrawal_methods": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "bank": {
                          "type": "object",
                          "properties": {
                            "code": {
                              "type": "string",
                              "description": "Código del banco (MAX 3; MIN 3)."
                            },
                            "branch": {
                              "type": "string",
                              "description": "Sucursal del banco (MAX 3; MIN 3)."
                            },
                            "branch_digit": {
                              "type": "string",
                              "description": "Dígito de la sucursal del banco (MAX 3; MIN 3)."
                            },
                            "account": {
                              "type": "string",
                              "description": "Número de cuenta bancaria del beneficiario (MAX 250; MIN 3)."
                            },
                            "account_digit": {
                              "type": "string",
                              "description": "Dígito de la cuenta bancaria del beneficiario (MAX 250; MIN 3)."
                            },
                            "account_type": {
                              "type": "string",
                              "enum": [
                                "CHECKINGS",
                                "SAVINGS"
                              ],
                              "description": "Tipo de cuenta bancaria del beneficiario (MAX 3; MIN 1)."
                            },
                            "routing": {
                              "type": "string",
                              "description": "Número de ruta de la cuenta bancaria del beneficiario."
                            },
                            "country": {
                              "type": "string",
                              "description": "País de la cuenta bancaria (ISO 3166-1 MAX 2; MIN 2)."
                            },
                            "currency": {
                              "type": "string",
                              "description": "Moneda de la cuenta bancaria (ISO 4217 MAX 3; MIN 3)."
                            }
                          }
                        }
                      }
                    }
                  },
                  "documentation": {
                    "type": "array",
                    "description": "Arreglo de objetos de documentación",
                    "items": {
                      "type": "object",
                      "properties": {
                        "file_name": {
                          "type": "string",
                          "description": "El nombre de la documentación enviada (MAX 255; MIN 3)."
                        },
                        "content_type": {
                          "type": "string",
                          "description": "Tipo de documentación enviada por el comercio."
                        },
                        "content_category": {
                          "type": "string",
                          "description": "Categoría de la documentación enviada por el comercio."
                        },
                        "content": {
                          "type": "string",
                          "description": "Contenido de la documentación enviada por el comercio, codificado en base64. Tamaño máximo: 1MB."
                        }
                      }
                    }
                  },
                  "onboardings": {
                    "type": "array",
                    "description": "Arreglo de objetos de onboarding para distintos proveedores de pago",
                    "items": {
                      "type": "object",
                      "properties": {
                        "type": {
                          "type": "string",
                          "enum": [
                            "PREVIOUSLY_ONBOARDED",
                            "ONBOARD_ONTO_THE_PROVIDER"
                          ],
                          "description": "Tipo de onboarding. Si lo realiza Yuno."
                        },
                        "workflow": {
                          "type": "string",
                          "enum": [
                            "HOSTED_BY_PROVIDER",
                            "DIRECT"
                          ],
                          "description": "Flujo de trabajo del onboarding."
                        },
                        "callback_url": {
                          "type": "string",
                          "description": "URL a la que redirigir a tu cliente después del proceso de onboarding con el proveedor, si es necesario."
                        },
                        "provider": {
                          "type": "object",
                          "properties": {
                            "id": {
                              "type": "string",
                              "enum": [
