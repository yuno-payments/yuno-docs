{
  "openapi": "3.1.0",
  "info": {
    "title": "Recipients API",
    "version": "1.0.0",
    "description": "Replace the split_marketplace of a transaction that is already paid, before the provider settles it."
  },
  "servers": [
    {
      "url": "https://api-sandbox.y.uno/v1",
      "description": "Sandbox"
    },
    {
      "url": "https://api.y.uno/v1",
      "description": "Production (US)"
    }
  ],
  "components": {
    "securitySchemes": {
      "sec0": {
        "type": "apiKey",
        "in": "header",
        "name": "public-api-key",
        "x-default": "<Your public-api-key>"
      },
      "sec1": {
        "type": "apiKey",
        "in": "header",
        "name": "private-secret-key",
        "x-default": "<Your private-secret-key>"
      }
    },
    "schemas": {
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "example": "INVALID_REQUEST"
          },
          "messages": {
            "type": "array",
            "items": {
              "type": "string",
              "example": "Invalid request"
            }
          }
        }
      }
    }
  },
  "security": [
    {
      "sec0": [],
      "sec1": []
    }
  ],
  "paths": {
    "/payments/{payment_id}/transactions/{transaction_id}/split-marketplace": {
      "put": {
        "summary": "Actualizar el split de una transacción pagada",
        "description": "Reemplaza todo el `split_marketplace` de una transacción de compra exitosa en el proveedor y en Yuno. Los tramos enviados pasan a ser el split; los tramos que no se envían se eliminan. El pago y la transacción conservan su estado; no se crea ninguna transacción nueva.\n\nLa actualización solo se acepta mientras el proveedor todavía la permita: antes de la liquidación, y mientras el pago no tenga un reembolso (incluido uno en espera de reintento), contracargo ni reversión de transferencia. Mientras una actualización está en curso o en revisión, los reembolsos del pago se rechazan con `400` `OPERATION_IN_PROCESS`. La disponibilidad depende del proveedor; contacta a Yuno para habilitarla en tu conexión.",
        "operationId": "update-split-marketplace",
        "parameters": [
          {
            "in": "path",
            "name": "payment_id",
            "schema": {
              "type": "string"
            },
            "required": true,
            "description": "El identificador único del pago (MAX 64; MIN 36)."
          },
          {
            "in": "path",
            "name": "transaction_id",
            "schema": {
              "type": "string"
            },
            "required": true,
            "description": "Identificador único de la transacción de compra cuyo split se reemplaza (MAX 64; MIN 36)."
          },
          {
            "in": "header",
            "name": "X-Idempotency-Key",
            "schema": {
              "type": "string"
            },
            "required": true,
            "description": "Obligatorio. Identificador único de esta actualización (MAX 64). Una solicitud que agota el tiempo de espera no es un fallo: repítela con la misma clave y obtendrás el resultado del primer intento. La misma clave con un cuerpo distinto se rechaza con `SPLIT_UPDATE_IDEMPOTENCY_CONFLICT`. Una repetición enviada mientras el primer intento sigue en ejecución recibe `400` `OPERATION_IN_PROCESS` y no cambia nada: espera unos segundos y vuelve a repetirla con la misma clave."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "split_marketplace"
                ],
                "properties": {
                  "split_marketplace": {
                    "type": "array",
                    "minItems": 1,
                    "description": "El nuevo split: todos los tramos que debe tener la transacción después de la actualización.",
                    "items": {
                      "properties": {
                        "recipient_id": {
                          "type": "string",
                          "description": "Identificador único del destinatario en el sistema de Yuno. Cada tramo debe indicar su destinatario con el [`recipient_id`](/es/reference/recipients-for-marketplace/create-recipient-1) (generado por Yuno) o con el `provider_recipient_id` (ID del proveedor externo), nunca con ambos."
                        },
                        "provider_recipient_id": {
                          "type": "string",
                          "description": "ID del destinatario proporcionado por el proveedor de pago externo. Cada tramo debe indicar su destinatario con el `provider_recipient_id` o con el [`recipient_id`](/es/reference/recipients-for-marketplace/create-recipient-1) (generado por Yuno), nunca con ambos."
                        },
                        "description": {
                          "type": "string",
                          "description": "Descripción del split. (MAX 255; MIN 3)."
                        },
                        "type": {
                          "type": "string",
                          "description": "El tipo de split. `recipient_id` es obligatorio para `PURCHASE` y `MARKETPLACE`.",
                          "enum": [
                            "PURCHASE",
                            "PAYMENTFEE",
                            "VAT",
                            "COMMISSION",
                            "MARKETPLACE",
                            "SHIPPING"
                          ]
                        },
                        "merchant_reference": {
                          "type": "string",
                          "description": "Identificador único opcional de la transacción de split (MAX 255; MIN 3)."
                        },
                        "recipient_type": {
                          "type": "string",
                          "description": "El tipo de destinatario para el proveedor.",
                          "enum": [
                            "MEAL",
                            "FOOD",
                            "MULTI_BENEFITS",
                            "FLEET"
                          ],
                          "example": "MEAL"
                        },
                        "amount": {
                          "type": "object",
                          "description": "Monto del tramo. Obligatorio en una actualización: el monto de la transacción original no forma parte de esta solicitud, por lo que no se calcula nada a partir de una `split_configuration`.",
                          "required": [
                            "value",
                            "currency"
                          ],
                          "properties": {
                            "value": {
                              "type": "number",
                              "description": "El monto del split (múltiplo de 0.0001).",
                              "format": "float"
                            },
                            "currency": {
                              "type": "string",
                              "description": "Moneda del pago (MAX 3; MIN 3; ISO 4217). Opcional; cuando se omite, se usa la moneda del pago. Cualquier otra moneda se rechaza."
                            }
                          }
                        },
                        "liability": {
                          "type": "object",
                          "description": "Información opcional sobre la responsabilidad del destinatario por cargos y contracargos.",
                          "properties": {
                            "processing_fee": {
                              "type": "string",
                              "description": "Indica a quién se le cobra el cargo de la transacción.",
                              "enum": [
                                "MERCHANT",
                                "RECIPIENT",
                                "SHARED"
                              ]
                            },
                            "chargebacks": {
                              "type": "boolean",
                              "description": "El destinatario es responsable en caso de un contracargo."
                            }
                          }
                        }
                      },
                      "required": [
                        "type",
                        "amount"
                      ],
                      "type": "object"
                    }
                  },
                  "description": {
                    "type": "string",
                    "description": "Descripción de la actualización (MAX 255; MIN 3)."
                  },
                  "metadata": {
                    "type": "array",
                    "description": "Pares clave-valor personalizados almacenados con la actualización.",
                    "items": {
                      "type": "object",
                      "properties": {
                        "key": {
                          "type": "string"
                        },
                        "value": {
                          "type": "string"
                        }
                      }
                    }
                  }
                }
              },
              "examples": {
                "Replace the split with one recipient": {
                  "value": {
                    "split_marketplace": [
                      {
                        "provider_recipient_id": "4c036fbdd2a44786815c331e9c011367",
                        "type": "MARKETPLACE",
                        "amount": {
                          "value": 6,
                          "currency": "BRL"
                        }
                      }
                    ],
                    "description": "Same-day split replacement",
                    "metadata": [
                      {
                        "key": "reason",
                        "value": "same-day redistribution"
                      }
                    ]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "El split fue reemplazado. La respuesta es el pago, con la misma forma que [Obtener pago por ID](/es/reference/payments/retrieve-payment-by-id); lee el nuevo split en `transactions.split_marketplace`.",
