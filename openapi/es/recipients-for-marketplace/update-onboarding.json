                "documentation": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "file_name": {
                        "type": "string",
                        "example": "utility-bill.pdf"
                      },
                      "content_type": {
                        "type": "string",
                        "example": "application/pdf"
                      },
                      "content_category": {
