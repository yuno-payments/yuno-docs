  "paths": {
    "/recipients/{recipient_id}/onboardings/{onboarding_id}": {
      "patch": {
        "summary": "Actualizar onboarding",
        "operationId": "update-onboarding",
        "parameters": [
          {
            "in": "path",
            "name": "recipient_id",
            "description": "ID del destinatario cuyo onboarding se actualizará",
            "schema": {
              "type": "string"
            },
            "required": true,
            "example": "9104911d-5df9-429e-8488-ad41abea1a4b"
          },
          {
            "in": "path",
            "name": "onboarding_id",
            "description": "ID del onboarding que se va a actualizar",
            "schema": {
              "type": "string"
            },
            "required": true,
            "example": "9104911d-5df9-429e-8488-ad41abea1a4b"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "account_id": {
                    "type": "string",
                    "description": "ID único de la cuenta en Yuno",
                    "example": "9104911d-5df9-429e-8488-ad41abea1a4b"
                  },
                  "type": {
                    "type": "string",
                    "enum": [
                      "PREVIOUSLY_ONBOARDED",
                      "ONE_STEP_ONBOARDING",
                      "TWO_STEP_ONBOARDING"
                    ],
                    "description": "Tipo de flujo de onboarding. PREVIOUSLY_ONBOARDED asocia una cuenta que ya existe en el proveedor, ONE_STEP_ONBOARDING crea la cuenta y hace el KYC en un solo paso, y TWO_STEP_ONBOARDING primero crea la cuenta y hace el KYC después.\n\nPara volver a registrar un onboarding PREVIOUSLY_ONBOARDED, envía `provider.id`, `provider.connection_id` y los ids de la cuenta del proveedor. Cuando la integración del proveedor permite adoptar cuentas existentes, Yuno repite el registro y aplica la respuesta: el onboarding pasa a `SUCCEEDED` o a `ERROR` con el mensaje del proveedor en `response_message`. Con cualquier otro proveedor, los ids se guardan y no se llama al proveedor. Una actualización sin ids del proveedor solo vuelve a enviar la notificación del estado actual. Qué proveedores adoptan cuentas existentes es una configuración de Yuno por entorno; consulta a tu Key Account Manager.",
                    "example": "PREVIOUSLY_ONBOARDED"
                  },
                  "workflow": {
                    "type": "string",
                    "enum": [
                      "HOSTED_BY_PROVIDER",
                      "HOSTED_BY_YUNO",
                      "DIRECT"
                    ],
                    "description": "Flujo del onboarding",
                    "example": "HOSTED_BY_PROVIDER"
                  },
                  "callback_url": {
                    "type": "string",
                    "format": "uri",
                    "description": "URL a la que redirigir a tu cliente después del proceso de onboarding con el proveedor, si es necesario.",
                    "example": "https://www.google.com"
                  },
                  "provider": {
                    "type": "object",
                    "description": "Proveedor del onboarding. En PREVIOUSLY_ONBOARDED, los ids de la cuenta del proveedor se reenvían a la integración del proveedor exactamente como se enviaron; qué ids necesita cada proveedor lo define su integración. Envía `id` y `connection_id` junto con los ids para volver a registrar la cuenta.",
                    "properties": {
                      "id": {
                        "type": "string",
                        "description": "ID del proveedor",
                        "example": "PAGARME"
                      },
                      "connection_id": {
                        "type": "string",
                        "description": "ID de la conexión en Yuno",
                        "example": "104911d-5df9-429e-8488-ad41abea1a4b"
                      },
                      "recipient_id": {
                        "type": "string",
                        "description": "Identificador único del destinatario del proveedor.",
                        "example": "AAAAA01"
                      },
                      "recipient_additional_id": {
                        "type": "string",
                        "description": "Identificador adicional del destinatario en el proveedor, para los proveedores que identifican una cuenta con más de un id. Si hace falta o no lo define la integración del proveedor.",
                        "example": "AAAAA01-SUB"
                      },
                      "balance_account_id": {
                        "type": "string",
                        "description": "Identificador de la cuenta de saldo del destinatario en el proveedor. Si hace falta o no lo define la integración del proveedor.",
                        "example": "BA00000000000000000000001"
                      },
                      "legal_entity": {
                        "type": "string",
                        "description": "Identificador de la entidad legal del destinatario en el proveedor. Si hace falta o no lo define la integración del proveedor.",
                        "example": "LE00000000000000000000001"
                      },
                      "recipient_type": {
                        "type": "string",
                        "description": "El tipo de destinatario para el proveedor.",
                        "enum": [
                          "MEAL",
                          "FOOD",
                          "MULTI_BENEFITS",
                          "FLEET"
                        ],
                        "example": "MEAL"
                      }
                    }
                  },
                  "documentation": {
                    "type": "array",
                    "description": "Especifica el objeto de documentación.",
                    "items": {
                      "type": "object",
                      "required": [
                        "file_name",
                        "content_type",
                        "content_category",
                        "content"
                      ],
                      "properties": {
                        "file_name": {
                          "type": "string",
                          "minLength": 3,
                          "maxLength": 255,
                          "description": "El nombre de la documentación enviada (MAX 255; MIN 3).",
                          "example": "PDF"
                        },
                        "content_type": {
                          "type": "string",
                          "enum": [
                            "application/pdf",
                            "image/jpeg",
                            "image/png"
                          ],
                          "description": "El tipo de documentación enviada por el comercio",
                          "example": "application/pdf"
                        },
                        "content_category": {
                          "type": "string",
                          "enum": [
                            "ACCOUNT_REQUIREMENT",
                            "BANK_STATEMENT",
                            "BUSINESS_ICON",
                            "BUSINESS_LOGO",
                            "CANCEL_POLICY",
                            "CUSTOMER_INTERACTION",
                            "DRIVERS_LICENCE",
                            "IDENTIFICATION_DOCUMENT",
                            "IDENTIFICATION_DOCUMENT_BACK",
                            "IDENTIFICATION_DOCUMENT_FRONT",
                            "LEGAL_AGREEMENT",
                            "OTHERS",
                            "PASSPORT",
                            "PAYMENT_DETAIL",
                            "PROOF_OF_ADDRESS",
                            "PROOF_OF_AUTHENTICITY",
                            "PROOF_OF_DELIVERY",
                            "PROOF_OF_DIRECTOR",
                            "PROOF_OF_INDUSTRY",
                            "PROOF_OF_NATIONAL_ID_NUMBER",
                            "PROOF_OF_OWNERSHIP",
                            "PROOF_OF_REGISTRATION",
                            "PROOF_OF_RELATIONSHIP",
                            "PROOF_OF_SERVICE",
                            "PROOF_OF_SOURCE_OF_FUNDS",
                            "PROOF_OF_SOURCE_OF_WEALTH",
                            "PROOF_OF_TAX",
                            "PROVIDER_IDENTITY_DOCUMENT",
                            "RECEIPT",
                            "REFUND_POLICY",
                            "SELFIE",
                            "SERVICE_AGREEMENT",
                            "SIGNATURE",
                            "TERMS_AND_CONDITIONS",
                            "VAT_DOCUMENT"
                          ],
                          "description": "La categoría de la documentación enviada por el comercio"
                        },
                        "content": {
                          "type": "string",
                          "format": "byte",
                          "description": "Contenido de la documentación enviada por el comercio, codificado en base64. Tamaño máximo: 1MB.",
                          "example": "JVBERi0xLjQKJeLjz9MKMSAwIG9iago8PAovVHlwZSAvQ2F0YWxvZwovUGFnZXMgMiAwIFIKPj4KZW5kb2JqCg=="
                        }
                      }
                    }
                  },
                  "withdrawal_methods": {
                    "type": "object",
                    "description": "Especifica el objeto de métodos de retiro.",
                    "properties": {
                      "bank": {
                        "type": "object",
                        "description": "struct",
                        "properties": {
                          "code": {
                            "type": "string",
                            "minLength": 3,
                            "maxLength": 3,
