                "type": "string",
                "example": "57"
              },
              "number": {
                "type": "string",
                "example": "3001234567"
              }
            }
          },
          "address": {
            "type": "object",
            "properties": {
              "address_line_1": {
                "type": "string",
                "example": "Carrera 7 # 32-16"
              },
              "address_line_2": {
