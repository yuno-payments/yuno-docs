                  "null"
                ],
                "example": "Oficina 201"
              },
              "city": {
                "type": "string",
                "example": "Bogota"
              },
              "country": {
                "type": "string",
                "example": "CO"
              },
              "state": {
                "type": "string",
                "example": "Cundinamarca"
              },
              "zip_code": {
                "type": "string",
                "example": "110311"
              },
