                      }
                    }
                  }
                },
                "withdrawal_methods": {
                  "type": "object",
                  "properties": {
                    "bank": {
                      "type": "object",
                      "properties": {
                        "code": {
                          "type": "string",
                          "example": "002"
                        },
                        "branch": {
                          "type": "string",
                          "example": "002"
                        },
