            "example": "fe14c7c6-c75e-43b7-bdbe-4c87ad52c482"
          },
          "merchant_recipient_id": {
            "type": "string",
            "description": "Identificador único del destinatario definido por el comercio.",
            "example": "MERCHANT_182acf1d-faeb-4ff0-94cd-7fab11b282f6"
          },
          "national_entity": {
            "type": "string",
            "description": "Tipo de entidad nacional del beneficiario.",
            "example": "INDIVIDUAL"
          },
          "entity_type": {
            "type": "string",
            "description": "Tipo de organización del beneficiario.",
            "example": "PRIVATE"
          },
          "first_name": {
            "type": "string",
            "description": "Nombre del beneficiario.",
            "example": "Juan"
          },
          "last_name": {
            "type": "string",
            "description": "Apellido del beneficiario.",
            "example": "Perez"
          },
          "legal_name": {
            "type": [
              "string",
              "null"
            ],
            "description": "Razón social del beneficiario.",
            "example": null
          },
          "email": {
            "type": "string",
            "description": "El correo electrónico del beneficiario.",
            "example": "juan.perez@example.com"
          },
          "date_of_birth": {
            "type": "string",
            "description": "Fecha de nacimiento del beneficiario.",
            "example": "1990-01-15"
          },
          "country": {
            "type": "string",
            "description": "El país del beneficiario.",
            "example": "CO"
          },
          "website": {
            "type": "string",
            "description": "La URL del sitio web del vendedor.",
            "example": "https://juanperez.com"
          },
          "industry": {
            "type": "string",
            "description": "El sector del vendedor.",
            "example": "Technology"
          },
          "merchant_category_code": {
            "type": "string",
            "description": "El código de categoría del comercio (MCC) (MAX 235; MIN 1).",
            "example": "5734"
          },
          "document": {
            "type": "object",
            "properties": {
              "document_number": {
                "type": "string",
                "example": "1234567890"
              },
              "document_type": {
                "type": "string",
                "example": "CC"
              }
            }
          },
          "phone": {
            "type": "object",
            "properties": {
