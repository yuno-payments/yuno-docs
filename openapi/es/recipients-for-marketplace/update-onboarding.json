                          "type": [
                            "string",
                            "null"
                          ],
                          "example": null
                        },
                        "account_type": {
                          "type": "string",
                          "example": "SAVINGS"
                        },
                        "routing": {
                          "type": "string",
                          "example": "021000022"
                        },
                        "country": {
                          "type": "string",
                          "example": "CO"
                        },
                        "currency": {
                          "type": "string",
                          "example": "COP"
                        }
                      }
                    }
                  }
                },
                "terms_of_service": {
                  "type": "object",
                  "properties": {
                    "acceptance": {
                      "type": "boolean",
                      "example": true
                    },
                    "date": {
                      "type": "string",
                      "example": "2025-07-21T20:43:54Z"
                    },
                    "ip": {
                      "type": "string",
                      "example": "129.21.111.11"
                    }
                  }
                },
                "created_at": {
                  "type": "string",
                  "format": "date-time",
                  "example": "2025-08-27T15:41:19.516982Z"
                },
                "updated_at": {
                  "type": "string",
                  "format": "date-time",
                  "example": "2025-08-27T15:41:19.516989Z"
                }
              }
            }
          },
          "split_configuration": {
            "type": "object",
            "description": "Reglas para el cálculo automático de la división a nivel de destinatario.",
            "properties": {
              "calculation_type": {
                "type": "string",
                "description": "El método que se usa para calcular el monto del split.",
                "enum": [
                  "PERCENTAGE",
                  "FIXED",
                  "MIXED"
                ],
                "example": "PERCENTAGE"
              },
              "percentage": {
                "type": "number",
                "description": "Porcentaje del monto total del pago que se va a dividir (0.01-100.00). Obligatorio si calculation_type es PERCENTAGE o MIXED.",
                "minimum": 0.01,
                "maximum": 100,
                "example": 10.5
              },
              "fixed_amount": {
                "type": "number",
                "description": "Monto fijo que se va a dividir. Obligatorio si calculation_type es FIXED o MIXED.",
                "minimum": 0.0001,
                "example": 5.0
              },
              "currency": {
                "type": "string",
                "description": "Código de moneda ISO 4217. Obligatorio para todos los tipos de cálculo.",
                "example": "USD"
              },
              "rounding_mode": {
                "type": "string",
                "description": "La estrategia de redondeo para los montos calculados. Obligatorio para PERCENTAGE y MIXED.",
                "enum": [
                  "STANDARD",
                  "ROUND_UP",
                  "ROUND_DOWN"
                ],
                "example": "STANDARD"
              }
            }
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "description": "Fecha de creación del destinatario (ISO 8601 MAX 27; MIN 27).",
            "example": "2025-08-27T15:41:19.497413Z"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "description": "Fecha de la última actualización del destinatario (ISO 8601 MAX 27; MIN 27).",
            "example": "2025-08-27T15:41:19.497425Z"
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
