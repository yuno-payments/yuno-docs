{
  "openapi": "3.1.0",
  "info": {
    "title": "promotions",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://api-sandbox.y.uno/v1",
      "description": "Sandbox"
    },
    {
      "url": "https://api.y.uno/v1",
      "description": "Production (US)"
    },
    {
      "url": "https://api.eu.y.uno/v1",
      "description": "Production (EMEA)"
    }
  ],
  "components": {
    "securitySchemes": {
      "sec0": {
        "type": "apiKey",
        "in": "header",
        "name": "public-api-key",
        "x-default": "<Your public-api-key>"
      },
      "sec1": {
        "type": "apiKey",
        "in": "header",
        "name": "private-secret-key",
        "x-default": "<Your private-secret-key>"
      }
    }
  },
  "security": [
    {
      "sec0": [],
      "sec1": []
    }
  ],
  "paths": {
    "/promotions": {
      "get": {
        "summary": "Listar promociones",
        "description": "Devuelve las promociones de la cuenta del encabezado `X-Account-Code`, de la más reciente a la más antigua, una página a la vez. La lista contiene las promociones `CODE` y `AUTOMATIC` de la cuenta. Yuno debe habilitar Promotions para tu organización antes de que puedas usar este endpoint. Consulta [Promociones](/docs/payment-features/promotions#enable-promotions-for-your-organization).",
        "operationId": "list-promotions",
        "parameters": [
          {
            "in": "header",
            "name": "X-Account-Code",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "El `account_id` que encuentras en tu [Dashboard de Yuno](https://dashboard.y.uno/developers) (UUID). Obligatorio. Una promoción pertenece a una cuenta, y este encabezado la indica. Si se omite, se devuelve `400 INVALID_PARAMETERS` (\"x-account-code header is required.\")."
          },
          {
            "name": "status",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "SCHEDULED",
                "ACTIVE",
                "EXPIRED",
                "DISABLED"
              ]
            },
            "description": "Filtra por estado. Acepta cualquier combinación de mayúsculas y minúsculas de las letras ASCII. Los espacios circundantes se ignoran. Cualquier otro valor, incluido uno con una letra parecida que no sea ASCII, devuelve `400 INVALID_REQUEST` con el mensaje `status: UNKNOWN`."
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 20
            },
            "description": "Tamaño de página, de 1 a 100. El valor predeterminado es 20. Un valor fuera del rango devuelve `400 INVALID_REQUEST` con el mensaje `limit: RANGE`, y uno que no es un número entero de hasta 3 dígitos devuelve `limit: FORMAT`."
          },
          {
            "name": "cursor",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Opaco. El `next_cursor` de la página anterior. Un cursor que no es válido devuelve `400 INVALID_REQUEST` con el mensaje `cursor: FORMAT`."
          }
        ],
        "responses": {
          "200": {
            "description": "200. Una página de promociones.",
            "content": {
              "application/json": {
                "examples": {
                  "Last page": {
                    "summary": "Last page",
                    "value": {
                      "data": [
                        {
                          "id": "00000000-0000-4000-8000-0000000000b1",
                          "account_id": "00000000-0000-4000-8000-0000000000a1",
                          "name": "Summer 10",
                          "description": null,
                          "schedule": {
                            "starts_at": "2026-11-01T00:00:00Z",
                            "ends_at": "2026-12-01T00:00:00Z"
                          },
                          "redemption": {
                            "mode": "CODE",
                            "code": "SUMMER10"
                          },
                          "discount": {
                            "type": "PERCENTAGE",
                            "value": 10,
                            "amounts": null
                          },
                          "conditions": {
                            "bins": null,
                            "payment_methods": null,
                            "card_types": null,
                            "countries": {
                              "values": [
                                "US"
                              ]
                            },
                            "amounts": {
                              "values": [
                                {
                                  "currency": "USD",
                                  "min": 50.0,
                                  "max": 5000.0
                                }
                              ]
                            }
                          },
                          "limits": {
                            "total": 100,
                            "used": 3
                          },
                          "status": "ACTIVE",
                          "created_at": "2026-10-16T15:04:05Z",
                          "disabled_at": null
                        }
                      ],
                      "next_cursor": null
                    }
                  }
                },
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "description": "Una promoción. Todos los miembros están presentes, con `null` para un valor ausente.",
                        "properties": {
                          "id": {
                            "type": "string",
                            "format": "uuid",
                            "description": "El id de la promoción (UUID). Lo asigna Yuno."
                          },
                          "account_id": {
                            "type": "string",
                            "format": "uuid",
                            "description": "La cuenta a la que pertenece la promoción."
                          },
                          "name": {
                            "type": "string"
                          },
                          "description": {
                            "type": [
                              "string",
                              "null"
                            ]
                          },
                          "schedule": {
                            "type": "object",
                            "properties": {
                              "starts_at": {
                                "type": "string",
                                "format": "date-time"
                              },
                              "ends_at": {
                                "type": [
                                  "string",
                                  "null"
                                ],
                                "format": "date-time",
                                "description": "`null` significa que no hay fecha de fin."
                              }
                            }
                          },
                          "redemption": {
                            "type": "object",
                            "properties": {
                              "mode": {
                                "type": "string",
                                "enum": [
                                  "AUTOMATIC",
                                  "CODE"
                                ],
                                "description": "Las promociones que creas con esta API son `CODE`. La cuenta también puede tener promociones `AUTOMATIC`, y la lista las devuelve también."
                              },
                              "code": {
                                "type": [
                                  "string",
                                  "null"
                                ],
                                "description": "El código, en mayúsculas. `null` para una promoción `AUTOMATIC`."
                              }
                            }
                          },
                          "discount": {
                            "type": "object",
                            "properties": {
                              "type": {
                                "type": "string",
                                "enum": [
                                  "PERCENTAGE",
                                  "FIXED"
                                ]
                              },
                              "value": {
                                "type": [
                                  "number",
                                  "null"
                                ],
                                "description": "Solo `PERCENTAGE`. `null` para un descuento fijo."
                              },
                              "amounts": {
                                "type": [
                                  "array",
                                  "null"
                                ],
                                "items": {
                                  "type": "object",
                                  "properties": {
                                    "currency": {
                                      "type": "string",
                                      "description": "Código de moneda ISO 4217."
                                    },
                                    "value": {
                                      "type": "number",
                                      "description": "Un monto en unidades mayores, con exactamente los decimales de la moneda."
                                    }
                                  }
                                },
                                "description": "Solo `FIXED`. `null` para un descuento porcentual."
                              }
                            }
                          },
                          "conditions": {
                            "type": "object",
                            "description": "Una clave por cada dimensión, `null` cuando la promoción no tiene ninguna condición sobre ella. Una promoción por código creada con esta API solo contiene `countries` y `amounts`.",
                            "properties": {
                              "bins": {
                                "type": [
                                  "object",
                                  "null"
                                ]
                              },
                              "payment_methods": {
                                "type": [
                                  "object",
                                  "null"
                                ],
                                "description": "Tipos de método de pago.",
                                "properties": {
                                  "values": {
                                    "type": "array",
                                    "items": {
                                      "type": "string"
                                    }
                                  }
                                }
                              },
                              "card_types": {
                                "type": [
                                  "object",
                                  "null"
                                ],
                                "description": "Tipos de tarjeta.",
                                "properties": {
                                  "values": {
                                    "type": "array",
                                    "items": {
                                      "type": "string"
                                    }
                                  }
                                }
                              },
                              "countries": {
                                "type": [
                                  "object",
                                  "null"
                                ],
                                "description": "Países del pago (ISO 3166-1).",
                                "properties": {
                                  "values": {
                                    "type": "array",
                                    "items": {
                                      "type": "string"
                                    }
                                  }
                                }
                              },
                              "amounts": {
                                "type": [
                                  "object",
                                  "null"
                                ],
                                "properties": {
                                  "values": {
                                    "type": "array",
                                    "items": {
                                      "type": "object",
                                      "properties": {
                                        "currency": {
                                          "type": "string"
                                        },
                                        "min": {
                                          "type": [
                                            "number",
                                            "null"
                                          ]
                                        },
                                        "max": {
                                          "type": [
                                            "number",
                                            "null"
                                          ]
                                        }
                                      }
                                    }
                                  }
                                }
                              }
                            }
                          },
                          "limits": {
                            "type": [
                              "object",
                              "null"
                            ],
                            "description": "El tope del código y los usos contados hasta ahora. `null` cuando la promoción no tiene tope.",
                            "properties": {
                              "total": {
                                "type": "integer",
                                "description": "Los usos máximos que acepta el código."
                              },
                              "used": {
                                "type": "integer",
                                "description": "Los usos contados hasta ahora. Aumenta en uno por cada nueva `X-Idempotency-Key` de pago y nunca disminuye."
                              }
                            }
                          },
                          "status": {
                            "type": "string",
                            "enum": [
                              "SCHEDULED",
                              "ACTIVE",
                              "EXPIRED",
                              "DISABLED"
                            ],
                            "description": "Se calcula a partir de `schedule` y de la deshabilitación en el momento en que lees la promoción."
                          },
                          "created_at": {
                            "type": "string",
                            "format": "date-time"
                          },
                          "disabled_at": {
                            "type": [
                              "string",
                              "null"
                            ],
                            "format": "date-time",
                            "description": "`null` mientras la promoción no esté deshabilitada."
                          }
                        }
                      },
                      "description": "Una página de promociones, de la más reciente a la más antigua. Vacía para una página vacía."
                    },
                    "next_cursor": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "description": "Pásalo como `cursor` para leer la página siguiente. `null` en la última página."
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "400. No hay encabezado `X-Account-Code`, o un parámetro de consulta no es válido.",
            "content": {
              "application/json": {
                "examples": {
                  "No X-Account-Code": {
                    "value": {
                      "code": "INVALID_PARAMETERS",
                      "messages": [
                        "x-account-code header is required."
                      ]
                    },
                    "summary": "No X-Account-Code header"
                  },
                  "Unknown status": {
                    "value": {
                      "code": "INVALID_REQUEST",
                      "messages": [
                        "status: UNKNOWN"
                      ]
                    },
                    "summary": "Unknown status filter"
                  },
                  "limit out of range": {
                    "value": {
                      "code": "INVALID_REQUEST",
                      "messages": [
                        "limit: RANGE"
                      ]
                    },
                    "summary": "limit outside 1 to 100"
                  },
                  "Invalid cursor": {
                    "value": {
                      "code": "INVALID_REQUEST",
                      "messages": [
                        "cursor: FORMAT"
                      ]
                    },
                    "summary": "Invalid cursor"
                  }
                },
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "string",
                      "example": "INVALID_PARAMETERS"
                    },
                    "messages": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "401. Faltan las credenciales o no son válidas.",
            "content": {
              "application/json": {
                "examples": {
                  "Unauthorized": {
                    "value": {
                      "code": "INVALID_CREDENTIALS",
                      "messages": [
                        "Invalid Credentials"
                      ]
                    }
                  },
                  "Not authenticated": {
                    "value": {
                      "code": "NOT_AUTHENTICATED",
                      "messages": [
                        "Not authenticated"
                      ]
                    }
                  }
                },
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "string",
                      "example": "INVALID_CREDENTIALS"
                    },
                    "messages": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "404. Promotions no está habilitado para tu organización. El cuerpo tiene un `code` y no tiene `messages`.",
            "content": {
              "application/json": {
                "examples": {
                  "Promotions not enabled": {
                    "value": {
                      "code": "PROMOTION_NOT_FOUND"
                    }
                  }
                },
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "string",
                      "example": "PROMOTION_NOT_FOUND"
                    },
                    "messages": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "500. Falló el servicio de promociones. Reintenta más tarde.",
            "content": {
              "application/json": {
                "examples": {
                  "Internal error": {
                    "value": {
                      "code": "INTERNAL_ERROR",
                      "messages": [
                        "Internal error"
                      ]
                    }
                  }
                },
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "string",
                      "example": "INTERNAL_ERROR"
                    },
                    "messages": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            }
          },
          "503": {
            "description": "503. El servicio de promociones no está configurado o no está disponible.",
            "content": {
              "application/json": {
                "examples": {
                  "Service unavailable": {
                    "value": {
                      "code": "PROMOTION_ENGINE_UNAVAILABLE",
                      "messages": [
                        "The promotions service is unavailable."
                      ]
                    }
                  },
                  "Store unavailable": {
                    "value": {
                      "code": "STORE_UNAVAILABLE",
                      "messages": [
                        "The store is unavailable."
                      ]
                    }
                  }
                },
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "string",
                      "example": "PROMOTION_ENGINE_UNAVAILABLE"
                    },
                    "messages": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            }
          },
          "504": {
            "description": "504. El servicio de promociones no respondió a tiempo.",
            "content": {
              "application/json": {
                "examples": {
                  "Gateway timeout": {
                    "value": {
                      "code": "PROMOTION_ENGINE_TIMEOUT",
                      "messages": [
                        "The promotions service did not answer in time."
                      ]
                    }
                  }
                },
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "string",
                      "example": "PROMOTION_ENGINE_TIMEOUT"
                    },
                    "messages": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "deprecated": false
      }
    }
  },
  "x-readme": {
    "headers": [
      {
        "value": "utf-8",
        "key": "charset"
      }
    ],
    "explorer-enabled": true,
    "proxy-enabled": true
  },
  "x-readme-fauxas": true
}
