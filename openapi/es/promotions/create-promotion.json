{
  "openapi": "3.1.0",
  "info": {
    "title": "promotions",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://api-sandbox.y.uno/v1",
      "description": "Sandbox"
    },
    {
      "url": "https://api.y.uno/v1",
      "description": "Production (US)"
    },
    {
      "url": "https://api.eu.y.uno/v1",
      "description": "Production (EMEA)"
    }
  ],
  "components": {
    "securitySchemes": {
      "sec0": {
        "type": "apiKey",
        "in": "header",
        "name": "public-api-key",
        "x-default": "<Your public-api-key>"
      },
      "sec1": {
        "type": "apiKey",
        "in": "header",
        "name": "private-secret-key",
        "x-default": "<Your private-secret-key>"
      }
    }
  },
  "security": [
    {
      "sec0": [],
      "sec1": []
    }
  ],
  "paths": {
    "/promotions": {
      "post": {
        "summary": "Crear promoción",
        "description": "Crea una promoción por código en la cuenta del encabezado `X-Account-Code`. Un cliente la canjea cuando tu servidor envía su código en un pago. Envía exactamente uno de `redemption.code` (un código propio, de 3 a 32 caracteres) y `redemption.prefix` (de 1 a 8 letras o dígitos). Con un prefijo, Yuno construye el código a partir del prefijo y un sufijo aleatorio de 5 caracteres, y devuelve el código en la respuesta. Yuno debe habilitar Promotions para tu organización antes de que puedas usar este endpoint. Consulta [Promociones](/docs/payment-features/promotions#enable-promotions-for-your-organization).",
        "operationId": "create-promotion",
        "parameters": [
          {
            "in": "header",
            "name": "X-Account-Code",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "El `account_id` que encuentras en tu [Dashboard de Yuno](https://dashboard.y.uno/developers) (UUID). Obligatorio. Una promoción pertenece a una cuenta, y este encabezado la indica. Si se omite, se devuelve `400 INVALID_PARAMETERS` (\"x-account-code header is required.\")."
          },
          {
            "in": "header",
            "name": "X-Idempotency-Key",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            },
            "description": "Obligatorio. Cualquier texto de 1 a 64 caracteres. La misma clave en la misma cuenta devuelve la primera promoción con `201`, y Yuno no compara el cuerpo."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "name",
                  "schedule",
                  "redemption",
                  "discount"
                ],
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 255,
                    "description": "El nombre de la promoción (de 1 a 255 caracteres)."
                  },
                  "description": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 1000,
                    "description": "Opcional. Hasta 1000 caracteres."
                  },
                  "schedule": {
                    "type": "object",
                    "required": [
                      "starts_at"
                    ],
                    "description": "El periodo en el que se ejecuta la promoción. UTC.",
                    "properties": {
                      "starts_at": {
                        "type": "string",
                        "format": "date-time",
                        "description": "Cuándo comienza la promoción (ISO 8601). Cualquier instante: un inicio en el pasado activa la promoción de inmediato."
                      },
                      "ends_at": {
                        "type": [
                          "string",
                          "null"
                        ],
                        "format": "date-time",
                        "description": "Cuándo termina la promoción (ISO 8601). Debe ser posterior a `starts_at`. Omítelo o envía `null` para que no tenga fecha de fin."
                      }
                    }
                  },
                  "redemption": {
                    "type": "object",
                    "required": [
                      "mode"
                    ],
                    "properties": {
                      "mode": {
                        "type": "string",
                        "enum": [
                          "CODE"
                        ],
                        "description": "Siempre `CODE`. Cualquier otro modo devuelve `400 INVALID_PARAMETERS`."
                      },
                      "code": {
                        "type": [
                          "string",
                          "null"
                        ],
                        "minLength": 3,
                        "maxLength": 32,
                        "description": "Un código propio: de 3 a 32 caracteres, `A-Z`, `0-9`, `_` y `-`, en cualquier caso. Yuno elimina los espacios que lo rodean, lo almacena en mayúsculas y compara el código de un pago sin distinguir mayúsculas de minúsculas. Es único por cuenta entre las promociones que no están deshabilitadas y cuyo calendario se superpone con este, y ningún código de lote de la cuenta lo tiene: de lo contrario, `409 CODE_ALREADY_EXISTS`. Envía exactamente uno de `code` y `prefix`: ninguno responde `redemption: CODE_OR_PREFIX_REQUIRED` y ambos responden `redemption: CODE_AND_PREFIX_EXCLUSIVE`. Un `null`, un texto vacío o un texto con solo espacios cuenta como no enviado."
                      },
                      "prefix": {
                        "type": [
                          "string",
                          "null"
                        ],
                        "maxLength": 8,
                        "description": "El inicio de un código que construye Yuno: de 1 a 8 letras o dígitos (`A-Z`, `a-z`, `0-9`). Yuno lo convierte a mayúsculas y construye el código como el prefijo más un sufijo aleatorio de 5 caracteres de `A-Z` y `2-9`, sin `0`, `O`, `1`, `I` y `L`, por ejemplo `SUMMERK7P2X`. El `201` muestra el código en `redemption.code`. Un carácter fuera de `A-Z`, `a-z` y `0-9` responde `redemption.prefix: FORMAT`, y más de 8 caracteres, `redemption.prefix: LENGTH`. Envía exactamente uno de `code` y `prefix`. Un `null`, un texto vacío o un texto con solo espacios cuenta como no enviado.",
                        "example": "SUMMER"
                      }
                    }
                  },
                  "discount": {
                    "type": "object",
                    "required": [
                      "type"
                    ],
                    "description": "Lo que ahorra el cliente. Para `FIXED`, cuando la promoción también tiene una condición `amounts`, `discount.amounts` y `conditions.amounts.values` deben listar las mismas monedas, o la solicitud devuelve `400`.",
                    "properties": {
                      "type": {
                        "type": "string",
                        "enum": [
                          "PERCENTAGE",
                          "FIXED"
                        ]
                      },
                      "value": {
                        "type": "number",
                        "minimum": 0.01,
                        "maximum": 100,
                        "description": "Solo `PERCENTAGE`, con hasta dos decimales (por ejemplo, `10.5`)."
                      },
                      "amounts": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "properties": {
                            "currency": {
                              "type": "string",
                              "description": "Código de moneda ISO 4217."
                            },
                            "value": {
                              "type": "number",
                              "description": "Un monto en unidades mayores, con exactamente los decimales de la moneda."
                            }
                          }
                        },
                        "description": "Solo `FIXED`: un `{ currency, value }` por cada moneda, como máximo 50, cada uno mayor que cero. Una promoción fija solo aplica a los pagos en las monedas que lista, y el descuento se limita al monto del pago."
                      }
                    }
                  },
                  "conditions": {
                    "type": "object",
                    "description": "Las condiciones que debe cumplir un pago. **AND** entre claves, **OR** dentro de la lista `values` de cada clave. Un código aplica a todo el pago, sea cual sea el método de pago, por lo que solo se aceptan `countries` y `amounts`. Una condición `bins`, `payment_methods` o `card_types` devuelve `400 INVALID_REQUEST` con los mensajes `conditions.bins: FORBIDDEN`, `conditions.payment_methods: FORBIDDEN` o `conditions.card_types: FORBIDDEN`.",
                    "properties": {
                      "countries": {
                        "type": "object",
                        "required": [
                          "values"
                        ],
                        "properties": {
                          "values": {
                            "type": "array",
                            "items": {
                              "type": "string"
                            },
                            "description": "Países del pago ([ISO 3166-1](/reference/country-reference)). Una lista vacía se rechaza."
                          }
                        }
                      },
                      "amounts": {
                        "type": "object",
                        "required": [
                          "values"
                        ],
                        "properties": {
                          "values": {
                            "type": "array",
                            "description": "Límites de monto por moneda. Un pago en una moneda sin entrada recibe el motivo `CURRENCY_MISMATCH`.",
                            "items": {
                              "type": "object",
                              "required": [
                                "currency"
                              ],
                              "properties": {
                                "currency": {
                                  "type": "string"
                                },
                                "min": {
                                  "type": "number",
                                  "description": "Inclusivo. Omítelo para no tener límite inferior."
                                },
                                "max": {
                                  "type": "number",
                                  "description": "Inclusivo. Omítelo para no tener límite superior."
                                }
                              }
                            }
                          }
                        }
                      }
                    }
                  },
                  "limits": {
                    "type": "object",
                    "description": "Opcional. Sin él, el código no tiene tope.",
                    "properties": {
                      "total": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 2147483647,
                        "description": "Los usos máximos que acepta el código. Yuno cuenta un uso cuando un pago toma el código, según la `X-Idempotency-Key` del pago. Un pago rechazado conserva su uso."
                      }
                    }
                  }
                }
              },
              "examples": {
                "Percentage code with a cap": {
                  "value": {
                    "name": "Summer 10",
                    "schedule": {
                      "starts_at": "2026-11-01T00:00:00Z",
                      "ends_at": "2026-12-01T00:00:00Z"
                    },
                    "redemption": {
                      "mode": "CODE",
                      "code": "SUMMER10"
                    },
                    "discount": {
                      "type": "PERCENTAGE",
                      "value": 10
                    },
                    "conditions": {
                      "countries": {
                        "values": [
                          "US"
                        ]
                      },
                      "amounts": {
                        "values": [
                          {
                            "currency": "USD",
                            "min": 50.0,
                            "max": 5000.0
                          }
                        ]
                      }
                    },
                    "limits": {
                      "total": 100
                    }
                  }
                },
                "A prefix, Yuno builds the code": {
                  "value": {
                    "name": "Summer 20",
                    "schedule": {
                      "starts_at": "2026-11-01T00:00:00Z",
                      "ends_at": "2026-12-01T00:00:00Z"
                    },
                    "redemption": {
                      "mode": "CODE",
                      "prefix": "SUMMER"
                    },
                    "discount": {
                      "type": "PERCENTAGE",
                      "value": 20
                    }
                  }
                },
                "Fixed code with no cap": {
                  "value": {
                    "name": "Ten dollars off",
                    "schedule": {
                      "starts_at": "2026-11-01T00:00:00Z"
                    },
                    "redemption": {
                      "mode": "CODE",
                      "code": "TEN-OFF"
                    },
                    "discount": {
                      "type": "FIXED",
                      "amounts": [
                        {
                          "currency": "USD",
                          "value": 10.0
                        }
                      ]
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "201. La promoción. La misma respuesta se devuelve cuando la cuenta repite la `X-Idempotency-Key`.",
            "content": {
              "application/json": {
                "examples": {
                  "A code promotion": {
                    "value": {
                      "id": "00000000-0000-4000-8000-0000000000b1",
                      "account_id": "00000000-0000-4000-8000-0000000000a1",
                      "name": "Summer 10",
                      "description": null,
                      "schedule": {
                        "starts_at": "2026-11-01T00:00:00Z",
                        "ends_at": "2026-12-01T00:00:00Z"
                      },
                      "redemption": {
                        "mode": "CODE",
                        "code": "SUMMER10"
                      },
                      "discount": {
                        "type": "PERCENTAGE",
                        "value": 10,
                        "amounts": null
                      },
                      "conditions": {
                        "bins": null,
                        "payment_methods": null,
                        "card_types": null,
                        "countries": {
                          "values": [
                            "US"
                          ]
                        },
                        "amounts": {
                          "values": [
                            {
                              "currency": "USD",
                              "min": 50.0,
                              "max": 5000.0
                            }
                          ]
                        }
                      },
                      "limits": {
                        "total": 100,
                        "used": 0
                      },
                      "status": "SCHEDULED",
                      "created_at": "2026-10-16T15:04:05Z",
                      "disabled_at": null
                    }
                  },
                  "A code promotion built from a prefix": {
                    "value": {
                      "id": "00000000-0000-4000-8000-0000000000b2",
                      "account_id": "00000000-0000-4000-8000-0000000000a1",
                      "name": "Summer 20",
                      "description": null,
                      "schedule": {
                        "starts_at": "2026-11-01T00:00:00Z",
                        "ends_at": "2026-12-01T00:00:00Z"
                      },
                      "redemption": {
                        "mode": "CODE",
                        "code": "SUMMERK7P2X"
                      },
                      "discount": {
                        "type": "PERCENTAGE",
                        "value": 20,
                        "amounts": null
                      },
                      "conditions": {
                        "bins": null,
                        "payment_methods": null,
                        "card_types": null,
                        "countries": null,
                        "amounts": null
                      },
                      "limits": null,
                      "status": "SCHEDULED",
                      "created_at": "2026-10-16T15:04:05Z",
                      "disabled_at": null
                    },
                    "summary": "The request had a prefix"
                  }
                },
                "schema": {
                  "type": "object",
                  "description": "Una promoción. Todos los miembros están presentes, con `null` para un valor ausente.",
                  "properties": {
                    "id": {
                      "type": "string",
                      "format": "uuid",
                      "description": "El id de la promoción (UUID). Lo asigna Yuno."
                    },
                    "account_id": {
                      "type": "string",
                      "format": "uuid",
                      "description": "La cuenta a la que pertenece la promoción."
                    },
                    "name": {
                      "type": "string"
                    },
                    "description": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "schedule": {
                      "type": "object",
                      "properties": {
                        "starts_at": {
                          "type": "string",
                          "format": "date-time"
                        },
                        "ends_at": {
                          "type": [
                            "string",
                            "null"
                          ],
                          "format": "date-time",
                          "description": "`null` significa que no hay fecha de fin."
                        }
                      }
                    },
                    "redemption": {
                      "type": "object",
                      "properties": {
                        "mode": {
                          "type": "string",
                          "enum": [
                            "AUTOMATIC",
                            "CODE"
                          ],
                          "description": "Las promociones que creas con esta API son `CODE`. La cuenta también puede tener promociones `AUTOMATIC`, y la lista las devuelve también."
                        },
                        "code": {
                          "type": [
                            "string",
                            "null"
                          ],
                          "description": "El código, en mayúsculas: el código que enviaste, o el código que Yuno construyó a partir de tu prefijo (el prefijo y un sufijo aleatorio de 5 caracteres, por ejemplo `SUMMERK7P2X`). `null` para una promoción `AUTOMATIC`."
                        }
                      }
                    },
                    "discount": {
                      "type": "object",
                      "properties": {
                        "type": {
                          "type": "string",
                          "enum": [
                            "PERCENTAGE",
                            "FIXED"
                          ]
                        },
                        "value": {
                          "type": [
                            "number",
                            "null"
                          ],
                          "description": "Solo `PERCENTAGE`. `null` para un descuento fijo."
                        },
                        "amounts": {
                          "type": [
                            "array",
                            "null"
                          ],
                          "items": {
                            "type": "object",
                            "properties": {
                              "currency": {
                                "type": "string",
                                "description": "Código de moneda ISO 4217."
                              },
                              "value": {
                                "type": "number",
                                "description": "Un monto en unidades mayores, con exactamente los decimales de la moneda."
                              }
                            }
                          },
                          "description": "Solo `FIXED`. `null` para un descuento porcentual."
                        }
                      }
                    },
                    "conditions": {
                      "type": "object",
                      "description": "Una clave por cada dimensión, `null` cuando la promoción no tiene ninguna condición sobre ella. Una promoción por código creada con esta API solo contiene `countries` y `amounts`.",
                      "properties": {
                        "bins": {
                          "type": [
                            "object",
                            "null"
                          ]
                        },
                        "payment_methods": {
                          "type": [
                            "object",
                            "null"
                          ],
                          "description": "Tipos de método de pago.",
                          "properties": {
                            "values": {
                              "type": "array",
                              "items": {
                                "type": "string"
                              }
                            }
                          }
                        },
                        "card_types": {
                          "type": [
                            "object",
                            "null"
                          ],
                          "description": "Tipos de tarjeta.",
                          "properties": {
                            "values": {
                              "type": "array",
                              "items": {
                                "type": "string"
                              }
                            }
                          }
                        },
                        "countries": {
                          "type": [
                            "object",
                            "null"
                          ],
                          "description": "Países del pago (ISO 3166-1).",
                          "properties": {
                            "values": {
                              "type": "array",
                              "items": {
                                "type": "string"
                              }
                            }
                          }
                        },
                        "amounts": {
                          "type": [
                            "object",
                            "null"
                          ],
                          "properties": {
                            "values": {
                              "type": "array",
                              "items": {
                                "type": "object",
                                "properties": {
                                  "currency": {
                                    "type": "string"
                                  },
                                  "min": {
                                    "type": [
                                      "number",
                                      "null"
                                    ]
                                  },
                                  "max": {
                                    "type": [
                                      "number",
                                      "null"
                                    ]
                                  }
                                }
                              }
                            }
                          }
                        }
                      }
                    },
                    "limits": {
                      "type": [
                        "object",
                        "null"
                      ],
                      "description": "El tope del código y los usos contados hasta ahora. `null` cuando la promoción no tiene tope.",
                      "properties": {
                        "total": {
                          "type": "integer",
                          "description": "Los usos máximos que acepta el código."
                        },
                        "used": {
                          "type": "integer",
                          "description": "Los usos contados hasta ahora. Aumenta en uno por cada nueva `X-Idempotency-Key` de pago y nunca disminuye."
                        }
                      }
                    },
                    "status": {
                      "type": "string",
                      "enum": [
                        "SCHEDULED",
                        "ACTIVE",
                        "EXPIRED",
                        "DISABLED"
                      ],
                      "description": "Se calcula a partir de `schedule` y de la deshabilitación en el momento en que lees la promoción."
                    },
                    "created_at": {
                      "type": "string",
                      "format": "date-time"
                    },
                    "disabled_at": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "format": "date-time",
                      "description": "`null` mientras la promoción no esté deshabilitada."
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "400. Dos tipos de cuerpo: `INVALID_PARAMETERS` para lo que public-api verifica antes de consultar el servicio de promociones, e `INVALID_REQUEST` para las verificaciones propias del servicio de promociones, con un mensaje `path: RULE` por cada ruta que falló.",
            "content": {
              "application/json": {
                "examples": {
                  "No X-Account-Code": {
                    "value": {
                      "code": "INVALID_PARAMETERS",
                      "messages": [
                        "x-account-code header is required."
                      ]
                    },
                    "summary": "No X-Account-Code header"
                  },
                  "No X-Idempotency-Key": {
                    "value": {
                      "code": "INVALID_PARAMETERS",
                      "messages": [
                        "The header 'X-Idempotency-Key' is required and must not exceed 64 characters."
                      ]
                    },
                    "summary": "No X-Idempotency-Key header"
                  },
                  "account_id in the body": {
                    "value": {
                      "code": "INVALID_PARAMETERS",
                      "messages": [
                        "The field 'account_id' is not accepted in the body: the promotion belongs to the account of the x-account-code header."
                      ]
                    },
                    "summary": "account_id in the body"
                  },
                  "Mode is not CODE": {
                    "value": {
                      "code": "INVALID_PARAMETERS",
                      "messages": [
                        "The field 'redemption.mode' must be CODE: merchants create promotions that customers redeem with a code."
                      ]
                    },
                    "summary": "redemption.mode is not CODE"
                  },
                  "Payment method condition": {
                    "value": {
                      "code": "INVALID_REQUEST",
                      "messages": [
                        "conditions.payment_methods: FORBIDDEN"
                      ]
                    },
                    "summary": "A payment method condition on a code"
                  },
                  "Code too short": {
                    "value": {
                      "code": "INVALID_REQUEST",
                      "messages": [
                        "redemption.code: CODE_LENGTH"
                      ]
                    },
                    "summary": "Code with fewer than 3 characters"
                  },
                  "Code too long": {
                    "value": {
                      "code": "INVALID_REQUEST",
                      "messages": [
                        "redemption.code: CODE_LENGTH"
                      ]
                    },
                    "summary": "Code with more than 32 characters"
                  },
                  "Neither a code nor a prefix": {
                    "value": {
                      "code": "INVALID_REQUEST",
                      "messages": [
                        "redemption: CODE_OR_PREFIX_REQUIRED",
                        "Send exactly one of redemption.code or redemption.prefix."
                      ]
                    },
                    "summary": "No redemption.code and no redemption.prefix (null, empty or spaces count as not sent)"
                  },
                  "A code and a prefix": {
                    "value": {
                      "code": "INVALID_REQUEST",
                      "messages": [
                        "redemption: CODE_AND_PREFIX_EXCLUSIVE",
                        "Send exactly one of redemption.code or redemption.prefix."
                      ]
                    },
                    "summary": "Both redemption.code and redemption.prefix"
                  },
                  "Prefix with a bad character": {
                    "value": {
                      "code": "INVALID_REQUEST",
                      "messages": [
                        "redemption.prefix: FORMAT"
                      ]
                    },
                    "summary": "Prefix with a character outside A-Z, a-z and 0-9"
                  },
                  "Prefix too long": {
                    "value": {
                      "code": "INVALID_REQUEST",
                      "messages": [
                        "redemption.prefix: LENGTH"
                      ]
                    },
                    "summary": "Prefix with more than 8 characters"
                  },
                  "Code with a bad character": {
                    "value": {
                      "code": "INVALID_REQUEST",
                      "messages": [
                        "redemption.code: CODE_CHARACTERS"
                      ]
                    },
                    "summary": "Code with a character outside A-Z, 0-9, _ and -"
                  },
                  "limits.total out of range": {
                    "value": {
                      "code": "INVALID_REQUEST",
                      "messages": [
                        "limits.total: RANGE"
                      ]
                    },
                    "summary": "limits.total below 1 or above 2147483647"
                  },
                  "ends_at not after starts_at": {
                    "value": {
                      "code": "INVALID_REQUEST",
                      "messages": [
                        "schedule.ends_at: NOT_AFTER_START"
                      ]
                    },
                    "summary": "schedule.ends_at not after schedule.starts_at"
