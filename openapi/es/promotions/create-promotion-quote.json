{
  "openapi": "3.1.0",
  "info": {
    "title": "promotions",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://api-sandbox.y.uno/v1",
      "description": "Sandbox"
    },
    {
      "url": "https://api.y.uno/v1",
      "description": "Production (US)"
    }
  ],
  "components": {
    "securitySchemes": {
      "sec0": {
        "type": "apiKey",
        "in": "header",
        "name": "public-api-key",
        "x-default": "<Your public-api-key>"
      },
      "sec1": {
        "type": "apiKey",
        "in": "header",
        "name": "private-secret-key",
        "x-default": "<Your private-secret-key>"
      }
    }
  },
  "security": [
    {
      "sec0": [],
      "sec1": []
    },
    {
      "sec0": []
    }
  ],
  "paths": {
    "/promotions/quote": {
      "post": {
        "summary": "Crear cotización de promoción",
        "description": "Calcula el precio de un pago antes de crearlo. Devuelve una cotización firmada cuando se aplica una promoción, o `204` cuando no se aplica ninguna. No se consume nada: volver a preguntar da el mismo precio, con un `expires_at` (y, por tanto, un `quote_id`) que cambia según el momento en que preguntes, y una cotización puede respaldar varios pagos. Una cotización dura 30 minutos desde que se emite, con ambas credenciales. Una solicitud que incluye un `code` obtiene una vista previa: los mismos montos, sin `quote_id` ni `expires_at`. No se firma, almacena ni cuenta nada, y el código se aplica cuando el pago lo incluye. Todas las condiciones de la promoción deben cumplirse ya para que exista una cotización. Yuno debe habilitar Promotions para tu organización antes de que puedas usar este endpoint. Consulta [Promociones](/docs/payment-features/promotions#enable-promotions-for-your-organization).",
        "operationId": "create-promotion-quote",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "country",
                  "payment_method"
                ],
                "oneOf": [
                  {
                    "required": [
                      "amount",
                      "account_id"
                    ]
                  },
                  {
                    "required": [
                      "checkout_session"
                    ]
                  }
                ],
                "properties": {
                  "account_id": {
                    "type": "string",
                    "description": "La cuenta que creará el pago (UUID). Obligatorio con la clave secreta. Con la clave pública y `checkout_session`, es opcional: Yuno toma la cuenta de la sesión de checkout, y el valor que envíes debe coincidir con ella."
                  },
                  "amount": {
                    "type": "object",
                    "required": [
                      "currency",
                      "value"
                    ],
                    "properties": {
                      "currency": {
                        "type": "string",
                        "description": "MAX 3; MIN 3; [ISO 4217](/reference/country-reference)."
                      },
                      "value": {
                        "type": "number",
                        "format": "float",
                        "description": "El monto en unidades mayores (por ejemplo, 250.00), sin más decimales de los que tiene la moneda: dos para USD, ninguno para JPY. Un valor con más decimales recibe `204`; una moneda sin decimales con decimales se rechaza con `400`."
                      }
                    },
                    "description": "El monto original del pago, antes de cualquier promoción. Debe ser el mismo `amount` que envíes después en el pago. Solo con la clave secreta: envía este campo, no `checkout_session`."
                  },
                  "checkout_session": {
                    "type": "string",
                    "description": "Id de la sesión de checkout (UUID v4). Úsalo con la clave pública en lugar de `amount`; el monto proviene de la sesión. La sesión no debe haberse usado ya para pagar, debe tener como máximo 2 horas y debe pertenecer a tu organización. No lo envíes nunca con la clave secreta."
                  },
                  "country": {
                    "type": "string",
                    "description": "El país del pago (MAX 2; MIN 2; [ISO 3166-1](/reference/country-reference))."
                  },
                  "payment_method": {
                    "type": "object",
                    "required": [
                      "type"
                    ],
                    "description": "El método de pago del pago que estás a punto de crear. Para una tarjeta, identifícala de UNA de tres formas: envía `bin`, o `token`, o `vaulted_token`. Dos cualesquiera de ellos juntos se rechazan con `400 INVALID_PARAMETERS`.",
                    "properties": {
                      "type": {
                        "type": "string",
                        "description": "El tipo de método de pago que eligió el cliente, por ejemplo `CARD`. Consulta [Payment type list](/reference/payment-type-list)."
                      },
                      "token": {
                        "type": "string",
                        "description": "Solo para tarjetas. El token de un solo uso de la tarjeta del SDK de Yuno. Yuno resuelve el BIN y el tipo de tarjeta a partir de él, por lo que no envías `bin`. Nunca junto con `bin` o `vaulted_token`."
                      },
                      "vaulted_token": {
                        "type": "string",
                        "description": "Solo para tarjetas. El token almacenado de una tarjeta guardada. Yuno resuelve el BIN y el tipo de tarjeta a partir de él, por lo que no envías `bin`. Nunca junto con `bin` o `token`."
                      },
                      "bin": {
                        "type": "string",
                        "description": "Solo para tarjetas. El BIN: los primeros 6 a 8 dígitos de la tarjeta, solo dígitos. Menos de 6 dígitos, más de 8 (un prefijo de tarjeta más largo o el número completo de la tarjeta) o cualquier cosa que no sean dígitos se rechaza con `400 INVALID_PARAMETERS`. Nunca envíes el número completo de la tarjeta. Envía `bin` cuando tu servidor tenga el número de tarjeta; envía un token cuando tenga un token; nunca ambos. Es necesario para las promociones con una condición `bins` (valores o rangos) cuando no envías ningún token. Un BIN de 6 dígitos solo coincide con las condiciones que cubren todo su bloque de 6 dígitos, así que envía 8 dígitos cuando una promoción liste prefijos de 8 dígitos o rangos más estrechos."
                      },
                      "card_type": {
                        "type": "string",
                        "description": "Solo para tarjetas. El tipo de tarjeta, por ejemplo `CREDIT` o `DEBIT`; no distingue mayúsculas de minúsculas. Envíalo junto con `bin` cuando lo conozcas; es necesario para las promociones con una condición `card_types`. Con un token puedes omitirlo: Yuno lo resuelve a partir de la tarjeta. Un tipo de tarjeta que la condición de la promoción no incluye recibe `204`."
                      }
                    }
                  },
                  "code": {
                    "type": "string",
                    "description": "Opcional. Un código de promoción que se va a cotizar: de 3 a 32 caracteres, `A-Z`, `0-9`, `_` y `-`, en cualquier caso. Un código con otro carácter u otra longitud no encuentra ninguna promoción. Este endpoint no envía ninguna clave de idempotencia, por lo que una solicitud con un `code` obtiene una vista previa: los mismos montos que una cotización, sin `quote_id` ni `expires_at`. Yuno no firma, almacena ni cuenta nada: el código se aplica cuando el pago lo incluye, y una vista previa no se puede enviar en un pago. Cuando una promoción automática le ahorra más al cliente que el código, la vista previa corresponde a esa promoción. Un código que no aplica responde `404` o `422`, no `204`, y un código que deja un cargo de cero responde `422` con el motivo `ZERO_CHARGE`. Consulta [Códigos de promoción](/docs/payment-features/promotion-codes)."
                  }
                }
              },
              "examples": {
                "Card payment with the BIN": {
                  "value": {
                    "account_id": "493e9374-510a-4201-9e09-de669d75f256",
                    "amount": {
                      "currency": "USD",
                      "value": 250.0
                    },
                    "country": "AR",
                    "payment_method": {
                      "type": "CARD",
                      "bin": "457896",
                      "card_type": "CREDIT"
                    }
                  }
                },
                "Public key with checkout session": {
                  "value": {
                    "checkout_session": "3f0c2b1e-7d5a-4b1c-9e2f-8a6d4c1b0e77",
                    "country": "AR",
                    "payment_method": {
                      "type": "CARD",
                      "bin": "457896",
                      "card_type": "CREDIT"
                    }
                  }
                },
                "Card payment with a vaulted token": {
                  "value": {
                    "account_id": "493e9374-510a-4201-9e09-de669d75f256",
                    "amount": {
                      "currency": "USD",
                      "value": 250.0
                    },
                    "country": "AR",
                    "payment_method": {
                      "type": "CARD",
                      "vaulted_token": "330953e7-09d8-47cf-a99c-cfb7968f13f9"
                    }
                  }
                },
                "Price a promotion code": {
                  "value": {
                    "account_id": "493e9374-510a-4201-9e09-de669d75f256",
                    "amount": {
                      "currency": "USD",
                      "value": 250.0
                    },
                    "country": "US",
                    "payment_method": {
                      "type": "CARD"
                    },
                    "code": "SUMMER10"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "200",
            "content": {
              "application/json": {
                "examples": {
                  "A promotion applies": {
                    "summary": "A promotion applies",
                    "value": {
                      "quote_id": "qte_eyJ2IjoxLCJrIjoi…",
                      "promotions": [
                        {
                          "id": "b7c1a4f2-6e0d-4a3b-9c55-1f2e7d8a0b31",
                          "name": "10% off with credit cards - Mother's Day",
                          "description": "10% off with your credit card.",
                          "discount": {
                            "type": "PERCENTAGE",
                            "value": 10
                          },
                          "discount_amount": {
                            "currency": "USD",
                            "value": 25.0
                          }
                        }
                      ],
                      "original_amount": {
                        "currency": "USD",
                        "value": 250.0
                      },
                      "discount_amount": {
                        "currency": "USD",
                        "value": 25.0
                      },
                      "charge_amount": {
                        "currency": "USD",
                        "value": 225.0
                      },
                      "expires_at": "2026-10-04T18:41:02Z"
                    }
                  },
                  "A promotion code (preview)": {
                    "summary": "A promotion code (preview)",
                    "value": {
                      "promotions": [
                        {
                          "id": "00000000-0000-4000-8000-0000000000b1",
                          "name": "Summer 10",
                          "description": null,
                          "discount": {
                            "type": "PERCENTAGE",
                            "value": 10
                          },
                          "discount_amount": {
                            "currency": "USD",
                            "value": 25.0
                          }
                        }
                      ],
                      "original_amount": {
                        "currency": "USD",
                        "value": 250.0
                      },
                      "discount_amount": {
                        "currency": "USD",
                        "value": 25.0
                      },
                      "charge_amount": {
                        "currency": "USD",
                        "value": 225.0
                      }
                    }
                  }
                },
                "schema": {
                  "type": "object",
                  "required": [
                    "promotions",
                    "original_amount",
                    "discount_amount",
                    "charge_amount"
                  ],
                  "properties": {
                    "quote_id": {
                      "type": "string",
                      "description": "Opaco y largo: de unos 300 a 730 caracteres. Guárdalo completo, hasta 1000 caracteres, y envíalo sin cambios en el pago como `quote_id` en una línea de `additional_data.order.discounts` con `type: YUNO_PROMOTION`. Nunca lo analices ni lo acortes. Ausente cuando la solicitud incluye un `code`: esa respuesta es una vista previa, y una vista previa no se puede pagar."
                    },
                    "promotions": {
                      "type": "array",
                      "minItems": 1,
                      "description": "Las promociones que aplican. Una entrada en esta versión; una versión posterior puede devolver más de una. El `discount_amount` exterior es la suma del `discount_amount` de cada entrada.",
                      "items": {
                        "type": "object",
                        "required": [
                          "id",
                          "name",
                          "description",
                          "discount",
                          "discount_amount"
                        ],
                        "properties": {
                          "id": {
                            "type": "string"
                          },
                          "name": {
                            "type": "string"
                          },
                          "description": {
                            "type": [
                              "string",
                              "null"
                            ],
                            "description": "La descripción de la promoción. Siempre presente; `null` cuando la promoción no tiene ninguna."
                          },
                          "discount": {
                            "type": "object",
                            "description": "El descuento de la promoción: `type` y `value`. `PERCENTAGE`: `value` es el porcentaje. `FIXED`: `value` es el monto fijo en la moneda del pago, antes de limitarlo al monto del pago.",
                            "required": [
                              "type",
                              "value"
                            ],
                            "properties": {
                              "type": {
                                "type": "string",
                                "enum": [
                                  "PERCENTAGE",
                                  "FIXED"
                                ]
                              },
                              "value": {
                                "type": "number"
                              }
                            }
                          },
                          "discount_amount": {
                            "type": "object",
                            "description": "Lo que ahorra esta promoción en el pago cotizado.",
                            "properties": {
                              "currency": {
                                "type": "string"
                              },
                              "value": {
                                "type": "number",
                                "format": "float"
                              }
                            }
                          }
                        }
                      }
                    },
                    "original_amount": {
                      "type": "object",
                      "description": "El monto que enviaste, antes del descuento.",
                      "properties": {
                        "currency": {
                          "type": "string"
                        },
                        "value": {
                          "type": "number",
                          "format": "float"
                        }
                      }
                    },
                    "discount_amount": {
                      "type": "object",
                      "description": "Descuento total (suma de `promotions[].discount_amount`). Siempre positivo.",
                      "properties": {
                        "currency": {
                          "type": "string"
                        },
                        "value": {
                          "type": "number",
                          "format": "float"
                        }
                      }
                    },
                    "charge_amount": {
                      "type": "object",
                      "description": "Lo que paga el cliente: el monto original menos el descuento.",
                      "properties": {
                        "currency": {
                          "type": "string"
                        },
                        "value": {
                          "type": "number",
                          "format": "float"
                        }
                      }
                    },
                    "expires_at": {
                      "type": "string",
                      "format": "date-time",
                      "description": "La cotización es válida hasta este instante: 30 minutos después de emitirse. Ausente en una vista previa (una solicitud que incluye un `code`)."
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "400",
            "content": {
              "application/json": {
                "examples": {
                  "BIN not 6 to 8 digits": {
                    "summary": "BIN not 6 to 8 digits",
                    "value": {
                      "code": "INVALID_PARAMETERS",
                      "messages": [
                        "The field 'payment_method.bin' must contain 6 to 8 digits."
                      ]
                    }
                  },
                  "BIN and token together": {
                    "summary": "BIN and token together",
                    "value": {
                      "code": "INVALID_PARAMETERS",
                      "messages": [
                        "The fields 'payment_method.bin' and 'payment_method.token' cannot be sent together."
                      ]
                    }
                  },
                  "Token and vaulted token together": {
                    "summary": "Token and vaulted token together",
                    "value": {
                      "code": "INVALID_PARAMETERS",
                      "messages": [
                        "The fields 'payment_method.token' and 'payment_method.vaulted_token' cannot be sent together."
                      ]
                    }
                  },
                  "amount sent with a public key": {
                    "summary": "amount sent with a public key",
                    "value": {
                      "code": "INVALID_PARAMETERS",
                      "messages": [
                        "The field 'amount' is not allowed when using the public API key."
                      ]
                    }
                  },
                  "checkout_session sent with a secret key": {
                    "summary": "checkout_session sent with a secret key",
                    "value": {
                      "code": "INVALID_PARAMETERS",
                      "messages": [
                        "The field 'checkout_session' is not allowed when using the secret key."
                      ]
                    }
                  },
                  "account_id doesn't match the session": {
                    "summary": "account_id doesn't match the session",
                    "value": {
                      "code": "INVALID_PARAMETERS",
                      "messages": [
                        "The field 'account_id' must match the checkout session."
                      ]
                    }
                  },
                  "country doesn't match the session": {
                    "summary": "country doesn't match the session",
                    "value": {
                      "code": "INVALID_PARAMETERS",
                      "messages": [
                        "The field 'country' must match the checkout session."
                      ]
                    }
                  },
                  "Checkout session already used": {
                    "summary": "Checkout session already used",
                    "value": {
                      "code": "INVALID_PARAMETERS",
                      "messages": [
                        "The checkout session has already been used."
                      ]
                    }
                  },
                  "Checkout session expired": {
                    "summary": "Checkout session expired",
                    "value": {
                      "code": "INVALID_PARAMETERS",
                      "messages": [
                        "The checkout session has expired."
                      ]
                    }
                  },
                  "account_id is not valid": {
                    "summary": "account_id is not valid",
                    "value": {
                      "code": "INVALID_ACCOUNT_ID",
                      "messages": [
                        "Account id is invalid"
                      ]
                    }
                  },
                  "Field with the wrong data type": {
                    "summary": "Field with the wrong data type",
                    "value": {
                      "code": "BAD_REQUEST",
                      "messages": [
                        "The field 'payment_method.bin' wrong data type."
                      ]
                    }
                  },
                  "Body is not valid JSON": {
                    "summary": "Body is not valid JSON",
                    "value": {
                      "code": "BAD_REQUEST",
                      "messages": [
                        "Bad request"
                      ]
                    }
                  },
                  "Checkout session not found": {
                    "summary": "Checkout session not found",
                    "value": {
                      "code": "CHECKOUT_SESSION_NOT_EXISTS",
                      "messages": [
                        "session with code 3f0c2b1e-7d5a-4b1c-9e2f-8a6d4c1b0e77 not found"
                      ]
                    }
                  }
                },
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "string",
                      "example": "INVALID_PARAMETERS"
                    },
                    "messages": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "401",
            "content": {
              "application/json": {
                "examples": {
                  "Unauthorized": {
                    "value": {
                      "code": "INVALID_CREDENTIALS",
                      "messages": [
                        "Invalid Credentials"
                      ]
                    }
                  },
                  "Not authenticated": {
                    "value": {
                      "code": "NOT_AUTHENTICATED",
                      "messages": [
                        "Not authenticated"
                      ]
                    }
                  }
                },
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "string",
                      "example": "INVALID_CREDENTIALS"
                    },
                    "messages": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "example": "Invalid Credentials"
                      }
                    }
                  }
                }
              }
            }
          },
          "204": {
            "description": "No aplica ninguna promoción a este contexto de pago (una solicitud con un `code` recibe en su lugar un `404` o un `422`), Promotions no está habilitado para tu organización o Yuno lo deshabilitó temporalmente, Yuno no pudo calcular el precio del pago a tiempo, o una promoción automática dejaría el cargo en cero. No hay cuerpo. Crea el pago como de costumbre, sin `quote_id` en una línea de descuento."
          },
          "404": {
            "description": "404. La solicitud incluye un `code` y ninguna promoción de la cuenta lo tiene, o la promoción que lo tiene aún no comenzó, o el código tiene un carácter fuera de `A-Z`, `0-9`, `_` y `-` o una longitud fuera del rango de 3 a 32.",
            "content": {
              "application/json": {
                "examples": {
                  "Result": {
                    "value": {
                      "code": "PROMOTION_NOT_FOUND",
                      "messages": [
                        "The promotion does not exist on the account."
                      ]
                    },
                    "summary": "Result"
                  }
                },
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "string",
                      "example": "PROMOTION_NOT_FOUND"
                    },
                    "messages": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            }
          },
          "422": {
            "description": "422. La solicitud incluye un `code` que tiene una promoción de la cuenta, y el código no aplica. El `reason` indica por qué: `EXPIRED`, `DISABLED`, `USAGE_LIMIT_REACHED`, `CONDITIONS_NOT_MET`, `CURRENCY_MISMATCH`, `ZERO_DISCOUNT` o `ZERO_CHARGE`.",
            "content": {
              "application/json": {
                "examples": {
                  "Code that reached its limit": {
                    "summary": "Code that reached its limit",
                    "value": {
                      "code": "PROMOTION_NOT_APPLICABLE",
                      "messages": [
                        "The promotion reached its limit of uses."
                      ],
                      "reason": "USAGE_LIMIT_REACHED"
                    }
                  },
                  "Code outside the conditions": {
                    "summary": "Code outside the conditions",
                    "value": {
                      "code": "PROMOTION_NOT_APPLICABLE",
                      "messages": [
                        "The payment does not meet the conditions of the promotion."
                      ],
                      "reason": "CONDITIONS_NOT_MET"
                    }
                  },
                  "Code that expired": {
                    "summary": "Code that expired",
                    "value": {
                      "code": "PROMOTION_NOT_APPLICABLE",
                      "messages": [
                        "The promotion expired."
                      ],
                      "reason": "EXPIRED"
                    }
                  },
                  "Code that leaves a charge of zero": {
                    "summary": "Code that leaves a charge of zero",
                    "value": {
                      "code": "PROMOTION_NOT_APPLICABLE",
                      "messages": [
                        "The promotion leaves a charge of zero on this amount."
                      ],
                      "reason": "ZERO_CHARGE"
                    }
                  }
                },
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "string",
                      "example": "PROMOTION_NOT_APPLICABLE"
                    },
                    "messages": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "reason": {
                      "type": "string",
                      "enum": [
                        "EXPIRED",
                        "DISABLED",
                        "USAGE_LIMIT_REACHED",
                        "CONDITIONS_NOT_MET",
                        "CURRENCY_MISMATCH",
                        "ZERO_DISCOUNT",
                        "ZERO_CHARGE"
                      ]
                    }
                  }
                }
              }
            }
          },
          "408": {
            "description": "408. Yuno tardó demasiado en responder. Trátalo como un `204`: crea el pago sin promoción.",
            "content": {
              "application/json": {
                "examples": {
                  "Request timeout": {
                    "value": {
                      "code": "REQUEST_TIMEOUT",
                      "messages": [
                        "Request Timeout"
                      ]
                    }
                  }
                },
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "string",
                      "example": "REQUEST_TIMEOUT"
                    },
                    "messages": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            }
          },
          "413": {
            "description": "413. El cuerpo supera los 16 KiB.",
            "content": {
              "application/json": {
                "examples": {
                  "Request too large": {
                    "value": {
                      "code": "REQUEST_ENTITY_TOO_LARGE",
                      "messages": [
                        "Request entity too large"
                      ]
                    }
                  }
                },
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "string",
                      "example": "REQUEST_ENTITY_TOO_LARGE"
                    },
