{
  "openapi": "3.1.0",
  "info": {
    "title": "promotions",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://api-sandbox.y.uno/v1",
      "description": "Sandbox"
    },
    {
      "url": "https://api.y.uno/v1",
      "description": "Production (US)"
    },
    {
      "url": "https://api.eu.y.uno/v1",
      "description": "Production (EMEA)"
    }
  ],
  "components": {
    "securitySchemes": {
      "sec0": {
        "type": "apiKey",
        "in": "header",
        "name": "public-api-key",
        "x-default": "<Your public-api-key>"
      },
      "sec1": {
        "type": "apiKey",
        "in": "header",
        "name": "private-secret-key",
        "x-default": "<Your private-secret-key>"
      }
    }
  },
  "security": [
    {
      "sec0": [],
      "sec1": []
    }
  ],
  "x-readme": {
    "headers": [
      {
        "value": "utf-8",
        "key": "charset"
      }
    ],
    "explorer-enabled": true,
    "proxy-enabled": true
  },
  "x-readme-fauxas": true,
  "paths": {
    "/promotions/{promotion_id}/codes": {
      "get": {
        "summary": "Listar códigos de promoción",
        "description": "Lista los códigos de lote de una promoción de la cuenta del encabezado `X-Account-Code`, del más antiguo al más reciente, una página a la vez. `limit` acepta de 1 a 500 y su valor predeterminado es 100. Pasa el `next_cursor` de una página como `cursor` para leer la siguiente; es `null` en la última página. `used` es el número de pagos que tomaron el código. Una promoción deshabilitada también lista sus códigos. Los códigos son secretos; Yuno no los escribe en sus registros.",
        "operationId": "listPromotionCodes",
        "parameters": [
          {
            "in": "header",
            "name": "X-Account-Code",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "El `account_id` que encuentras en tu [Dashboard de Yuno](https://dashboard.y.uno/developers) (UUID). Obligatorio. Una promoción pertenece a una cuenta, y este encabezado la indica. Si se omite, se devuelve `400 INVALID_PARAMETERS` (\"x-account-code header is required.\")."
          },
          {
            "in": "path",
            "name": "promotion_id",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "El id de la promoción (UUID v4). La promoción debe pertenecer a la cuenta de `X-Account-Code`. Una promoción sin códigos, como una promoción `AUTOMATIC`, responde `200` con una lista `codes` vacía. Un id que no es un UUID v4 responde `400 INVALID_PARAMETERS`."
          },
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 500,
              "default": 100
            },
            "description": "Cuántos códigos se devuelven, de 1 a 500. Valor predeterminado: 100. Un valor fuera de ese rango responde `400 INVALID_REQUEST` con `limit: RANGE`; un valor con un carácter que no es un dígito, o con más de tres dígitos, responde `limit: FORMAT`."
          },
          {
            "in": "query",
            "name": "cursor",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "El `next_cursor` de la página anterior. Un cursor que no es válido responde `400 INVALID_REQUEST` con `cursor: FORMAT`."
          }
        ],
        "responses": {
          "200": {
            "description": "200. Una página de códigos, del más antiguo al más reciente. `next_cursor` es `null` en la última página.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "codes": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "code": {
                            "type": "string",
                            "description": "Un secreto."
                          },
                          "uses_per_code": {
                            "type": "integer",
                            "description": "Cuántos pagos acepta el código."
                          },
                          "used": {
                            "type": "integer",
                            "description": "Cuántos pagos tomaron el código."
                          },
                          "batch_id": {
                            "type": "string",
                            "format": "uuid"
                          },
                          "created_at": {
                            "type": "string",
                            "format": "date-time",
                            "description": "Cuándo se creó el código. Todos los códigos de un mismo lote lo comparten."
                          }
                        }
                      }
                    },
                    "next_cursor": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "description": "Pásalo como `cursor` para leer la página siguiente. `null` en la última página."
                    }
                  }
                },
                "examples": {
                  "A page of codes": {
                    "summary": "Two codes, the last page",
                    "value": {
                      "codes": [
                        {
                          "code": "SUMMERA7KQ9",
                          "uses_per_code": 1,
                          "used": 1,
                          "batch_id": "3f6a9c1e-2b7d-8e4a-9f15-6c0d2b8e7a41",
                          "created_at": "2026-10-20T14:00:00.000001Z"
                        },
                        {
                          "code": "SUMMERM2TX4",
                          "uses_per_code": 1,
                          "used": 0,
                          "batch_id": "3f6a9c1e-2b7d-8e4a-9f15-6c0d2b8e7a41",
                          "created_at": "2026-10-20T14:00:00.000001Z"
                        }
                      ],
                      "next_cursor": null
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "400. No hay encabezado `X-Account-Code` (`INVALID_PARAMETERS`), o `limit` o `cursor` no son válidos (`INVALID_REQUEST`).",
            "content": {
              "application/json": {
                "examples": {
                  "No X-Account-Code": {
                    "summary": "No X-Account-Code header",
                    "value": {
                      "code": "INVALID_PARAMETERS",
                      "messages": [
                        "x-account-code header is required."
                      ]
                    }
                  },
                  "limit out of range": {
                    "summary": "limit is 0 or more than 500",
                    "value": {
                      "code": "INVALID_REQUEST",
                      "messages": [
                        "limit: RANGE"
                      ]
                    }
                  },
                  "cursor not issued": {
                    "summary": "A cursor that is not valid",
                    "value": {
                      "code": "INVALID_REQUEST",
                      "messages": [
                        "cursor: FORMAT"
                      ]
                    }
                  }
                },
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "string"
                    },
                    "messages": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "401. Faltan las credenciales o no son válidas.",
            "content": {
              "application/json": {
                "examples": {
                  "Unauthorized": {
                    "value": {
                      "code": "INVALID_CREDENTIALS",
                      "messages": [
                        "Invalid Credentials"
                      ]
                    }
                  },
                  "Not authenticated": {
                    "value": {
                      "code": "NOT_AUTHENTICATED",
                      "messages": [
                        "Not authenticated"
                      ]
                    }
                  }
                },
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "string",
                      "example": "INVALID_CREDENTIALS"
                    },
                    "messages": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "404. Ninguna promoción de la cuenta tiene este id, o Promotions no está habilitado para tu organización.",
            "content": {
              "application/json": {
                "examples": {
                  "Promotion not on the account": {
                    "summary": "The promotion is not on the account",
                    "value": {
                      "code": "PROMOTION_NOT_FOUND",
                      "messages": [
                        "The promotion does not exist on the account."
                      ]
                    }
                  },
                  "Promotions not enabled": {
                    "summary": "Promotions is not enabled",
                    "value": {
                      "code": "PROMOTION_NOT_FOUND"
                    }
                  }
                },
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "string"
                    },
                    "messages": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "500. Falló el servicio de promociones. Reintenta la solicitud.",
            "content": {
              "application/json": {
                "examples": {
                  "Internal error": {
                    "value": {
                      "code": "INTERNAL_ERROR",
                      "messages": [
                        "Internal error"
                      ]
                    }
                  }
                },
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "string",
                      "example": "INTERNAL_ERROR"
                    },
                    "messages": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            }
          },
          "503": {
            "description": "503. El servicio de promociones no está configurado o no está disponible.",
            "content": {
              "application/json": {
                "examples": {
                  "Service unavailable": {
                    "value": {
                      "code": "PROMOTION_ENGINE_UNAVAILABLE",
                      "messages": [
                        "The promotions service is unavailable."
                      ]
                    }
                  },
                  "Store unavailable": {
                    "value": {
                      "code": "STORE_UNAVAILABLE",
                      "messages": [
                        "The store is unavailable."
                      ]
                    }
                  }
                },
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "string",
                      "example": "PROMOTION_ENGINE_UNAVAILABLE"
                    },
                    "messages": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            }
          },
          "504": {
            "description": "504. El servicio de promociones no respondió a tiempo.",
            "content": {
              "application/json": {
                "examples": {
                  "Gateway timeout": {
                    "value": {
                      "code": "PROMOTION_ENGINE_TIMEOUT",
                      "messages": [
                        "The promotions service did not answer in time."
                      ]
                    }
                  }
                },
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "string",
                      "example": "PROMOTION_ENGINE_TIMEOUT"
                    },
                    "messages": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
