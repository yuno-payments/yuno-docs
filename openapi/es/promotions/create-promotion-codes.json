{
  "openapi": "3.1.0",
  "info": {
    "title": "promotions",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://api-sandbox.y.uno/v1",
      "description": "Sandbox"
    },
    {
      "url": "https://api.y.uno/v1",
      "description": "Production (US)"
    },
    {
      "url": "https://api.eu.y.uno/v1",
      "description": "Production (EMEA)"
    }
  ],
  "components": {
    "securitySchemes": {
      "sec0": {
        "type": "apiKey",
        "in": "header",
        "name": "public-api-key",
        "x-default": "<Your public-api-key>"
      },
      "sec1": {
        "type": "apiKey",
        "in": "header",
        "name": "private-secret-key",
        "x-default": "<Your private-secret-key>"
      }
    }
  },
  "security": [
    {
      "sec0": [],
      "sec1": []
    }
  ],
  "x-readme": {
    "headers": [
      {
        "value": "utf-8",
        "key": "charset"
      }
    ],
    "explorer-enabled": true,
    "proxy-enabled": true
  },
  "x-readme-fauxas": true,
  "paths": {
    "/promotions/{promotion_id}/codes": {
      "post": {
        "summary": "Crear códigos de promoción",
        "description": "Genera un lote de códigos en una promoción por código de la cuenta indicada en el encabezado `X-Account-Code`. Cada código es el prefijo más un sufijo aleatorio, con su propio límite de usos (`uses_per_code`). `quantity` (de 1 a 1000) y `prefix` son obligatorios. Una promoción admite como máximo 10.000 códigos de lote. La misma `X-Idempotency-Key` en la misma promoción devuelve el primer lote. Los códigos solo se devuelven en esta respuesta y en List Promotion Codes. Mantenlos en secreto; Yuno no los escribe en sus registros.",
        "operationId": "createPromotionCodes",
        "parameters": [
          {
            "in": "header",
            "name": "X-Account-Code",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "El `account_id` que encuentras en tu [Dashboard de Yuno](https://dashboard.y.uno/developers) (UUID). Obligatorio. Una promoción pertenece a una cuenta, y este encabezado la indica. Si se omite, se devuelve `400 INVALID_PARAMETERS` (\"x-account-code header is required.\")."
          },
          {
            "in": "header",
            "name": "X-Idempotency-Key",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            },
            "description": "Obligatorio. Cualquier texto de 1 a 64 caracteres. La misma clave en la misma promoción devuelve el primer lote con `201`. Yuno no compara el cuerpo."
          },
          {
            "in": "path",
            "name": "promotion_id",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "El id de la promoción (UUID v4). La promoción debe pertenecer a la cuenta de `X-Account-Code` y debe ser una promoción por código (`redemption.mode` es `CODE`). Un id que no es un UUID v4 responde `400 INVALID_PARAMETERS`."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "quantity",
                  "prefix"
                ],
                "properties": {
                  "quantity": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 1000,
                    "description": "El número de códigos del lote, de 1 a 1000. Un valor ausente responde `quantity: REQUIRED`, y un valor fuera de ese rango responde `quantity: RANGE`. Ambos son `400 INVALID_REQUEST`."
                  },
                  "uses_per_code": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 1000000,
                    "default": 1,
                    "description": "Cuántos pagos acepta cada código, de 1 a 1000000. Opcional: sin este campo, cada código acepta un pago. Un valor fuera de ese rango responde `uses_per_code: RANGE`."
                  },
                  "prefix": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 8,
                    "description": "Obligatorio. De 1 a 8 letras o dígitos (`A-Z`, `0-9`), en cualquier caso. Yuno lo convierte a mayúsculas y construye cada código a partir de él: el prefijo y luego un sufijo aleatorio. Un prefijo ausente o en blanco responde `prefix: REQUIRED`. Un cuerpo con un `code` se rechaza con `code: NOT_ALLOWED`."
                  }
                }
              },
              "examples": {
                "Batch of three codes": {
                  "summary": "A batch of three codes with a prefix",
                  "value": {
                    "quantity": 3,
                    "uses_per_code": 1,
                    "prefix": "SUMMER"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "201. El lote, con sus códigos. La misma clave en la misma promoción devuelve el mismo lote con `201`.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "description": "Un lote de códigos.",
                  "properties": {
                    "batch_id": {
                      "type": "string",
                      "format": "uuid",
                      "description": "El id del lote. Se deriva de la cuenta, la promoción y la clave."
                    },
                    "promotion_id": {
                      "type": "string",
                      "format": "uuid"
                    },
                    "quantity": {
                      "type": "integer",
                      "description": "El número de códigos en la respuesta."
                    },
                    "codes": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "code": {
                            "type": "string",
                            "description": "Un secreto. El prefijo y un sufijo aleatorio de 5, 6 o 7 caracteres, según la cantidad de la solicitud."
                          },
                          "uses_per_code": {
                            "type": "integer",
                            "description": "Cuántos pagos acepta el código."
                          }
                        }
                      }
                    }
                  }
                },
                "examples": {
                  "Batch created": {
                    "summary": "A batch of three codes",
                    "value": {
                      "batch_id": "3f6a9c1e-2b7d-8e4a-9f15-6c0d2b8e7a41",
                      "promotion_id": "660e8400-e29b-41d4-a716-446655440001",
                      "quantity": 3,
                      "codes": [
                        {
                          "code": "SUMMERA7KQ9",
                          "uses_per_code": 1
                        },
                        {
                          "code": "SUMMERM2TX4",
                          "uses_per_code": 1
                        },
                        {
                          "code": "SUMMERP8W6R",
                          "uses_per_code": 1
                        }
                      ]
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "400. Los encabezados, la ruta o el cuerpo no son válidos (`INVALID_PARAMETERS`), o falló una regla del lote (`INVALID_REQUEST`, con un mensaje `path: RULE` por cada ruta que falló).",
            "content": {
              "application/json": {
                "examples": {
                  "No X-Account-Code": {
                    "summary": "No X-Account-Code header",
                    "value": {
                      "code": "INVALID_PARAMETERS",
                      "messages": [
                        "x-account-code header is required."
                      ]
                    }
                  },
                  "No X-Idempotency-Key": {
                    "summary": "No X-Idempotency-Key header",
                    "value": {
                      "code": "INVALID_PARAMETERS",
                      "messages": [
                        "The header 'X-Idempotency-Key' is required and must not exceed 64 characters."
                      ]
                    }
                  },
                  "account_id in the body": {
                    "summary": "account_id in the body",
                    "value": {
                      "code": "INVALID_PARAMETERS",
                      "messages": [
                        "The field 'account_id' is not accepted in the body: the promotion belongs to the account of the x-account-code header."
                      ]
                    }
                  },
                  "Quantity out of range": {
                    "summary": "quantity is 0 or more than 1000",
                    "value": {
                      "code": "INVALID_REQUEST",
                      "messages": [
                        "quantity: RANGE"
                      ]
                    }
                  },
                  "No prefix": {
                    "summary": "No prefix",
                    "value": {
                      "code": "INVALID_REQUEST",
                      "messages": [
                        "prefix: REQUIRED"
                      ]
                    }
                  },
                  "Prefix with a bad character": {
                    "summary": "A prefix character outside A-Z and 0-9",
                    "value": {
                      "code": "INVALID_REQUEST",
                      "messages": [
                        "prefix: FORMAT"
                      ]
                    }
                  },
                  "Prefix too long": {
                    "summary": "A prefix of more than 8 characters",
                    "value": {
                      "code": "INVALID_REQUEST",
                      "messages": [
                        "prefix: LENGTH"
                      ]
                    }
                  },
                  "uses_per_code out of range": {
                    "summary": "uses_per_code is 0 or more than 1000000",
                    "value": {
                      "code": "INVALID_REQUEST",
                      "messages": [
                        "uses_per_code: RANGE"
                      ]
                    }
                  },
                  "A code in the body": {
                    "summary": "A full code in the body",
                    "value": {
                      "code": "INVALID_REQUEST",
                      "messages": [
                        "code: NOT_ALLOWED"
                      ]
                    }
                  }
                },
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "string"
                    },
                    "messages": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "401. Faltan las credenciales o no son válidas.",
            "content": {
              "application/json": {
                "examples": {
                  "Unauthorized": {
                    "value": {
                      "code": "INVALID_CREDENTIALS",
                      "messages": [
                        "Invalid Credentials"
                      ]
                    }
                  },
                  "Not authenticated": {
                    "value": {
                      "code": "NOT_AUTHENTICATED",
                      "messages": [
                        "Not authenticated"
                      ]
                    }
                  }
                },
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "string",
                      "example": "INVALID_CREDENTIALS"
                    },
                    "messages": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "404. Ninguna promoción de la cuenta tiene este id, o Promotions no está habilitado para tu organización. La respuesta de la compuerta tiene un `code` y no tiene `messages`.",
            "content": {
              "application/json": {
                "examples": {
                  "Promotion not on the account": {
                    "summary": "The promotion is not on the account",
                    "value": {
                      "code": "PROMOTION_NOT_FOUND",
                      "messages": [
                        "The promotion does not exist on the account."
                      ]
                    }
                  },
                  "Promotions not enabled": {
                    "value": {
                      "code": "PROMOTION_NOT_FOUND"
                    }
                  }
                },
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "string",
                      "example": "PROMOTION_NOT_FOUND"
                    },
                    "messages": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            }
          },
          "413": {
            "description": "413. El cuerpo supera los 256 KiB.",
            "content": {
              "application/json": {
                "examples": {
                  "Request too large": {
                    "value": {
                      "code": "REQUEST_ENTITY_TOO_LARGE",
                      "messages": [
                        "The request body must not exceed 256 KiB."
                      ]
                    }
                  }
                },
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "string",
                      "example": "REQUEST_ENTITY_TOO_LARGE"
                    },
                    "messages": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            }
          },
          "422": {
            "description": "422. La promoción no puede contener el lote: `PROMOTION_NOT_APPLICABLE`, con el `reason`. Yuno no almacena nada.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "string",
                      "example": "PROMOTION_NOT_APPLICABLE"
                    },
                    "reason": {
                      "type": "string",
                      "enum": [
                        "NOT_CODE_PROMOTION",
                        "DISABLED",
                        "EXPIRED",
                        "BATCH_LIMIT_REACHED"
                      ]
                    },
                    "messages": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  }
                },
                "examples": {
                  "Not a code promotion": {
                    "summary": "An AUTOMATIC promotion has no code",
                    "value": {
                      "code": "PROMOTION_NOT_APPLICABLE",
                      "reason": "NOT_CODE_PROMOTION",
                      "messages": [
                        "Only a promotion with a code can hold batch codes."
                      ]
                    }
                  },
                  "Disabled": {
                    "summary": "The promotion is disabled",
                    "value": {
                      "code": "PROMOTION_NOT_APPLICABLE",
                      "reason": "DISABLED",
                      "messages": [
                        "The promotion is disabled."
                      ]
                    }
                  },
                  "Expired": {
                    "summary": "The promotion ended",
                    "value": {
                      "code": "PROMOTION_NOT_APPLICABLE",
                      "reason": "EXPIRED",
                      "messages": [
                        "The promotion expired."
                      ]
                    }
                  },
                  "Batch limit reached": {
                    "summary": "The batch would pass 10,000 codes",
                    "value": {
                      "code": "PROMOTION_NOT_APPLICABLE",
                      "reason": "BATCH_LIMIT_REACHED",
                      "messages": [
                        "The promotion cannot hold more than 10000 batch codes."
                      ]
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "500. Falló el servicio de promociones, o Yuno no pudo generar suficientes códigos libres para el lote. Yuno no almacena nada: reintenta la solicitud.",
            "content": {
              "application/json": {
                "examples": {
                  "Internal error": {
                    "summary": "Internal error",
                    "value": {
                      "code": "INTERNAL_ERROR",
                      "messages": [
                        "Internal error"
                      ]
                    }
                  }
                },
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "string"
                    },
                    "messages": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            }
          },
          "503": {
            "description": "503. El servicio de promociones no está configurado o no está disponible.",
            "content": {
              "application/json": {
                "examples": {
                  "Service unavailable": {
                    "value": {
                      "code": "PROMOTION_ENGINE_UNAVAILABLE",
                      "messages": [
                        "The promotions service is unavailable."
                      ]
                    }
                  },
                  "Store unavailable": {
                    "value": {
                      "code": "STORE_UNAVAILABLE",
                      "messages": [
                        "The store is unavailable."
                      ]
                    }
                  }
                },
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "string",
                      "example": "PROMOTION_ENGINE_UNAVAILABLE"
                    },
                    "messages": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            }
          },
          "504": {
            "description": "504. El servicio de promociones no respondió a tiempo.",
            "content": {
              "application/json": {
                "examples": {
                  "Gateway timeout": {
                    "value": {
                      "code": "PROMOTION_ENGINE_TIMEOUT",
                      "messages": [
                        "The promotions service did not answer in time."
                      ]
                    }
                  }
                },
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "string",
                      "example": "PROMOTION_ENGINE_TIMEOUT"
                    },
                    "messages": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
