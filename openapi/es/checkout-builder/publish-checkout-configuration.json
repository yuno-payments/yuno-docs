{
  "openapi": "3.1.0",
  "info": {
    "title": "checkout-builder",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://api-sandbox.y.uno/v1",
      "description": "Sandbox"
    },
    {
      "url": "https://api.y.uno/v1",
      "description": "Production (US)"
    }
  ],
  "components": {
    "securitySchemes": {
      "publicApiKey": {
        "type": "apiKey",
        "in": "header",
        "name": "PUBLIC-API-KEY",
        "description": "Clave de API pública del comercio. Se encuentra en el Dashboard de Yuno → Settings → API Keys."
      },
      "privateSecretKey": {
        "type": "apiKey",
        "in": "header",
        "name": "PRIVATE-SECRET-KEY",
        "description": "Clave secreta privada del comercio, asociada a la clave pública. Nunca la incluyas en código del lado del cliente."
      },
      "accountCode": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Account-Code",
        "description": "UUID del ámbito de la cuenta del comercio para la solicitud. El tenant se resuelve únicamente a partir de este encabezado."
      }
    }
  },
  "security": [
    {
      "publicApiKey": [],
      "privateSecretKey": [],
      "accountCode": []
    }
  ],
  "paths": {
    "/checkouts/{checkout_code}": {
      "put": {
        "summary": "Publish Checkout Configuration",
        "description": "Escribe la configuración y/o los estilos del checkout en una sola llamada. El cuerpo puede contener un objeto `config`, un objeto `styling` o ambos; se requiere al menos uno. Cuando el cuerpo incluye `config`, también se requiere `name`. Cada parte se valida de forma independiente antes de aplicarse; si alguna regla falla, la solicitud se rechaza con un único 400 agregado y no se aplica nada. La configuración es un upsert parcial (los métodos de pago omitidos conservan su estado anterior; no se pueden crear métodos nuevos). Los estilos son una combinación parcial (los campos omitidos o nulos se conservan).",
        "operationId": "publish-checkout-configuration",
        "parameters": [
          {
            "name": "checkout_code",
            "in": "path",
            "description": "El identificador único del checkout que se va a actualizar (UUID, 36 caracteres). Los valores que no son UUID se rechazan con 400 antes de procesarse.",
            "schema": {
              "type": "string"
            },
            "required": true
          },
          {
            "name": "X-Idempotency-Key",
            "in": "header",
            "description": "UUID generado por el cliente. Reenviar la misma solicitud con la misma clave es seguro y no publicará dos veces.",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "examples": {
                "Configuration and styling": {
                  "value": {
                    "name": "Main Checkout",
                    "config": {
                      "payment_methods": [
                        {
                          "payment_method_type": "CARD",
                          "type": "PAYMENT_METHOD",
                          "order_to_show": 0,
                          "is_active": true,
                          "active_enrollment_type": "BOTH",
                          "conditions_to_override": [],
                          "required_fields_to_override": {
                            "is_active": true,
                            "fields": [
                              {
                                "field_name": "security_code",
                                "is_active": true,
                                "current_value": "ALWAYS",
                                "conditions_to_override": [
                                  {
                                    "name": "BR only",
                                    "is_active": true,
                                    "priority": 1,
                                    "conditions": [
                                      {
                                        "condition_type": "COUNTRY",
                                        "conditional": "ONE_OF",
                                        "values": [
                                          "BR"
                                        ]
                                      }
                                    ]
                                  }
                                ]
                              }
                            ],
                            "enrollment_fields": [],
                            "is_enrollment_active": true
                          }
                        }
                      ],
                      "general_settings": {
                        "country_documents": [
                          {
                            "country_code": "BR",
                            "documents": [
                              "CPF",
                              "CNPJ"
                            ]
                          }
                        ]
                      }
                    },
                    "styling": {
                      "styles": {
                        "global": {
                          "accent_color": "#1A73E8",
                          "primary_background_color": "#FFFFFF",
                          "font_family": "Inter"
                        },
                        "header": {
                          "logo": "https://cdn.example.com/logo.png",
                          "font_weight": 600
                        },
                        "button": {
                          "corner_radius": 8,
                          "font_weight": 500
                        }
                      },
                      "flags": {
                        "force_default_styles": false
                      }
                    }
                  }
                },
                "Hide a field on the card form": {
                  "value": {
                    "name": "My Checkout",
                    "config": {
                      "payment_methods": [
                        {
                          "payment_method_type": "CARD",
                          "type": "PAYMENT_METHOD",
                          "order_to_show": 1,
                          "is_active": true,
                          "active_enrollment_type": "BOTH",
                          "required_fields_to_override": {
                            "is_active": true,
                            "fields": [
                              {
                                "field_name": "phone",
                                "is_active": false
                              }
                            ]
                          }
                        }
                      ]
                    }
                  }
                }
              },
              "schema": {
                "type": "object",
                "description": "Se requiere al menos uno de `config` o `styling`. `name` es obligatorio cuando se envía `config`.",
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 50,
                    "description": "Nombre de la configuración del checkout (de 1 a 50 caracteres). Obligatorio cuando el cuerpo incluye `config`; una solicitud con `config` y sin `name` devuelve 400 `name must not be blank`. Una solicitud solo de estilos no lo necesita. El valor reemplaza el nombre actual del checkout, así que envía el nombre actual para conservarlo.",
                    "example": "Main checkout"
                  },
                  "config": {
                    "type": "object",
                    "description": "Configuración del checkout: métodos de pago y configuración general. Upsert parcial; los métodos de pago omitidos conservan su estado anterior.",
                    "properties": {
                      "payment_methods": {
                        "type": "array",
                        "description": "Métodos de pago que se actualizarán. El orden lo determina `order_to_show` (menor = primero).",
                        "items": {
                          "type": "object",
                          "properties": {
                            "payment_method_type": {
                              "type": "string",
                              "description": "Tipo de método de pago, p. ej., CARD, PAYPAL, NU_PAY, GOOGLE_PAY.",
                              "example": "CARD"
                            },
                            "type": {
                              "type": "string",
                              "enum": [
                                "PAYMENT_METHOD",
                                "ENROLLMENT"
                              ],
                              "description": "Qué fila almacenada actualiza esta entrada para el `payment_method_type` indicado: el flujo de pago único (`PAYMENT_METHOD`) o el flujo de inscripción/tarjeta guardada (`ENROLLMENT`). La fila existente se busca por este campo; si se omite, ninguna fila coincide, por lo que `fields` se ignora en silencio (la solicitud igualmente devuelve 200, pero el formulario de tarjeta sin inscripción no cambia). `enrollment_fields` sigue aplicándose cuando el método de pago ya tiene una fila de inscripción almacenada."
                            },
                            "order_to_show": {
                              "type": "integer",
                              "description": "Orden de visualización (>= 0). El menor se muestra primero.",
                              "example": 0
                            },
                            "is_active": {
                              "type": "boolean",
                              "description": "Indica si el método se ofrece.",
                              "example": true
                            },
                            "active_enrollment_type": {
                              "type": "string",
                              "enum": [
                                "ENROLLMENT",
                                "NO_ENROLLMENT",
                                "BOTH",
                                "NONE"
                              ],
                              "description": "Postura de inscripción para el método."
                            },
                            "conditions_to_override": {
                              "type": "array",
                              "description": "Conjuntos de condiciones a nivel de método de pago que determinan cuándo aparece el método. Se conserva el `code` (UUID) del conjunto enviado por el cliente.",
                              "items": {
                                "type": "object"
                              }
                            },
                            "required_fields_to_override": {
                              "type": "object",
                              "description": "Configuración por campo. `fields` = flujo sin inscripción; `enrollment_fields` = flujo con inscripción (tarjeta guardada). Como máximo un conjunto de condiciones por campo (un segundo se rechaza con 400).",
                              "properties": {
                                "is_active": {
                                  "type": "boolean"
                                },
                                "fields": {
                                  "type": "array",
                                  "description": "Reemplazos por campo para el flujo sin inscripción (pago único).",
                                  "items": {
                                    "type": "object",
                                    "properties": {
                                      "field_name": {
                                        "type": "string",
                                        "description": "El campo del formulario que se reemplazará, p. ej., `phone`, `security_code`.",
                                        "example": "phone"
                                      },
                                      "is_active": {
                                        "type": "boolean",
                                        "description": "Indica si el campo se muestra/es obligatorio en el formulario. Es el interruptor de encendido/apagado del campo: define `false` para ocultarlo.",
                                        "example": false
                                      },
                                      "current_value": {
                                        "type": "string",
                                        "enum": [
                                          "ALWAYS",
                                          "FIRST_TIME",
                                          "NONE"
                                        ],
                                        "description": "Un valor fijo que se aplica en lugar de dejar que el pagador ingrese uno. Solo tiene sentido para `security_code`. `NONE` devuelve 400 en el flujo CARD sin inscripción. No está relacionado con `is_active`.",
                                        "example": "ALWAYS"
                                      },
                                      "conditions_to_override": {
                                        "type": "array",
                                        "description": "Condiciones que determinan cuándo se aplica este reemplazo de campo, p. ej., por país. Como máximo un conjunto de condiciones por campo; un segundo se rechaza con 400.",
                                        "items": {
                                          "type": "object"
                                        }
                                      }
                                    },
                                    "required": [
                                      "field_name",
                                      "is_active"
                                    ]
                                  }
                                },
                                "enrollment_fields": {
                                  "type": "array",
                                  "description": "Reemplazos por campo para el flujo con inscripción (tarjeta guardada). Misma estructura que `fields`.",
                                  "items": {
                                    "type": "object",
                                    "properties": {
                                      "field_name": {
                                        "type": "string",
                                        "description": "El campo del formulario que se reemplazará, p. ej., `phone`, `security_code`.",
                                        "example": "phone"
                                      },
                                      "is_active": {
                                        "type": "boolean",
                                        "description": "Indica si el campo se muestra/es obligatorio en el formulario. Es el interruptor de encendido/apagado del campo: define `false` para ocultarlo.",
                                        "example": false
                                      },
                                      "current_value": {
                                        "type": "string",
                                        "enum": [
                                          "ALWAYS",
                                          "FIRST_TIME",
                                          "NONE"
                                        ],
                                        "description": "Un valor fijo que se aplica en lugar de dejar que el pagador ingrese uno. Solo tiene sentido para `security_code`. `NONE` devuelve 400 en el flujo CARD sin inscripción. No está relacionado con `is_active`.",
                                        "example": "ALWAYS"
                                      },
                                      "conditions_to_override": {
                                        "type": "array",
                                        "description": "Condiciones que determinan cuándo se aplica este reemplazo de campo, p. ej., por país. Como máximo un conjunto de condiciones por campo; un segundo se rechaza con 400.",
                                        "items": {
                                          "type": "object"
                                        }
                                      }
                                    },
                                    "required": [
                                      "field_name",
                                      "is_active"
                                    ]
                                  }
                                },
                                "is_enrollment_active": {
                                  "type": "boolean"
                                }
                              }
                            }
                          }
                        }
                      },
                      "general_settings": {
                        "type": "object",
                        "properties": {
                          "country_documents": {
                            "type": "array",
                            "items": {
                              "type": "object",
                              "properties": {
                                "country_code": {
                                  "type": "string",
                                  "description": "Código de país ISO 3166-1 alpha-2.",
                                  "example": "BR"
                                },
                                "documents": {
                                  "type": "array",
                                  "items": {
                                    "type": "string"
                                  },
                                  "example": [
                                    "CPF",
                                    "CNPJ"
                                  ]
                                }
                              }
                            }
                          }
                        }
                      }
                    }
                  },
                  "styling": {
                    "type": "object",
                    "description": "Estilos del checkout y configuración del SDK. Combinación parcial; los campos omitidos o nulos se conservan; usa `flags.force_default_styles` para restablecer. `settings.urls`, `settings.click_to_pay`, `settings.form` y `settings.google_pay` están bloqueados en la beta y se rechazan si se envían con un valor no vacío.",
                    "properties": {
                      "styles": {
                        "type": "object",
                        "description": "Estilos globales, de encabezado y de botón. Todos los campos `*_color` deben ser un color hexadecimal de 6 u 8 dígitos (#RRGGBB / #RRGGBBAA); `font_weight` debe ser uno de 100..900 (de 100 en 100); `font_family` debe estar en el catálogo admitido o declararse en `external_fonts`. Los logotipos deben ser una URL HTTPS a un host público o una ruta relativa (sin data:/SVG/javascript:)."
                      },
                      "settings": {
                        "type": "object",
                        "description": "Configuración del SDK, que se reenvía al SDK del checkout. `settings.urls`, `settings.click_to_pay`, `settings.form` y `settings.google_pay` están bloqueados en la beta y se rechazan si se envían con un valor no vacío.",
                        "properties": {
                          "card": {
                            "type": "object",
                            "description": "Configuración del SDK de tarjetas.",
                            "properties": {
                              "save_on_success": {
                                "type": "boolean",
                                "description": "Ofrece guardar la tarjeta para pagos futuros."
                              },
                              "visualization_mode": {
                                "type": "string",
                                "description": "Modo de visualización del formulario de tarjeta."
                              },
                              "enable_ocr": {
                                "type": "boolean",
                                "description": "Habilita el escaneo de tarjetas (OCR)."
                              },
                              "credit_card_only_processing": {
                                "type": "boolean",
                                "description": "Procesa solo tarjetas de crédito."
                              },
                              "enable_payment_retry": {
                                "type": "boolean",
                                "description": "Permite reintentar un pago con tarjeta rechazado."
                              },
                              "default_network": {
                                "type": "string",
                                "description": "Red de tarjetas predeterminada: DOM o INT."
                              }
                            }
                          },
                          "sdk_type": {
                            "type": "object"
                          },
                          "web_sdk": {
                            "type": "object"
                          },
                          "payment_method_list": {
                            "type": "object"
                          },
                          "ui": {
                            "type": "object"
                          }
                        }
                      },
                      "flags": {
                        "type": "object",
                        "properties": {
                          "force_default_styles": {
                            "type": "boolean"
                          }
                        }
                      },
                      "external_fonts": {
                        "type": "array",
                        "description": "Fuentes personalizadas. `files[].url` debe ser una URL HTTPS a un host público.",
                        "items": {
                          "type": "object"
                        }
                      },
                      "payment_link_styles": {
                        "type": "object"
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Resumen del checkout actualizado. La configuración y los estilos no se devuelven en esta respuesta; consúltalos con [Fetch checkout configuration](/es/reference/checkout-builder/fetch-checkout-configuration). Su identificador se expone como el `id` de nivel superior.",
            "content": {
              "application/json": {
                "examples": {
                  "Success": {
                    "value": {
                      "id": "8005ca91-dcfb-4428-b9f6-49c6e3446474",
                      "name": "Main Checkout",
                      "description": "Default checkout",
                      "is_default": true,
                      "is_active": true,
                      "created_at": "2026-10-22T03:16:36Z"
                    }
                  }
                },
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "example": "8005ca91-dcfb-4428-b9f6-49c6e3446474"
                    },
                    "name": {
                      "type": "string",
                      "example": "Main Checkout"
                    },
                    "description": {
                      "type": "string",
                      "example": "Default checkout"
                    },
                    "is_default": {
                      "type": "boolean",
                      "example": true
                    },
                    "is_active": {
                      "type": "boolean",
                      "example": true
                    },
                    "created_at": {
                      "type": "string",
                      "example": "2026-10-22T03:16:36Z"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "La validación falló. Todas las infracciones se agrupan en una sola respuesta. Un cuerpo JSON con formato incorrecto también devuelve 400.",
            "content": {
              "application/json": {
                "examples": {
                  "Invalid parameters": {
                    "value": {
                      "code": "INVALID_PARAMETERS",
                      "messages": [
                        "payment_methods[0].order_to_show must be >= 0",
                        "styles.global.accent_color must be a 6- or 8-digit hex color (#RRGGBB or #RRGGBBAA)"
                      ]
                    }
                  }
                },
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "string",
                      "example": "INVALID_PARAMETERS"
                    },
                    "messages": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "No autenticado, o la cuenta no está en la lista de acceso permitido de la beta.",
            "content": {
              "application/json": {
                "examples": {
                  "Unauthorized": {
                    "value": {
                      "code": "NOT_AUTHENTICATED",
                      "messages": [
                        "Not authenticated"
                      ]
                    }
                  }
                },
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "string",
                      "example": "NOT_AUTHENTICATED"
                    },
                    "messages": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "No se encontró el checkout para esta cuenta.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "string"
                    },
                    "messages": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "deprecated": false
      }
    }
  }
}
