{
  "openapi": "3.1.0",
  "info": {
    "title": "checkout-builder",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://api-sandbox.y.uno/v1",
      "description": "Sandbox"
    },
    {
      "url": "https://api.y.uno/v1",
      "description": "Production (US)"
    }
  ],
  "components": {
    "securitySchemes": {
      "publicApiKey": {
        "type": "apiKey",
        "in": "header",
        "name": "PUBLIC-API-KEY",
        "description": "Clave de API pública del comercio. Se encuentra en el Dashboard de Yuno → Settings → API Keys."
      },
      "privateSecretKey": {
        "type": "apiKey",
        "in": "header",
        "name": "PRIVATE-SECRET-KEY",
        "description": "Clave secreta privada del comercio, asociada a la clave pública. Nunca la incluyas en código del lado del cliente."
      },
      "accountCode": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Account-Code",
        "description": "UUID del ámbito de la cuenta del comercio para la solicitud. El tenant se resuelve únicamente a partir de este encabezado."
      }
    }
  },
  "security": [
    {
      "publicApiKey": [],
      "privateSecretKey": [],
      "accountCode": []
    }
  ],
  "paths": {
    "/checkouts/{checkout_code}": {
      "get": {
        "summary": "Fetch Checkout Configuration",
        "description": "Devuelve el checkout personalizado completo para el código indicado: configuración y estilos combinados en una sola respuesta. El identificador del checkout se expone como el `id` de nivel superior.",
        "operationId": "get-checkout-configuration",
        "parameters": [
          {
            "name": "checkout_code",
            "in": "path",
            "description": "El identificador único del checkout que se va a consultar (UUID, 36 caracteres). Los valores que no son UUID se rechazan con 400 antes de procesarse.",
            "schema": {
              "type": "string"
            },
            "required": true
          }
        ],
        "responses": {
          "200": {
            "description": "El checkout personalizado, con la configuración y los estilos combinados.",
            "content": {
              "application/json": {
                "examples": {
                  "Success": {
                    "value": {
                      "id": "8005ca91-dcfb-4428-b9f6-49c6e3446474",
                      "name": "Main Checkout",
                      "description": "",
                      "status": "PUBLISHED",
                      "is_default": true,
                      "created_at": "2026-01-01T00:00:00Z",
                      "updated_at": "2026-05-18T13:06:08Z",
                      "config": {
                        "payment_methods": [
                          {
                            "payment_method_type": "CARD",
                            "name": "Card",
                            "description": "Card",
                            "icon": "https://sdk.prod.y.uno/brands/card_logosimbolo.png",
                            "category": "CARD",
                            "short_name": "Card",
                            "hint": "",
                            "order_to_show": 1,
                            "is_active": true,
                            "type": "PAYMENT_METHOD",
                            "has_enrollment": true,
                            "conditions_quantity": 1,
                            "active_enrollment_type": "BOTH"
                          }
                        ],
                        "general_settings": {
                          "country_documents": [
                            {
                              "country_code": "AR",
                              "documents": [
                                "DNI",
                                "CUIT"
                              ]
                            }
                          ]
                        },
                        "feature_flags": {
                          "custom_required_fields": true,
                          "custom_logo_icon": true
                        }
                      },
                      "styling": {
                        "styles": {
                          "global": {
                            "accent_color": "#282A30",
                            "primary_background_color": "#FFFFFF",
                            "primary_text_color": "#282A30",
                            "primary_button_text_color": "#FFFFFF",
                            "secondary_background_color": "#ECEFF2",
                            "secondary_text_color": "#84807F",
                            "secondary_button_background_color": "#FFFFFF",
                            "secondary_button_text_color": "#282A30",
                            "font_family": "Inter"
                          },
                          "header": {
                            "logo_border_size": 0,
                            "logo_border_color": "#282A30",
                            "logo_corner_radius": 8,
                            "font_size": 18,
                            "font_weight": 700
                          },
                          "button": {
                            "corner_radius": 8,
                            "border_size": 0,
                            "primary_border_color": "#282A30",
                            "secondary_border_color": "#282A30",
                            "font_size": 18,
                            "font_weight": 400
                          }
                        },
                        "settings": {
                          "sdk_type": {
                            "web": "SEAMLESS",
                            "mobile": "SEAMLESS"
                          },
                          "card": {
                            "save_on_success": true,
                            "visualization_mode": "ONE_STEP",
                            "enable_ocr": false,
                            "credit_card_only_processing": false,
                            "default_network": "DOM"
                          },
                          "web_sdk": {
                            "render_mode": "MODAL",
                            "hide_pay_button": false
                          },
                          "payment_method_list": {
                            "unfolded_display": false,
                            "preselected_payment_method": false,
                            "condensed_checkout_view": false,
                            "edit_payment_method_list": false
                          },
                          "ui": {
                            "dark_mode": false,
                            "show_secure_payment_tag": true
                          },
                          "payment_link": {
                            "show_result_screen": false
                          }
                        },
                        "external_fonts": [
                          {
                            "family_name": "Inter",
                            "files": [
                              {
                                "weight": 400,
                                "url": "https://staging.y.uno/sdk-static-bundles-ms/v1/static/fonts/Inter-Regular.ttf"
                              }
                            ]
                          }
                        ],
                        "payment_link_styles": {
                          "panel": {
                            "left": {
                              "background": {
                                "color": "#ECEFF2"
                              },
                              "logo": "data:image/jpeg;base64,..."
                            }
                          },
                          "checkbox": {
                            "color": "#282A30"
                          },
                          "border": {
                            "color": "#282A30"
                          },
                          "radio_button": {
                            "color": "#282A30"
                          },
                          "button": {
                            "text": {
                              "color": "#876E6E"
                            },
                            "background": {
                              "color": "#282A30"
                            }
                          },
                          "published_at": "2026-05-14T19:34:06Z"
                        }
                      }
                    }
                  }
                },
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "description": "UUID del checkout (el checkout_code).",
                      "example": "8005ca91-dcfb-4428-b9f6-49c6e3446474"
                    },
                    "name": {
                      "type": "string",
                      "description": "Nombre del checkout.",
                      "example": "Main Checkout"
                    },
                    "description": {
                      "type": "string",
                      "description": "Descripción del checkout."
                    },
                    "status": {
                      "type": "string",
                      "description": "Estado del checkout.",
                      "example": "PUBLISHED"
                    },
                    "is_default": {
                      "type": "boolean",
                      "description": "Indica si este es el checkout predeterminado de la cuenta.",
                      "example": true
                    },
                    "created_at": {
                      "type": "string",
                      "description": "Marca de tiempo de creación (ISO 8601)."
                    },
                    "updated_at": {
                      "type": "string",
                      "description": "Marca de tiempo de la última actualización (ISO 8601)."
                    },
                    "config": {
                      "type": "object",
                      "description": "Configuración del checkout.",
                      "properties": {
                        "payment_methods": {
                          "type": "array",
                          "description": "Métodos de pago configurados para este checkout. El orden lo determina `order_to_show` (menor = primero). Devuelve el catálogo completo de métodos de pago disponibles para la cuenta, no solo los activos en este checkout. Filtra por `is_active: true` para obtener únicamente los habilitados.",
                          "items": {
                            "type": "object"
                          }
                        },
                        "general_settings": {
                          "type": "object",
                          "description": "Configuración general del checkout, incluidos los tipos de documento aceptados por país (`country_documents`)."
                        },
                        "feature_flags": {
                          "type": "object",
                          "description": "Interruptores de funcionalidades de este checkout, incluidos `custom_required_fields` y `custom_logo_icon`."
                        }
                      }
                    },
                    "styling": {
                      "type": "object",
                      "description": "Estilos del checkout y configuración del SDK: `styles`, `settings`, `external_fonts`, `payment_link_styles`."
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "`checkout_code` no es un UUID válido.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "string",
                      "example": "INVALID_PARAMETERS"
                    },
                    "messages": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "No autenticado, o la cuenta no está en la lista de acceso permitido de la beta.",
            "content": {
              "application/json": {
                "examples": {
                  "Unauthorized": {
                    "value": {
                      "code": "NOT_AUTHENTICATED",
                      "messages": [
                        "Not authenticated"
                      ]
                    }
                  }
                },
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "string",
                      "example": "NOT_AUTHENTICATED"
                    },
                    "messages": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "No se encontró el checkout para esta cuenta.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "string"
                    },
                    "messages": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "deprecated": false
      }
    }
  }
}
