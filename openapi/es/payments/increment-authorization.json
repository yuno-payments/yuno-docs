{
  "openapi": "3.1.0",
  "info": {
    "title": "payment-api-increment-authorization",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://api-sandbox.y.uno/v1",
      "description": "Sandbox"
    },
    {
      "url": "https://api.y.uno/v1",
      "description": "Production (US)"
    }
  ],
  "components": {
    "securitySchemes": {
      "sec0": {
        "type": "apiKey",
        "in": "header",
        "x-default": "<Your public-api-key>",
        "name": "public-api-key"
      },
      "sec1": {
        "type": "apiKey",
        "in": "header",
        "x-default": "<Your private-secret-key>",
        "name": "private-secret-key"
      },
      "sec2": {
        "type": "apiKey",
        "in": "header",
        "x-default": "<Your X-Idempotency-Key>",
        "name": "X-Idempotency-Key"
      }
    }
  },
  "security": [
    {
      "sec0": [],
      "sec1": [],
      "sec2": []
    }
  ],
  "paths": {
    "/payments/{payment_id}/transactions/{transaction_id}/increment": {
      "post": {
        "summary": "Incrementar autorización",
        "description": "Aumenta una retención de autorización existente en un monto delta. Cada incremento crea su propia transacción `AUTHORIZE_INCREMENT` con un resultado por incremento.",
        "operationId": "increment-authorization",
        "parameters": [
          {
            "name": "payment_id",
            "in": "path",
            "description": "El identificador único del pago (UUID, 36 caracteres).",
            "schema": {
              "type": "string"
            },
            "required": true
          },
          {
            "name": "transaction_id",
            "in": "path",
            "description": "El identificador único de la transacción AUTHORIZE original que se va a incrementar (UUID, 36 caracteres).",
            "schema": {
              "type": "string"
            },
            "required": true
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "amount",
                  "merchant_reference"
                ],
                "properties": {
                  "amount": {
                    "type": "object",
                    "description": "El monto que se SUMA al monto autorizado actual (un delta, no el nuevo total). La moneda debe coincidir con la de la autorización original.",
                    "required": [
                      "value",
                      "currency"
                    ],
                    "properties": {
                      "value": {
                        "type": "number",
                        "description": "El delta que se suma al monto autorizado actual.",
                        "example": 50.0
                      },
                      "currency": {
                        "type": "string",
                        "description": "Código de moneda ISO 4217 de tres letras. Debe coincidir con el de la autorización original.",
                        "example": "EUR"
                      }
                    }
                  },
                  "merchant_reference": {
                    "type": "string",
                    "description": "La referencia de este incremento."
                  },
                  "description": {
                    "type": "string",
                    "description": "Descripción opcional del incremento."
                  }
                }
              },
              "examples": {
                "Increment by 50": {
                  "value": {
                    "amount": {
                      "value": 50.0,
                      "currency": "EUR"
                    },
                    "merchant_reference": "session-8842-inc-2",
                    "description": "EV charging session top-up"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "201",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "description": "Identificador único de la transacción de incremento (UUID)."
                    },
                    "type": {
                      "type": "string",
                      "description": "Tipo de transacción.",
                      "example": "AUTHORIZE_INCREMENT"
                    },
                    "status": {
                      "type": "string",
                      "enum": [
                        "SUCCEEDED",
                        "DECLINED",
                        "PENDING",
                        "ERROR"
                      ],
                      "description": "Resultado por incremento. `SUCCEEDED`: la retención se aumentó. `DECLINED`: el emisor o el proveedor rechazó este incremento; el monto autorizado anterior se mantiene. `PENDING`: el proveedor procesa los incrementos de forma asíncrona; el resultado final se entrega por webhook. `ERROR`: no se pudo procesar el incremento."
                    },
                    "amount": {
                      "type": "object",
                      "description": "El delta sumado por este incremento.",
                      "properties": {
                        "value": {
                          "type": "number",
                          "example": 50.0
                        },
                        "currency": {
                          "type": "string",
                          "example": "EUR"
                        }
                      }
                    },
                    "merchant_reference": {
                      "type": "string",
                      "description": "La referencia enviada en la solicitud."
                    },
                    "parent_transaction_id": {
                      "type": "string",
                      "description": "El `transaction_id` de la transacción AUTHORIZE original a la que pertenece este incremento."
                    },
                    "response_code": {
                      "type": "string",
                      "description": "Código de respuesta de Yuno para este incremento: el subestado de la transacción cuando el proveedor devuelve uno; de lo contrario, el estado de la transacción (por ejemplo `SUCCEEDED`, `PENDING_PROVIDER_CONFIRMATION`, `AUTHORIZATION_NOT_INCREMENTABLE`). No es un código de emisor ISO 8583. `AUTHORIZATION_NOT_INCREMENTABLE` indica que el proveedor rechazó el incremento, ya sea porque la autorización original no se creó como `PRE_AUTHORIZATION` o porque se superaron los límites de incremento del proveedor (por ejemplo, más de 10 incrementos o un total superior a 5 veces el monto inicial en Revolut)."
                    },
                    "response_message": {
                      "type": "string",
                      "description": "Detalle legible del resultado."
                    },
                    "provider_data": {
                      "type": "object",
                      "description": "Identificadores y estado sin procesar del proveedor para este incremento."
                    },
                    "payment": {
                      "type": "object",
                      "description": "El pago principal después de este incremento.",
                      "properties": {
                        "id": {
                          "type": "string",
                          "description": "Identificador único del pago (UUID)."
                        },
                        "status": {
                          "type": "string",
                          "example": "AUTHORIZED"
                        },
                        "amount": {
                          "type": "object",
                          "description": "Montos del pago principal. Los incrementos no cambian `value`; aumentan `authorized`.",
                          "properties": {
                            "value": {
                              "type": "number",
                              "description": "El monto original del pago. Los incrementos no lo modifican.",
                              "example": 100.0
                            },
                            "authorized": {
                              "type": "number",
                              "description": "Monto autorizado total: la autorización original más todos los incrementos `SUCCEEDED`. Cuando el proveedor procesa los incrementos de forma asíncrona (Revolut), el incremento sigue en `PENDING` en esta respuesta, por lo que `authorized` aún no lo incluye; el total aumentado se refleja una vez que el incremento tiene éxito.",
                              "example": 150.0
                            },
                            "currency": {
                              "type": "string",
                              "example": "EUR"
                            }
                          }
                        }
                      }
                    }
                  }
                },
                "examples": {
                  "Approved Increment": {
                    "value": {
                      "id": "8f2f4bce-1d2f-4f6e-9a3b-0c1e5d3a7b21",
                      "type": "AUTHORIZE_INCREMENT",
                      "status": "SUCCEEDED",
                      "amount": {
                        "value": 50.0,
                        "currency": "EUR"
                      },
                      "merchant_reference": "session-8842-inc-2",
                      "parent_transaction_id": "1a71c7b7-80c2-4ba5-b601-4d34d48c0e18",
                      "response_code": "SUCCEEDED",
                      "response_message": "Approved",
                      "provider_data": {
                        "id": "prov-ref-001",
                        "status": "..."
                      },
                      "payment": {
                        "id": "d19205be-1a70-4c13-a4e6-8b7a9f3e2c11",
                        "status": "PENDING",
                        "sub_status": "AUTHORIZED",
                        "amount": {
                          "value": 100.0,
                          "authorized": 150.0,
                          "currency": "EUR"
                        }
                      }
                    }
                  },
                  "Pending Increment (async provider)": {
                    "value": {
                      "id": "8f2f4bce-1d2f-4f6e-9a3b-0c1e5d3a7b21",
                      "type": "AUTHORIZE_INCREMENT",
                      "status": "PENDING",
                      "amount": {
                        "value": 50.0,
                        "currency": "EUR"
                      },
                      "merchant_reference": "session-8842-inc-2",
                      "parent_transaction_id": "1a71c7b7-80c2-4ba5-b601-4d34d48c0e18",
                      "response_code": "PENDING_PROVIDER_CONFIRMATION",
                      "response_message": "Increment in progress; final result delivered via webhook",
                      "provider_data": {
                        "id": "prov-ref-001",
                        "status": "..."
                      },
                      "payment": {
                        "id": "d19205be-1a70-4c13-a4e6-8b7a9f3e2c11",
                        "status": "PENDING",
                        "sub_status": "AUTHORIZED",
                        "amount": {
                          "value": 100.0,
                          "authorized": 100.0,
                          "currency": "EUR"
                        }
                      }
                    }
                  },
                  "Declined Increment": {
                    "value": {
                      "id": "8f2f4bce-1d2f-4f6e-9a3b-0c1e5d3a7b21",
                      "type": "AUTHORIZE_INCREMENT",
                      "status": "DECLINED",
                      "amount": {
                        "value": 50.0,
                        "currency": "EUR"
                      },
                      "merchant_reference": "session-8842-inc-2",
                      "parent_transaction_id": "1a71c7b7-80c2-4ba5-b601-4d34d48c0e18",
                      "response_code": "DECLINED",
                      "response_message": "Insufficient funds",
                      "provider_data": {
                        "id": "prov-ref-001",
                        "status": "..."
                      },
                      "payment": {
                        "id": "d19205be-1a70-4c13-a4e6-8b7a9f3e2c11",
                        "status": "PENDING",
                        "sub_status": "AUTHORIZED",
                        "amount": {
                          "value": 100.0,
                          "authorized": 100.0,
                          "currency": "EUR"
                        }
                      }
                    }
                  },
                  "Not Incrementable": {
                    "value": {
                      "id": "8f2f4bce-1d2f-4f6e-9a3b-0c1e5d3a7b21",
                      "type": "AUTHORIZE_INCREMENT",
                      "status": "DECLINED",
                      "amount": {
                        "value": 50.0,
                        "currency": "EUR"
                      },
                      "merchant_reference": "session-8842-inc-2",
                      "parent_transaction_id": "1a71c7b7-80c2-4ba5-b601-4d34d48c0e18",
                      "response_code": "AUTHORIZATION_NOT_INCREMENTABLE",
                      "response_message": "The provider rejected the increment (not a pre-authorization, or the provider's increment limits were exceeded)",
                      "provider_data": {
                        "id": "prov-ref-001",
                        "status": "..."
                      },
                      "payment": {
                        "id": "d19205be-1a70-4c13-a4e6-8b7a9f3e2c11",
                        "status": "PENDING",
                        "sub_status": "AUTHORIZED",
                        "amount": {
                          "value": 100.0,
                          "authorized": 100.0,
                          "currency": "EUR"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "400",
            "content": {
              "application/json": {
                "examples": {
                  "Invalid request": {
                    "value": {
                      "code": "INVALID_REQUEST",
                      "messages": [
                        "Invalid request"
                      ]
                    }
                  },
                  "Payment or transaction not found": {
                    "value": {
                      "code": "TRANSACTION_NOT_FOUND",
                      "messages": [
                        "Payment or transaction not found"
                      ]
                    }
                  },
                  "Transaction not an active authorization": {
                    "value": {
                      "code": "INVALID_STATUS_WITH_FORMAT",
                      "messages": [
                        "The payment is not in an authorized hold state, the authorization is not SUCCEEDED (already captured, voided, or expired), or another increment is already in progress"
                      ]
                    }
                  },
                  "Currency mismatch": {
                    "value": {
                      "code": "INVALID_CURRENCY",
                      "messages": [
                        "Currency does not match the original authorization"
                      ]
                    }
                  },
                  "Target transaction is not an authorization": {
                    "value": {
                      "code": "INVALID_TRANSACTION_TYPE",
                      "messages": [
                        "The target transaction is not an AUTHORIZE transaction. Use the transaction_id of the original authorization, not a capture or purchase transaction."
                      ]
                    }
                  },
                  "Invalid amount": {
                    "value": {
                      "code": "INVALID_PARAMETERS",
                      "messages": [
                        "Invalid amount. The increment amount (delta) must be greater than zero."
                      ]
                    }
                  }
                },
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "string",
                      "example": "INVALID_REQUEST"
                    },
                    "messages": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "example": "Invalid request"
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "401",
            "content": {
              "application/json": {
                "examples": {
                  "Result": {
                    "value": {
                      "code": "UNAUTHORIZED",
                      "messages": [
                        "Invalid credentials"
                      ]
                    }
                  }
                },
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "string",
                      "example": "INVALID_REQUEST"
                    },
                    "messages": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "example": "Invalid request"
                      }
                    }
                  }
                }
              }
            }
          },
          "403": {
            "description": "403",
            "content": {
              "application/json": {
                "examples": {
                  "Result": {
                    "value": {
                      "code": "FORBIDDEN",
                      "messages": [
                        "Forbidden"
                      ]
                    }
                  }
                },
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "string",
                      "example": "INVALID_REQUEST"
                    },
                    "messages": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "example": "Invalid request"
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "deprecated": false
      }
    }
  },
  "x-readme": {
    "headers": [
      {
        "key": "charset",
        "value": "utf-8"
      }
    ],
    "explorer-enabled": true,
    "proxy-enabled": true
  }
}
