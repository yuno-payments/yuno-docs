                              "currency": "BRL",
                              "value": 200
                            },
                            "transactions": [
                              {
                                "id": "d2a4f6b8-1c3e-4a5b-8d7f-9e0a1b2c3d4e",
                                "type": "PURCHASE",
                                "status": "SUCCEEDED",
                                "category": "CARD",
                                "amount": 200,
                                "provider_id": "YUNO_TEST_PAYMENT_GATEWAY",
                                "response_code": "SUCCEEDED",
                                "response_message": "Transaction successful",
                                "reason": null,
                                "description": null,
                                "merchant_reference": null,
                                "three_d_secure_action_required": false,
                                "created_at": "2026-10-27T14:02:11.402Z",
                                "updated_at": "2026-10-27T14:02:12.118Z"
                              },
                              {
                                "id": "b6e8d0f2-5a7c-4e9f-8b1d-3c4d5e6f7a8b",
                                "type": "REFUND",
                                "status": "SUCCEEDED",
                                "category": "CARD",
                                "amount": 200,
                                "provider_id": "YUNO_TEST_PAYMENT_GATEWAY",
                                "response_code": "SUCCEEDED",
                                "response_message": "Transaction successful",
                                "reason": null,
                                "description": null,
                                "merchant_reference": null,
                                "three_d_secure_action_required": false,
                                "created_at": "2026-10-27T14:02:11.402Z",
                                "updated_at": "2026-10-27T14:02:12.118Z"
                              }
                            ]
                          },
                          {
                            "sequence": 2,
                            "type": "CARD",
                            "amount": {
                              "currency": "BRL",
                              "value": 100
                            },
                            "transactions": [
                              {
                                "id": "e3b5a7c9-2d4f-4b6c-9e8a-0f1b2c3d4e5f",
                                "type": "PURCHASE",
                                "status": "SUCCEEDED",
                                "category": "CARD",
                                "amount": 100,
                                "provider_id": "YUNO_TEST_PAYMENT_GATEWAY",
