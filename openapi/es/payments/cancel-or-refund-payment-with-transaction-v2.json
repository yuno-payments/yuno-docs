                      "payment_methods_count": 2,
                      "sdk_action_required": false,
                      "amount": {
                        "currency": "BRL",
                        "value": 300
                      },
                      "checkout": {
                        "session": null
                      },
                      "payment_method": {
                        "capture": true,
                        "account_updater": false,
                        "payment_methods": [
                          {
                            "sequence": 1,
                            "type": "CARD",
