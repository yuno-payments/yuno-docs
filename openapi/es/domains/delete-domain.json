{
  "openapi": "3.0.0",
  "info": {
    "version": "1.0.0",
    "title": "Domains"
  },
  "servers": [
    {
      "url": "https://api-sandbox.y.uno",
      "description": "Sandbox"
    },
    {
      "url": "https://api.y.uno",
      "description": "Production (US)"
    }
  ],
  "paths": {
    "/v1/payment-methods/{payment_method}/domains/{domain_id}": {
      "delete": {
        "description": "Anula el registro de un dominio ante el proveedor de la billetera y marca el registro como `INACTIVE`, lo que libera su lugar en la conexión. Úsalo para eliminar dominios que ya no utilizas antes de registrar otros nuevos. El dominio debe estar en estado `CREATED`, `REGISTERED` o `ERROR`. Un dominio eliminado no se puede restaurar: vuelve a registrarlo si lo necesitas de nuevo.",
        "operationId": "delete_v1-payment-methods-payment-method-domains-domain-id",
        "parameters": [
          {
            "in": "path",
            "name": "payment_method",
            "description": "Método de pago para el que se registró el dominio.",
            "schema": {
              "type": "string",
              "enum": [
                "APPLE_PAY",
                "GOOGLE_PAY"
              ]
            },
            "required": true
          },
          {
            "in": "path",
            "name": "domain_id",
            "description": "El `id` del registro del dominio (UUID), tal como lo devuelve Register domain.",
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "required": true
          }
        ],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "reason": {
                    "type": "string",
                    "maxLength": 255,
                    "description": "Motivo opcional en texto libre que se conserva para fines de auditoría. Por defecto es `Removed via API`."
                  }
                }
              },
              "examples": {
                "With reason": {
                  "summary": "With reason",
                  "value": {
                    "reason": "Seller no longer active"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Sin contenido: se anuló el registro del dominio (el cuerpo está vacío)."
          },
          "400": {
            "description": "Parámetros no válidos, o el dominio ya está `INACTIVE`.",
            "content": {
              "application/json": {
                "examples": {
                  "Already inactive": {
                    "summary": "Already inactive",
                    "value": {
                      "code": "CANNOT_UNREGISTER",
                      "messages": [
                        "domain is not in an active state"
                      ]
                    }
                  },
                  "Invalid parameters": {
                    "summary": "Invalid parameters",
                    "value": {
                      "code": "INVALID_PARAMETERS",
                      "messages": [
                        "domain_id must be a valid UUID"
                      ]
                    }
                  }
                },
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "No existe ningún dominio con ese `id` para tu organización.",
            "content": {
              "application/json": {
                "examples": {
                  "Not found": {
                    "summary": "Not found",
                    "value": {
                      "code": "RESOURCE_NOT_FOUND",
                      "messages": [
                        "Domain with id 8a2f4b1c-6d3e-4f7a-9b21-0c5d8e7f6a43 was not found"
                      ]
                    }
                  }
                },
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "example": "RESOURCE_NOT_FOUND"
          },
          "messages": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "securitySchemes": {
      "public-api-key": {
        "type": "apiKey",
        "in": "header",
        "name": "public-api-key"
      },
      "private-secret-key": {
        "type": "apiKey",
        "in": "header",
        "name": "private-secret-key"
      }
    }
  },
  "x-readme": {
    "explorer-enabled": true,
    "proxy-enabled": true
  },
  "security": [
    {
      "public-api-key": [],
      "private-secret-key": []
    }
  ]
}
