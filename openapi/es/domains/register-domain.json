{
  "openapi": "3.0.0",
  "info": {
    "version": "1.0.0",
    "title": "Domains"
  },
  "servers": [
    {
      "url": "https://api-sandbox.y.uno",
      "description": "Sandbox"
    },
    {
      "url": "https://api.y.uno",
      "description": "Production (US)"
    }
  ],
  "paths": {
    "/v1/payment-methods/domains": {
      "post": {
        "description": "",
        "responses": {
          "202": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "account_id": {
                      "type": "string",
                      "example": "3fa85f64-5717-4562-b3fc-2c963f66afa6"
                    },
                    "payment_method_type": {
                      "type": "string",
                      "example": "APPLE_PAY"
                    },
                    "domains": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "string",
                            "example": "8a2f4b1c-6d3e-4f7a-9b21-0c5d8e7f6a43"
                          },
                          "domain": {
                            "type": "string",
                            "example": "checkout.example.com"
                          },
                          "status": {
                            "type": "string",
                            "description": "`CREATED`: el registro ante el proveedor de la billetera está en curso. `REGISTERED`: el dominio está verificado y puede mostrar el botón de la billetera. `ERROR`: el proveedor rechazó el registro (por ejemplo, no se pudo acceder al archivo de asociación); vuelve a registrar el dominio después de corregirlo. `INACTIVE`: el dominio fue eliminado.",
                            "enum": [
                              "CREATED",
                              "REGISTERED",
                              "ERROR",
                              "INACTIVE"
                            ],
                            "example": "REGISTERED"
                          },
                          "created_at": {
                            "type": "string",
                            "example": "2026-01-22T10:30:00Z"
                          },
                          "updated_at": {
                            "type": "string",
                            "example": "2026-01-22T10:30:00Z"
                          }
                        }
                      }
                    }
                  }
                },
                "examples": {
                  "Accepted": {
                    "summary": "Accepted",
                    "value": {
                      "account_id": "3fa85f64-5717-4562-b3fc-2c963f66afa6",
                      "payment_method_type": "APPLE_PAY",
                      "domains": [
                        {
                          "id": "8a2f4b1c-6d3e-4f7a-9b21-0c5d8e7f6a43",
                          "domain": "checkout.example.com",
                          "status": "REGISTERED",
                          "created_at": "2026-01-22T10:30:00Z",
                          "updated_at": "2026-01-22T10:30:00Z"
                        },
                        {
                          "id": "c71e2d9a-5b04-4e6f-8a3d-2f1b7c9e0d55",
                          "domain": "shop.example.com",
                          "status": "REGISTERED",
                          "created_at": "2026-01-22T10:30:00Z",
                          "updated_at": "2026-01-22T10:30:00Z"
                        }
                      ]
                    }
                  }
                }
              }
            },
            "description": "Aceptado"
          }
        },
        "parameters": [
          {
            "in": "header",
            "name": "X-Idempotency-Key",
            "schema": {
              "type": "string"
            },
            "description": "Obligatorio: las solicitudes que no lo incluyan se rechazan con 400 INVALID_PARAMETERS. Se almacena solo con fines de auditoría y hoy no se aplica: cada llamada crea un nuevo intento de registro y una nueva llamada al proveedor de la billetera, incluso cuando repite una clave anterior.",
            "required": true
          }
        ],
        "operationId": "post_v1-payment-methods-domains",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "account_id": {
                    "type": "string",
                    "description": "El identificador único de la cuenta. Encuéntralo en el [Yuno dashboard](https://dashboard.y.uno/developers) (MAX 64; MIN 36)"
                  },
                  "connection_id": {
                    "type": "string",
                    "description": "El identificador único de la conexión de billetera en la que se registran los dominios (UUID). Con el certificado de Apple Pay de Yuno, una conexión admite como máximo 99 dominios."
                  },
                  "payment_method_type": {
                    "type": "string",
                    "description": "Un único método de pago para registrar en todos los dominios.",
                    "enum": [
                      "APPLE_PAY",
                      "GOOGLE_PAY"
                    ]
                  },
                  "domains": {
                    "type": "array",
                    "items": {
                      "properties": {
                        "url": {
                          "type": "string",
                          "description": "Nombre de dominio completo, sin esquema ni ruta (por ejemplo, `checkout.example.com`)."
                        }
                      },
                      "type": "object",
                      "required": [
                        "url"
                      ]
                    },
                    "description": "Dominios a registrar, de 1 a 50 por solicitud. Cada subdominio es un dominio independiente.",
                    "minItems": 1,
                    "maxItems": 50
                  }
                },
                "required": [
                  "account_id",
                  "connection_id",
                  "payment_method_type",
                  "domains"
                ]
              },
              "examples": {
                "Accepted": {
                  "summary": "Accepted",
                  "value": {
                    "account_id": "3fa85f64-5717-4562-b3fc-2c963f66afa6",
                    "connection_id": "7c1d9a2e-3f44-4e8a-9b61-8e2f4c6b9d0a",
                    "payment_method_type": "APPLE_PAY",
                    "domains": [
                      {
                        "url": "checkout.example.com"
                      },
                      {
                        "url": "shop.example.com"
                      }
                    ]
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "public-api-key": {
        "type": "apiKey",
        "in": "header",
        "name": "public-api-key"
      },
      "private-secret-key": {
        "type": "apiKey",
        "in": "header",
        "name": "private-secret-key"
      }
    }
  },
  "security": [
    {
      "public-api-key": [],
      "private-secret-key": []
    }
  ]
}
