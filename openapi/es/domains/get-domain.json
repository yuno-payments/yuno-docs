{
  "openapi": "3.0.0",
  "info": {
    "version": "1.0.0",
    "title": "Domains"
  },
  "servers": [
    {
      "url": "https://api-sandbox.y.uno",
      "description": "Sandbox"
    },
    {
      "url": "https://api.y.uno",
      "description": "Production (US)"
    }
  ],
  "paths": {
    "/v1/payment-methods/{payment_method}/domains/{domain_id}": {
      "get": {
        "description": "Recupera el registro de un dominio por su `id`. Usa el `id` que devuelve Register domain. Los dominios pertenecen a la conexión en la que se registraron; un dominio que pertenece a otra organización devuelve 404.",
        "operationId": "get_v1-payment-methods-payment-method-domains-domain-id",
        "parameters": [
          {
            "in": "path",
            "name": "payment_method",
            "description": "Método de pago para el que se registró el dominio.",
            "schema": {
              "type": "string",
              "enum": [
                "APPLE_PAY",
                "GOOGLE_PAY"
              ]
            },
            "required": true
          },
          {
            "in": "path",
            "name": "domain_id",
            "description": "El `id` del registro del dominio (UUID), tal como lo devuelve Register domain.",
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "required": true
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "examples": {
                  "OK": {
                    "summary": "OK",
                    "value": {
                      "id": "8a2f4b1c-6d3e-4f7a-9b21-0c5d8e7f6a43",
                      "account_id": "3fa85f64-5717-4562-b3fc-2c963f66afa6",
                      "domain": "checkout.example.com",
                      "payment_method_type": "APPLE_PAY",
                      "status": "REGISTERED",
                      "created_at": "2026-01-22T10:30:00Z",
                      "updated_at": "2026-01-22T10:45:00Z"
                    }
                  }
                },
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "description": "Identificador único del registro del dominio (UUID).",
                      "example": "8a2f4b1c-6d3e-4f7a-9b21-0c5d8e7f6a43"
                    },
                    "account_id": {
                      "type": "string",
                      "description": "La cuenta con la que se registró el dominio.",
                      "example": "3fa85f64-5717-4562-b3fc-2c963f66afa6"
                    },
                    "domain": {
                      "type": "string",
                      "description": "El dominio registrado, sin protocolo.",
                      "example": "checkout.example.com"
                    },
                    "payment_method_type": {
                      "type": "string",
                      "description": "Método de pago para el que se registró el dominio.",
                      "example": "APPLE_PAY"
                    },
                    "status": {
                      "type": "string",
                      "description": "`CREATED`: el registro ante el proveedor de la billetera está en curso. `REGISTERED`: el dominio está verificado y puede mostrar el botón de la billetera. `ERROR`: el proveedor rechazó el registro (por ejemplo, no se pudo acceder al archivo de asociación); vuelve a registrar el dominio después de corregirlo. `INACTIVE`: el dominio fue eliminado.",
                      "enum": [
                        "CREATED",
                        "REGISTERED",
                        "ERROR",
                        "INACTIVE"
                      ],
                      "example": "REGISTERED"
                    },
                    "created_at": {
                      "type": "string",
                      "example": "2026-01-22T10:30:00Z"
                    },
                    "updated_at": {
                      "type": "string",
                      "example": "2026-01-22T10:45:00Z"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "`payment_method` o `domain_id` no válido.",
            "content": {
              "application/json": {
                "examples": {
                  "Invalid parameters": {
                    "summary": "Invalid parameters",
                    "value": {
                      "code": "INVALID_PARAMETERS",
                      "messages": [
                        "domain_id must be a valid UUID"
                      ]
                    }
                  }
                },
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "No existe ningún dominio con ese `id` para tu organización.",
            "content": {
              "application/json": {
                "examples": {
                  "Not found": {
                    "summary": "Not found",
                    "value": {
                      "code": "RESOURCE_NOT_FOUND",
                      "messages": [
                        "Domain with id 8a2f4b1c-6d3e-4f7a-9b21-0c5d8e7f6a43 was not found"
                      ]
                    }
                  }
                },
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "example": "RESOURCE_NOT_FOUND"
          },
          "messages": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "securitySchemes": {
      "public-api-key": {
        "type": "apiKey",
        "in": "header",
        "name": "public-api-key"
      },
      "private-secret-key": {
        "type": "apiKey",
        "in": "header",
        "name": "private-secret-key"
      }
    }
  },
  "security": [
    {
      "public-api-key": [],
      "private-secret-key": []
    }
  ]
}
