{
  "openapi": "3.1.0",
  "info": {
    "title": "checkout-builder",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://api-sandbox.y.uno/v1",
      "description": "Sandbox"
    },
    {
      "url": "https://api.y.uno/v1",
      "description": "Production (US)"
    }
  ],
  "components": {
    "securitySchemes": {
      "publicApiKey": {
        "type": "apiKey",
        "in": "header",
        "name": "PUBLIC-API-KEY",
        "description": "Chave de API pública do lojista. Encontrada no Dashboard da Yuno → Settings → API Keys."
      },
      "privateSecretKey": {
        "type": "apiKey",
        "in": "header",
        "name": "PRIVATE-SECRET-KEY",
        "description": "Chave secreta privada do lojista, usada em par com a chave pública. Nunca a incorpore em código do lado do cliente."
      },
      "accountCode": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Account-Code",
        "description": "UUID da conta do lojista que delimita o escopo da requisição. O tenant é identificado somente a partir deste cabeçalho."
      }
    }
  },
  "security": [
    {
      "publicApiKey": [],
      "privateSecretKey": [],
      "accountCode": []
    }
  ],
  "paths": {
    "/checkouts/{checkout_code}": {
      "get": {
        "summary": "Consultar configuração do checkout",
        "description": "Retorna o checkout personalizado completo para o código informado: configuração e estilo compostos em uma única resposta. O identificador do checkout é exposto como o `id` de nível superior.",
        "operationId": "get-checkout-configuration",
        "parameters": [
          {
            "name": "checkout_code",
            "in": "path",
            "description": "O identificador único do checkout a ser consultado (UUID, 36 caracteres). Valores que não são UUID são rejeitados com 400 antes do processamento.",
            "schema": {
              "type": "string"
            },
            "required": true
          }
        ],
        "responses": {
          "200": {
            "description": "O checkout personalizado, com configuração e estilo compostos.",
            "content": {
              "application/json": {
                "examples": {
                  "Success": {
                    "value": {
                      "id": "8005ca91-dcfb-4428-b9f6-49c6e3446474",
                      "name": "Main Checkout",
                      "description": "",
                      "status": "PUBLISHED",
                      "is_default": true,
                      "created_at": "2026-01-01T00:00:00Z",
                      "updated_at": "2026-05-18T13:06:08Z",
                      "config": {
                        "payment_methods": [
                          {
                            "payment_method_type": "CARD",
                            "name": "Card",
                            "description": "Card",
                            "icon": "https://sdk.prod.y.uno/brands/card_logosimbolo.png",
                            "category": "CARD",
                            "short_name": "Card",
                            "hint": "",
                            "order_to_show": 1,
                            "is_active": true,
                            "type": "PAYMENT_METHOD",
                            "has_enrollment": true,
                            "conditions_quantity": 1,
                            "active_enrollment_type": "BOTH"
                          }
                        ],
                        "general_settings": {
                          "country_documents": [
                            {
                              "country_code": "AR",
                              "documents": [
                                "DNI",
                                "CUIT"
                              ]
                            }
                          ]
                        },
                        "feature_flags": {
                          "custom_required_fields": true,
                          "custom_logo_icon": true
                        }
                      },
                      "styling": {
                        "styles": {
                          "global": {
                            "accent_color": "#282A30",
                            "primary_background_color": "#FFFFFF",
                            "primary_text_color": "#282A30",
                            "primary_button_text_color": "#FFFFFF",
                            "secondary_background_color": "#ECEFF2",
                            "secondary_text_color": "#84807F",
                            "secondary_button_background_color": "#FFFFFF",
                            "secondary_button_text_color": "#282A30",
                            "font_family": "Inter"
                          },
                          "header": {
                            "logo_border_size": 0,
                            "logo_border_color": "#282A30",
                            "logo_corner_radius": 8,
                            "font_size": 18,
                            "font_weight": 700
                          },
                          "button": {
                            "corner_radius": 8,
                            "border_size": 0,
                            "primary_border_color": "#282A30",
                            "secondary_border_color": "#282A30",
                            "font_size": 18,
                            "font_weight": 400
                          }
                        },
                        "settings": {
                          "sdk_type": {
                            "web": "SEAMLESS",
                            "mobile": "SEAMLESS"
                          },
                          "card": {
                            "save_on_success": true,
                            "visualization_mode": "ONE_STEP",
                            "enable_ocr": false,
                            "credit_card_only_processing": false,
                            "default_network": "DOM"
                          },
                          "web_sdk": {
                            "render_mode": "MODAL",
                            "hide_pay_button": false
                          },
                          "payment_method_list": {
                            "unfolded_display": false,
                            "preselected_payment_method": false,
                            "condensed_checkout_view": false,
                            "edit_payment_method_list": false
                          },
                          "ui": {
                            "dark_mode": false,
                            "show_secure_payment_tag": true
                          },
                          "payment_link": {
                            "show_result_screen": false
                          }
                        },
                        "external_fonts": [
                          {
                            "family_name": "Inter",
                            "files": [
                              {
                                "weight": 400,
                                "url": "https://staging.y.uno/sdk-static-bundles-ms/v1/static/fonts/Inter-Regular.ttf"
                              }
                            ]
                          }
                        ],
                        "payment_link_styles": {
                          "panel": {
                            "left": {
                              "background": {
                                "color": "#ECEFF2"
                              },
                              "logo": "data:image/jpeg;base64,..."
                            }
                          },
                          "checkbox": {
                            "color": "#282A30"
                          },
                          "border": {
                            "color": "#282A30"
                          },
                          "radio_button": {
                            "color": "#282A30"
                          },
                          "button": {
                            "text": {
                              "color": "#876E6E"
                            },
                            "background": {
                              "color": "#282A30"
                            }
                          },
                          "published_at": "2026-05-14T19:34:06Z"
                        }
                      }
                    }
                  }
                },
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "description": "UUID do checkout (o checkout_code).",
                      "example": "8005ca91-dcfb-4428-b9f6-49c6e3446474"
                    },
                    "name": {
                      "type": "string",
                      "description": "Nome do checkout.",
                      "example": "Main Checkout"
                    },
                    "description": {
                      "type": "string",
                      "description": "Descrição do checkout."
                    },
                    "status": {
                      "type": "string",
                      "description": "Status do checkout.",
                      "example": "PUBLISHED"
                    },
                    "is_default": {
                      "type": "boolean",
                      "description": "Indica se este é o checkout padrão da conta.",
                      "example": true
                    },
                    "created_at": {
                      "type": "string",
                      "description": "Timestamp de criação (ISO 8601)."
                    },
                    "updated_at": {
                      "type": "string",
                      "description": "Timestamp da última atualização (ISO 8601)."
                    },
                    "config": {
                      "type": "object",
                      "description": "Configuração do checkout.",
                      "properties": {
                        "payment_methods": {
                          "type": "array",
                          "description": "Meios de pagamento configurados para este checkout. A ordem é definida por `order_to_show` (menor = primeiro). Retorna o catálogo completo de meios de pagamento disponíveis para a conta, não apenas os ativos neste checkout. Filtre por `is_active: true` para obter apenas os habilitados.",
                          "items": {
                            "type": "object"
                          }
                        },
                        "general_settings": {
                          "type": "object",
                          "description": "Configurações gerais do checkout, incluindo os tipos de documento aceitos por país (`country_documents`)."
                        },
                        "feature_flags": {
                          "type": "object",
                          "description": "Chaves de funcionalidades deste checkout, incluindo `custom_required_fields` e `custom_logo_icon`."
                        }
                      }
                    },
                    "styling": {
                      "type": "object",
                      "description": "Estilo e configurações do SDK do checkout: `styles`, `settings`, `external_fonts`, `payment_link_styles`."
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "`checkout_code` não é um UUID válido.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "string",
                      "example": "INVALID_PARAMETERS"
                    },
                    "messages": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Não autenticado, ou a conta não está na allowlist do beta.",
            "content": {
              "application/json": {
                "examples": {
                  "Unauthorized": {
                    "value": {
                      "code": "NOT_AUTHENTICATED",
                      "messages": [
                        "Not authenticated"
                      ]
                    }
                  }
                },
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "string",
                      "example": "NOT_AUTHENTICATED"
                    },
                    "messages": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "O checkout não foi encontrado para esta conta.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "string"
                    },
                    "messages": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "deprecated": false
      }
    }
  }
}
