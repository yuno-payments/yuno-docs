{
  "openapi": "3.1.0",
  "info": {
    "title": "checkout-builder",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://api-sandbox.y.uno/v1",
      "description": "Sandbox"
    },
    {
      "url": "https://api.y.uno/v1",
      "description": "Production (US)"
    }
  ],
  "components": {
    "securitySchemes": {
      "publicApiKey": {
        "type": "apiKey",
        "in": "header",
        "name": "PUBLIC-API-KEY",
        "description": "Chave de API pública do lojista. Encontrada no Dashboard da Yuno → Settings → API Keys."
      },
      "privateSecretKey": {
        "type": "apiKey",
        "in": "header",
        "name": "PRIVATE-SECRET-KEY",
        "description": "Chave secreta privada do lojista, usada em par com a chave pública. Nunca a incorpore em código do lado do cliente."
      },
      "accountCode": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Account-Code",
        "description": "UUID da conta do lojista que delimita o escopo da requisição. O tenant é identificado somente a partir deste cabeçalho."
      }
    },
    "schemas": {
      "CheckoutSummary": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Identificador do checkout (UUID). Use-o como checkout_code nos endpoints de consulta e publicação."
          },
          "name": {
            "type": "string",
            "description": "Nome do checkout."
          },
          "description": {
            "type": "string",
            "description": "Descrição do checkout."
          },
          "status": {
            "type": "string",
            "enum": [
              "PUBLISHED",
              "NOT_PUBLISHED",
              "ARCHIVED"
            ],
            "description": "Status do checkout."
          },
          "is_default": {
            "type": "boolean",
            "description": "Indica se este checkout é o padrão da conta."
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "description": "Timestamp de criação (ISO-8601)."
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "description": "Timestamp da última atualização (ISO-8601)."
          }
        }
      }
    }
  },
  "security": [
    {
      "publicApiKey": [],
      "privateSecretKey": [],
      "accountCode": []
    }
  ],
  "paths": {
    "/checkouts": {
      "get": {
        "summary": "Listar checkouts",
        "description": "Lista os checkouts personalizados da conta como resumos (sem configuração nem estilo), ordenados com o padrão primeiro e depois pelos atualizados mais recentemente. Inclui checkouts ARCHIVED. Todos os filtros são opcionais e combináveis (com AND). Sem page ou size, a resposta é um array simples com todos os checkouts correspondentes; enviar qualquer um deles muda para um envelope paginado.",
        "operationId": "list-checkouts",
        "parameters": [
          {
            "name": "name",
            "in": "query",
            "description": "Filtro \"contém\" no nome do checkout, sem diferenciar maiúsculas de minúsculas. Os metacaracteres de LIKE (% e _) correspondem literalmente.",
            "schema": {
              "type": "string"
            },
            "required": false
          },
          {
            "name": "id",
            "in": "query",
            "description": "Filtro \"contém\" no identificador do checkout, sem diferenciar maiúsculas de minúsculas.",
            "schema": {
              "type": "string"
            },
            "required": false
          },
          {
            "name": "status",
            "in": "query",
            "description": "Filtra por status. Aceita um ou vários valores (com OR): repita o parâmetro ou envie uma lista separada por vírgulas (status=PUBLISHED,ARCHIVED). Valores inválidos são rejeitados com 400. Ausente: todos os status.",
            "schema": {
              "type": "string",
              "enum": [
                "PUBLISHED",
                "NOT_PUBLISHED",
                "ARCHIVED"
              ]
            },
            "required": false
          },
          {
            "name": "created_after",
            "in": "query",
            "description": "Limite inferior inclusivo de created_at (instante ISO-8601, por exemplo, 2026-05-01T00:00:00Z).",
            "schema": {
              "type": "string",
              "format": "date-time"
            },
            "required": false
          },
          {
            "name": "created_before",
            "in": "query",
            "description": "Limite superior inclusivo de created_at (instante ISO-8601).",
            "schema": {
              "type": "string",
              "format": "date-time"
            },
            "required": false
          },
          {
            "name": "updated_after",
            "in": "query",
            "description": "Limite inferior inclusivo de updated_at (instante ISO-8601).",
            "schema": {
              "type": "string",
              "format": "date-time"
            },
            "required": false
          },
          {
            "name": "updated_before",
            "in": "query",
            "description": "Limite superior inclusivo de updated_at (instante ISO-8601).",
            "schema": {
              "type": "string",
              "format": "date-time"
            },
            "required": false
          },
          {
            "name": "page",
            "in": "query",
            "description": "Número da página (começando em 1). Paginação opcional: enviar page ou size muda a resposta para o envelope paginado. Padrão 1. Valores não numéricos são rejeitados com 400.",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 1
            },
            "required": false
          },
          {
            "name": "size",
            "in": "query",
            "description": "Tamanho da página. Paginação opcional: enviar page ou size muda a resposta para o envelope paginado. Padrão 25, com limite de 100. Valores não numéricos são rejeitados com 400.",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 25
            },
            "required": false
          }
        ],
        "responses": {
          "200": {
            "description": "Os checkouts da conta. Um array simples quando page e size estão ausentes; um envelope paginado (data + pagination) quando algum deles está presente. Os itens trazem os mesmos 7 campos nos dois formatos. pagination.total é a contagem filtrada completa, não o número de linhas da página.",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/CheckoutSummary"
                      },
                      "description": "Array simples com todos os checkouts correspondentes (page e size ausentes).",
                      "title": "Sem paginação"
                    },
                    {
                      "type": "object",
                      "description": "Envelope paginado (page ou size presente).",
                      "properties": {
                        "data": {
                          "type": "array",
                          "items": {
                            "$ref": "#/components/schemas/CheckoutSummary"
                          }
                        },
                        "pagination": {
                          "type": "object",
                          "properties": {
                            "page": {
                              "type": "integer",
                              "description": "Página atual (começando em 1)."
                            },
                            "size": {
                              "type": "integer",
                              "description": "Tamanho da página."
                            },
                            "total": {
                              "type": "integer",
                              "description": "Contagem filtrada completa, não o número de linhas da página."
                            }
                          }
                        }
                      },
                      "title": "Com paginação"
                    }
                  ]
                },
                "examples": {
                  "Without pagination": {
                    "value": [
                      {
                        "id": "2a8d6472-3117-4e85-8b28-d51ba3abab77",
                        "name": "Default",
                        "description": "Default",
                        "status": "PUBLISHED",
                        "is_default": true,
                        "created_at": "2026-05-02T18:11:04.120Z",
                        "updated_at": "2026-07-01T09:30:12.001Z"
                      },
                      {
                        "id": "0b28ff66-15f1-44c1-8d1e-bd1fefbc0a19",
                        "name": "Promo Checkout",
                        "description": "Seasonal promo",
                        "status": "ARCHIVED",
                        "is_default": false,
                        "created_at": "2026-04-11T10:02:33.000Z",
                        "updated_at": "2026-06-20T15:45:00.000Z"
                      }
                    ]
                  },
                  "With pagination": {
                    "value": {
                      "data": [
                        {
                          "id": "2a8d6472-3117-4e85-8b28-d51ba3abab77",
                          "name": "Default",
                          "description": "Default",
                          "status": "PUBLISHED",
                          "is_default": true,
                          "created_at": "2026-05-02T18:11:04.120Z",
                          "updated_at": "2026-07-01T09:30:12.001Z"
                        }
                      ],
                      "pagination": {
                        "page": 1,
                        "size": 25,
                        "total": 3
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Valores de page/size inválidos ou um valor de status inválido.",
            "content": {
              "application/json": {
                "examples": {
                  "Invalid pagination": {
                    "value": {
                      "code": "ILLEGAL_ARGUMENT",
                      "messages": [
                        "page must be a positive integer"
                      ]
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Credenciais ausentes ou inválidas, ou a conta não está na allowlist do beta."
          }
        }
      }
    }
  }
}
