{
  "openapi": "3.1.0",
  "info": {
    "title": "Yuno Dry-Run API",
    "version": "1.0"
  },
  "servers": [
    {
      "url": "https://api-sandbox.y.uno/v1",
      "description": "Sandbox"
    },
    {
      "url": "https://api.y.uno/v1",
      "description": "Production (US)"
    }
  ],
  "paths": {
    "/dry-run/provider-events": {
      "post": {
        "operationId": "registerDryRunProviderEvent",
        "summary": "Registrar payloads de requisição, resposta e webhook do provedor",
        "description": "Armazena o tráfego HTTP que o lojista trocou diretamente com um provedor de pagamento\n(requisição, resposta e webhook) para correlação com um pagamento da Yuno.\n",
        "parameters": [
          {
            "in": "header",
            "name": "PUBLIC-API-KEY",
            "schema": {
              "type": "string"
            },
            "description": "Chave de API pública. É obrigatório enviar PUBLIC-API-KEY ou PRIVATE-SECRET-KEY."
          },
          {
            "in": "header",
            "name": "PRIVATE-SECRET-KEY",
            "schema": {
              "type": "string"
            },
            "description": "Chave secreta privada para chamadas server-to-server. É obrigatório enviar PUBLIC-API-KEY ou PRIVATE-SECRET-KEY."
          },
          {
            "in": "header",
            "name": "X-Idempotency-Key",
            "schema": {
              "type": "string",
              "maxLength": 64
            },
            "description": "String de formato livre (MAX 64). Janela de repetição de 24 horas."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DryRunRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Dry-run registrado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DryRunResponse"
                }
              }
            }
          },
          "400": {
            "description": "Falha de validação",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Credenciais ausentes ou inválidas",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Pagamento não encontrado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Repetição com a mesma chave de idempotência e um payload diferente"
          },
          "413": {
            "description": "O payload ou o lote excede os limites de tamanho"
          },
          "415": {
            "description": "Content-Type não suportado (deve ser application/json)"
          },
          "429": {
            "description": "Limite de taxa excedido"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "DryRunRequest": {
        "type": "object",
        "required": [
          "merchant_reference",
          "events"
        ],
        "properties": {
          "merchant_reference": {
            "type": "string",
            "minLength": 3,
            "maxLength": 255,
            "description": "Identificador atribuído pelo lojista (MAX 255; MIN 3). Único por conta.",
            "example": "ORD-12345"
          },
          "payment_id": {
            "type": "string",
            "format": "uuid",
            "description": "UUID do pagamento na Yuno. Se informado, é resolvido imediatamente.",
            "example": "fb9e5fa4-684c-4747-9755-9d332617f16f"
          },
          "account_id": {
            "type": "string",
            "format": "uuid",
            "description": "UUID da conta na Yuno, no mesmo formato de account_id em POST /v1/payments.",
            "example": "a389f417-ecd1-4355-89f5-7489564f264d"
          },
          "provider_id": {
            "type": "string",
            "description": "Identificador do provedor. Valores permitidos alinhados ao catálogo da Yuno.",
            "example": "STRIPE",
            "enum": [
              "STRIPE",
              "ADYEN",
              "CYBERSOURCE",
              "BRAINTREE",
              "NMI",
              "CHECKOUT",
              "WORLDPAY",
              "PAYPAL",
              "EBANX",
              "GLOBALPAYMENTS",
              "NUVEI",
              "CIELO",
              "MPGS",
              "PRISMA",
              "FISERV",
              "WORLDLINE",
              "ANTOM",
              "ORBITAL",
              "GOCARDLESS",
              "AUTHORIZE_NET",
              "SONY",
              "CITI",
              "EPX",
              "HPAY",
              "PAYSTACK",
              "PLAID",
              "SAFERPAY",
              "SIKA_HEALTH",
              "VALIDIFI",
              "WEPAY",
              "CARD_CONNECT",
              "GMO_PG",
              "MONERIS",
              "BLUESNAP",
              "QUICK_GATEWAY",
              "TWENTYFOUR_HOUR_FITNESS",
              "MERCHANT_ESOLUTIONS",
              "NETS",
              "FAT_ZEBRA",
              "WINDCAVE",
              "CHASE_MOBILITY",
              "HELIX",
              "ANB",
              "AMAZON_PAY",
              "OPAYO",
              "IP_PAYMENTS",
              "KLARNA",
              "BILLDESK",
              "WELLS_FARGO",
              "SAGEPAY",
              "PLANET"
            ]
          },
          "payment_method_type": {
            "type": "string",
            "description": "Meio de pagamento usado por este dry-run. Mesmo vocabulário de payment_method.type em POST /v1/payments.",
            "example": "CREDIT_CARD",
            "enum": [
              "",
              "CARD",
              "CREDIT_CARD",
              "CREDIT_CARD_REFERENCE_TRANSACTION",
              "DEBIT_CARD",
              "EPX_TOKEN",
              "TEST_CREDIT_CARD",
              "UPC_TOKEN_TRANSACTION",
              "APPLE_PAY",
              "GOOGLE_PAY",
              "PIX",
              "PSE",
              "OXXO",
              "BOLETO",
              "ALI_PAY",
              "AMAZON_PAY",
              "GCASH",
              "IDEAL",
              "KAKAO_PAY",
              "KLARNA",
              "MOMO_PAY",
              "NAVER_PAY",
              "OVO",
              "PAYPAL",
              "PAYPAL_CREDIT",
              "PAYPAY",
              "PAZE",
              "TOSS_PAY",
              "UPI",
              "VENMO",
              "ACH",
              "BANK_TRANSFER",
              "CRYPTO",
              "CASH"
            ]
          },
          "events": {
            "type": "array",
            "minItems": 1,
            "maxItems": 10,
            "description": "De 1 a 10 entradas de troca HTTP para este dry-run (MAX 10; MIN 1).",
            "items": {
              "$ref": "#/components/schemas/Event"
            },
            "example": [
              {
                "type": "REQUEST",
                "http_method": "POST",
                "operation_type": "PURCHASE",
                "base_url": "https://api.stripe.com",
                "endpoint": "/v1/charges",
                "headers": "eyBDb250ZW50LVR5cGU6IGFwcGxpY2F0aW9uL2pzb24gfQ==",
                "body": "eyBhbW91bnQ6IDIwMDAsIGN1cnJlbmN5OiAidXNkIiB9"
              }
            ]
          }
        }
      },
      "Event": {
        "type": "object",
        "required": [
          "type",
          "http_method",
          "operation_type",
          "headers"
        ],
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "REQUEST",
              "RESPONSE",
              "WEBHOOK"
            ],
            "description": "Qual etapa da troca esta entrada captura.",
            "example": "REQUEST"
          },
          "http_method": {
            "type": "string",
            "enum": [
              "GET",
              "POST",
              "PUT",
              "PATCH",
              "DELETE"
            ],
            "example": "POST"
          },
          "operation_type": {
            "type": "string",
            "enum": [
              "PURCHASE",
              "AUTHORIZE",
              "CAPTURE",
              "CANCEL",
              "REFUND",
              "CHARGEBACK",
              "THREE_D_SECURE"
            ],
            "description": "Identifica o tipo de operação de pagamento que está sendo simulada.",
            "example": "PURCHASE"
          },
          "base_url": {
            "type": "string",
            "format": "uri",
            "description": "Obrigatório para REQUEST e WEBHOOK. Origem do endpoint do provedor: esquema + host + porta (ex.: https://api.stripe.com).",
            "example": "https://api.stripe.com"
          },
          "endpoint": {
            "type": "string",
            "description": "Obrigatório para REQUEST e WEBHOOK. Parte de caminho e query (ex.: /v1/charges?expand=customer).",
            "example": "/v1/charges"
          },
          "http_status_code": {
            "type": "integer",
            "format": "int32",
            "minimum": 100,
            "maximum": 599,
            "description": "Obrigatório para RESPONSE e WEBHOOK. Omita para REQUEST."
          },
          "headers": {
            "type": "string",
            "format": "byte",
            "maxLength": 87400,
            "description": "Payload do cabeçalho codificado em Base64. O conteúdo decodificado pode ser um mapa\n`{header-name: header-value}` serializado em JSON ou o bloco bruto de cabeçalhos HTTP. Limite\nmáximo: 64 KB de bytes decodificados por evento.\n",
            "example": "eyBDb250ZW50LVR5cGU6IGFwcGxpY2F0aW9uL2pzb24gfQ=="
          },
          "body": {
            "type": "string",
            "format": "byte",
            "maxLength": 1398000,
            "description": "Payload do corpo codificado em Base64. Omita para corpos vazios. Limite máximo: 1 MB de\nbytes decodificados por evento. Para corpos que não são UTF-8 (protobuf, gzip),\ncodifique os bytes brutos diretamente em base64.\n",
            "example": "eyBhbW91bnQ6IDIwMDAsIGN1cnJlbmN5OiAidXNkIiB9"
          }
        }
      },
      "DryRunResponse": {
        "type": "object",
        "required": [
          "id",
          "status",
          "merchant_reference"
        ],
        "properties": {
          "id": {
            "type": "string",
            "description": "Identificador público do registro do dry-run (nano_id, 21 caracteres).",
            "example": "drun_1209fnkw428ufwd"
          },
          "status": {
            "type": "string",
            "enum": [
              "REGISTERED"
            ],
            "description": "Estado do ciclo de vida.",
            "example": "REGISTERED"
          },
          "merchant_reference": {
            "type": "string",
            "example": "ORD-12345"
          },
          "payment_id": {
            "type": "string",
            "format": "uuid",
            "nullable": true,
            "example": "fb9e5fa4-684c-4747-9755-9d332617f16f"
          },
          "account_id": {
            "type": "string",
            "format": "uuid",
            "nullable": true,
            "example": "a389f417-ecd1-4355-89f5-7489564f264d"
          },
          "provider_id": {
            "type": "string",
            "example": "STRIPE"
          },
          "payment_method_type": {
            "type": "string",
            "example": "CARD",
            "enum": [
              "",
              "CARD",
              "CREDIT_CARD",
              "CREDIT_CARD_REFERENCE_TRANSACTION",
              "DEBIT_CARD",
              "EPX_TOKEN",
              "TEST_CREDIT_CARD",
              "UPC_TOKEN_TRANSACTION",
              "APPLE_PAY",
              "GOOGLE_PAY",
              "PIX",
              "PSE",
              "OXXO",
              "BOLETO",
              "ALI_PAY",
              "AMAZON_PAY",
              "GCASH",
              "IDEAL",
              "KAKAO_PAY",
              "KLARNA",
              "MOMO_PAY",
              "NAVER_PAY",
              "OVO",
              "PAYPAL",
              "PAYPAL_CREDIT",
              "PAYPAY",
              "PAZE",
              "TOSS_PAY",
              "UPI",
              "VENMO",
              "ACH",
              "BANK_TRANSFER",
              "CRYPTO",
              "CASH"
            ]
          },
          "operation_type": {
            "type": "string",
            "example": "PURCHASE"
          }
        }
      },
      "Error": {
        "type": "object",
        "required": [
          "code",
          "messages",
          "httpCode"
        ],
        "properties": {
          "code": {
            "type": "string",
            "description": "Código de erro estável.",
            "enum": [
              "NOT_AUTHENTICATED",
              "AuthenticationFail",
              "INVALID_PARAMETERS",
              "TRAFFIC_LOG_VALIDATION_FAILED",
              "TRAFFIC_LOG_MERCHANT_REFERENCE_REQUIRED",
              "TRAFFIC_LOG_BODY_ENCODING_MISMATCH",
              "TRAFFIC_LOG_IDEMPOTENCY_REPLAY",
              "TRAFFIC_LOG_PAYLOAD_TOO_LARGE",
              "TRAFFIC_LOG_UNSUPPORTED_CONTENT_TYPE",
              "TRAFFIC_LOG_SEMANTIC_INVALID",
              "PAYMENT_NOT_FOUND",
              "RATE_LIMITED"
            ]
          },
          "messages": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Detalhes do erro legíveis por pessoas."
          },
          "httpCode": {
            "type": "integer",
            "format": "int32"
          }
        }
      }
    }
  }
}
