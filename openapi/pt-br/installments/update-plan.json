{
  "openapi": "3.1.0",
  "info": {
    "title": "installments",
    "version": "1.0.2"
  },
  "servers": [
    {
      "url": "https://api-sandbox.y.uno/v1",
      "description": "Sandbox"
    },
    {
      "url": "https://api.y.uno/v1",
      "description": "Production (US)"
    }
  ],
  "components": {
    "securitySchemes": {
      "sec0": {
        "type": "apiKey",
        "in": "header",
        "name": "public-api-key",
        "x-default": "<Your public-api-key>"
      },
      "sec1": {
        "type": "apiKey",
        "in": "header",
        "name": "private-secret-key",
        "x-default": "<Your private-secret-key>"
      }
    }
  },
  "security": [
    {
      "sec0": [],
      "sec1": []
    }
  ],
  "paths": {
    "/installments-plans/{installment_code}": {
      "patch": {
        "summary": "Atualizar plano",
        "description": "",
        "operationId": "update-plan",
        "parameters": [
          {
            "name": "installment_code",
            "in": "path",
            "description": "O identificador único do plano de parcelamento.",
            "schema": {
              "type": "string"
            },
            "required": true
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "description": "O nome do plano de parcelamento (MAX 255; MIN 3)"
                  },
                  "account_id": {
                    "type": "array",
                    "description": "O identificador único da conta da Yuno que terá o plano de parcelamento disponível para uso (MAX 64 ; MIN 36).",
                    "items": {
                      "type": "string"
                    }
                  },
                  "merchant_reference": {
                    "type": "string",
                    "description": "Identificação do plano de parcelamento (MAX 255; MIN 3)"
                  },
                  "installments_plan": {
                    "type": "array",
                    "description": "Definição das parcelas disponíveis para cada cenário",
                    "items": {
                      "properties": {
                        "installment": {
                          "type": "integer",
                          "description": "O número de parcelas mensais que os compradores podem escolher",
                          "format": "int32"
                        },
                        "rate": {
                          "type": "number",
                          "description": "A taxa aplicada pelo provedor de pagamento ao valor final da transação depois do uso de parcelas. O valor deve ser informado como multiplicador, não como porcentagem. Por exemplo, para aplicar uma taxa de 20%, informe `1.20` em vez de `20`.",
                          "format": "float"
                        },
                        "financial_costs": {
                          "type": "array",
                          "description": "Detalhes opcionais dos custos financeiros desta opção de parcelamento.",
                          "items": {
                            "type": "object",
                            "properties": {
                              "type": {
                                "type": "string",
                                "description": "O identificador do tipo de custo financeiro (MIN 3; MAX 255).\n\n<br/> Exemplo: `CFT`, `TEA`, `CET`, `CAT`"
                              },
                              "rate": {
                                "type": "number",
                                "description": "A taxa de custo financeiro como número decimal (ex.: 45.25 para 45.25%).",
                                "minimum": 0,
                                "maximum": 100000,
                                "format": "float"
                              }
                            },
                            "required": [
                              "type",
                              "rate"
                            ]
                          }
                        },
                        "type": {
                          "type": "string",
                          "description": "Tipo de parcela. Disponível apenas para Equador e México. Merchant se refere a pagamentos diferidos com juros, e Issuer se refere a pagamentos diferidos sem juros",
                          "enum": [
                            "MERCHANT_INSTALLMENTS",
                            "ISSUER_INSTALLMENTS"
                          ]
                        }
                      },
                      "required": [
                        "installment",
                        "rate"
                      ],
                      "type": "object"
                    }
                  },
                  "country_code": {
                    "type": "string",
                    "description": "O país do emissor  (ISO 3166-1 MAX 2; MIN 2)"
                  },
                  "scheme": {
                    "type": "string",
                    "description": "Informações da bandeira do cartão. (MAX 255; MIN 3)"
                  },
                  "brand": {
                    "type": "array",
                    "description": "Informações da bandeira do cartão (MAX 255; MIN 3).",
                    "items": {
                      "type": "string"
                    }
                  },
                  "issuer": {
                    "type": "string",
                    "description": "Emissor do cartão (MAX 255; MIN 3)"
                  },
                  "iin": {
                    "type": "array",
                    "description": "O número de identificação do emissor (IIN) corresponde aos primeiros dígitos de um número de cartão de pagamento emitido por uma instituição financeira (MAX 8; MIN 6)",
                    "items": {
                      "type": "string"
                    }
                  },
                  "first_installment_deferral": {
                    "type": "integer",
                    "description": "A quantidade de meses de espera para debitar a primeira parcela (MAX: 3).",
                    "format": "int32"
                  },
                  "amount": {
                    "type": "object",
                    "description": "Os valores para os quais o plano de parcelamento estará disponível. Se for null, fica disponível para qualquer valor.",
                    "required": [
                      "currency"
                    ],
                    "properties": {
                      "currency": {
                        "type": "string",
                        "description": "A moeda usada para fazer o pagamento (ISO 4217 MAX 3; MIN 3)"
                      },
                      "min_value": {
                        "type": "number",
                        "description": "O valor mínimo para o qual o plano de parcelamento estará disponível para uso (múltiplo de 0.0001).",
                        "format": "float"
                      },
                      "max_value": {
                        "type": "number",
                        "description": "O valor máximo para o qual o plano de parcelamento estará disponível para uso (múltiplo de 0.0001).",
                        "format": "float"
                      }
                    }
                  },
                  "availability": {
                    "type": "object",
                    "description": "As datas em que o plano de parcelamento estará disponível. Se for null, não tem data de término",
                    "required": [
                      "start_at",
                      "finish_at"
                    ],
                    "properties": {
                      "start_at": {
                        "type": "string",
                        "description": "A data de início a partir da qual o plano de parcelamento estará disponível para uso",
                        "format": "date-time"
                      },
                      "finish_at": {
                        "type": "string",
                        "description": "A data de término até a qual o plano de parcelamento estará disponível para uso.",
                        "format": "date-time"
                      }
                    }
                  }
                }
              },
              "examples": {
                "Update Plan": {
                  "summary": "Update Plan",
                  "value": {
                    "name": "Plan Update",
                    "account_id": [
                      "{{account_id}}"
                    ],
                    "merchant_reference": "REF01",
                    "installments_plan": [
                      {
                        "installment": 3,
                        "rate": 1.05,
                        "financial_costs": [
                          {
                            "type": "CFT",
                            "rate": 15.5
                          }
                        ],
                        "type": "MERCHANT_INSTALLMENTS"
                      },
                      {
                        "installment": 6,
                        "rate": 1.1
                      },
                      {
                        "installment": 12,
                        "rate": 1.2
                      }
                    ],
                    "country_code": "US",
                    "scheme": "VISA",
                    "brand": [
                      "VISA",
                      "MASTERCARD"
                    ],
                    "issuer": "JPMORGAN CHASE BANK",
                    "iin": [
                      "411111",
                      "542418"
                    ],
                    "first_installment_deferral": 1,
                    "amount": {
                      "currency": "USD",
                      "min_value": 50,
                      "max_value": 10000
                    },
                    "availability": {
                      "start_at": "2024-01-01T00:00:00.000Z",
                      "finish_at": "2024-12-31T23:59:59.999Z"
                    }
                  }
                }
              }
            }
          }
        },
