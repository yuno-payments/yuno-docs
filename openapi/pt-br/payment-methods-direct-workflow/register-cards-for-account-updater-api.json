{
  "openapi": "3.1.0",
  "info": {
    "title": "customer-api-register-payment-method",
    "version": "1.0.2"
  },
  "servers": [
    {
      "url": "https://api-sandbox.y.uno/v1",
      "description": "Sandbox"
    },
    {
      "url": "https://api.y.uno/v1",
      "description": "Production (US)"
    }
  ],
  "components": {
    "securitySchemes": {
      "sec0": {
        "type": "apiKey",
        "in": "header",
        "name": "public-api-key",
        "x-default": "<Your public-api-key>"
      },
      "sec1": {
        "type": "apiKey",
        "in": "header",
        "x-default": "<Your private-secret-key>",
        "name": "private-secret-key"
      },
      "sec2": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Idempotency-Key",
        "x-default": "<Your X-Idempotency-Key>"
      }
    }
  },
  "security": [
    {
      "sec0": [],
      "sec1": [],
      "sec2": []
    }
  ],
  "paths": {
    "/payment-methods/account-updater": {
      "post": {
        "summary": "Registrar cartões armazenados no Account Updater",
        "description": "Registre até 100 cartões armazenados no Card Account Updater em uma única requisição, identificados pelo id do meio de pagamento (`vaulted_token`). A validação é síncrona e do tipo tudo ou nada: se algum id for inválido, a requisição inteira é rejeitada. O registro em si é executado de forma assíncrona, então uma resposta `200` confirma que os cartões foram aceitos, não que a atualização foi concluída. Sua conta precisa estar habilitada para o Card Account Updater para usar este endpoint.",
        "operationId": "register-cards-for-account-updater-api",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "examples": {
                "Register cards": {
                  "value": {
                    "payment_method_ids": [
                      "cbdcc878-ceb4-4dd8-b0f0-49d444855de0",
                      "03c3aae1-ed42-4be6-bc24-de5487f58491"
                    ]
                  }
                }
              },
              "schema": {
                "type": "object",
                "required": [
                  "payment_method_ids"
                ],
                "properties": {
                  "payment_method_ids": {
                    "type": "array",
                    "description": "Lista de ids de meios de pagamento armazenados (`vaulted_token`) a registrar no Card Account Updater. Entre 1 e 100 itens; cada um deve ser um UUID válido.",
                    "minItems": 1,
                    "maxItems": 100,
                    "items": {
                      "type": "string",
                      "format": "uuid",
                      "example": "cbdcc878-ceb4-4dd8-b0f0-49d444855de0"
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "200",
            "content": {
              "application/json": {
                "examples": {
                  "Result": {
                    "value": {
                      "accepted": 2
                    }
                  }
                },
                "schema": {
                  "type": "object",
                  "properties": {
                    "accepted": {
                      "type": "integer",
                      "description": "Número de cartões aceitos para registro no Card Account Updater.",
                      "example": 2
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "400",
            "content": {
              "application/json": {
                "examples": {
                  "Bad Request": {
                    "value": {
                      "code": "INVALID_REQUEST",
                      "messages": [
                        "Invalid request"
                      ]
                    }
                  },
                  "Organization not enrolled": {
                    "value": {
                      "code": "BAD_REQUEST",
                      "messages": [
                        "organization is not enrolled in account updater."
                      ]
                    }
                  }
                },
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "string",
                      "example": "INVALID_REQUEST"
                    },
                    "messages": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "example": "Invalid request"
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "401",
            "content": {
              "application/json": {
                "examples": {
                  "Result": {
                    "value": {
                      "code": "INVALID_CREDENTIALS",
                      "messages": [
                        "Invalid credentials"
                      ]
                    }
                  }
                },
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "string",
                      "example": "INVALID_CREDENTIALS"
                    },
                    "messages": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "example": "Invalid credentials"
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "deprecated": false
      }
    }
  },
  "x-readme": {
    "headers": [
      {
        "key": "charset",
        "value": "utf-8"
      }
    ],
    "explorer-enabled": true,
    "proxy-enabled": true
  },
  "x-readme-fauxas": true
}
