{
  "openapi": "3.1.0",
  "info": {
    "title": "three-d-secure-setups-api",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://api-sandbox.y.uno/v1",
      "description": "Sandbox"
    },
    {
      "url": "https://api.y.uno/v1",
      "description": "Production (US)"
    }
  ],
  "components": {
    "securitySchemes": {
      "sec0": {
        "type": "apiKey",
        "in": "header",
        "name": "public-api-key",
        "x-default": "<Your public-api-key>"
      },
      "sec1": {
        "type": "apiKey",
        "in": "header",
        "name": "private-secret-key",
        "x-default": "<Your private-secret-key>"
      },
      "sec2": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Idempotency-Key",
        "x-default": "<Your X-Idempotency-Key>"
      }
    }
  },
  "security": [
    {
      "sec0": [],
      "sec1": [],
      "sec2": []
    }
  ],
  "paths": {
    "/three-d-secure/setups": {
      "post": {
        "summary": "Criar configuração 3DS2",
        "description": "Registre os dados de configuração do 3D Secure 2 que sua integração coletou (o ambiente do navegador do titular do cartão e quaisquer device fingerprints pré-calculados) e receba um `three_d_secure_setup_id` para referenciar no `POST /v1/payments` seguinte.",
        "operationId": "create-three-d-secure-setup",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "account_id",
                  "type",
                  "browser_info"
                ],
                "properties": {
                  "account_id": {
                    "type": "string",
                    "format": "uuid",
                    "description": "UUID da conta à qual esta configuração 3DS2 pertence."
                  },
                  "type": {
                    "type": "string",
                    "description": "Origem dos dados do dispositivo. `MERCHANT_PROVIDED` significa que você coletou os dados do navegador/dispositivo do seu lado e os está enviando diretamente.",
                    "enum": [
                      "MERCHANT_PROVIDED"
                    ]
                  },
                  "browser_info": {
                    "type": "object",
                    "description": "Ambiente do navegador capturado da sessão do titular do cartão. Encaminhado literalmente ao servidor 3DS2 para pontuação de risco e decisão frictionless.",
                    "required": [
                      "user_agent",
                      "accept_header",
                      "color_depth",
                      "screen_height",
                      "screen_width",
                      "language"
                    ],
                    "properties": {
                      "user_agent": {
                        "type": "string",
                        "description": "`navigator.userAgent` do navegador do titular do cartão."
                      },
                      "accept_header": {
                        "type": "string",
                        "description": "Valor do cabeçalho HTTP `Accept` enviado pelo navegador."
                      },
                      "color_depth": {
                        "type": "string",
                        "description": "`screen.colorDepth`, por exemplo `\"24\"`."
                      },
                      "screen_height": {
                        "type": "string",
                        "description": "`screen.height` em pixels."
                      },
                      "screen_width": {
                        "type": "string",
                        "description": "`screen.width` em pixels."
                      },
                      "language": {
                        "type": "string",
                        "description": "Tag de idioma BCP-47 de `navigator.language`, por exemplo `\"es-CO\"`."
                      },
                      "javascript_enabled": {
                        "type": "boolean",
                        "description": "Indica se o JavaScript está habilitado. O padrão é `true` quando omitido."
                      },
                      "java_enabled": {
                        "type": "boolean",
                        "description": "Indica se o plugin Java está habilitado. Quase sempre `false` em navegadores modernos."
                      },
                      "browser_time_difference": {
                        "type": "string",
                        "description": "Deslocamento UTC do navegador em minutos, com sinal (por exemplo, `\"-300\"` para UTC-5). Equivalente a `new Date().getTimezoneOffset()`."
                      },
                      "platform": {
                        "type": "string",
                        "description": "Canal que capturou os dados.",
                        "enum": [
                          "WEB",
                          "IOS",
                          "ANDROID"
                        ]
                      },
                      "accept_content": {
                        "type": "string",
                        "description": "Valor opcional de `Accept-Encoding`, se você o capturar."
                      },
                      "accept_browser": {
                        "type": "string",
                        "description": "Valor opcional de `Accept-Language`, se você o capturar."
                      }
                    }
                  },
                  "device_fingerprints": {
                    "type": "array",
                    "description": "Um ou mais device fingerprints com escopo de provedor já coletados do seu lado. A Yuno não executará a coleta de dados do dispositivo novamente para nenhum `provider_id` que você incluir aqui.",
                    "items": {
                      "type": "object",
                      "required": [
                        "provider_id",
                        "id"
                      ],
                      "properties": {
                        "provider_id": {
                          "type": "string",
                          "format": "uuid",
                          "description": "UUID da conexão de fraude ou de device intelligence na sua conta da Yuno que gerou este fingerprint. Encontre-a em **Dashboard → Connections** ou via `GET /v1/connections`."
                        },
                        "id": {
                          "type": "string",
                          "description": "O valor do fingerprint conforme retornado pelo coletor desse provedor."
                        }
                      }
                    }
                  }
                }
              },
              "examples": {
                "With device fingerprints": {
                  "value": {
                    "account_id": "11111111-1111-1111-1111-111111111111",
                    "type": "MERCHANT_PROVIDED",
                    "browser_info": {
                      "user_agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36",
                      "accept_header": "text/html,application/xhtml+xml,application/xml;q=0.9",
                      "color_depth": "24",
                      "screen_height": "1080",
                      "screen_width": "1920",
                      "language": "es-CO",
                      "javascript_enabled": true,
                      "java_enabled": false,
                      "browser_time_difference": "-300",
                      "platform": "WEB"
                    },
                    "device_fingerprints": [
                      {
                        "provider_id": "f3a8b5d2-9c4e-4a7b-b1f8-2d6c9e0a4f12",
                        "id": "fp_abc123xyz"
                      }
                    ]
                  }
                },
                "Without device fingerprints": {
                  "value": {
                    "account_id": "11111111-1111-1111-1111-111111111111",
                    "type": "MERCHANT_PROVIDED",
                    "browser_info": {
                      "user_agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36",
                      "accept_header": "text/html,application/xhtml+xml,application/xml;q=0.9",
                      "color_depth": "24",
                      "screen_height": "1080",
                      "screen_width": "1920",
                      "language": "es-CO",
                      "javascript_enabled": true,
                      "java_enabled": false,
                      "browser_time_difference": "-300",
                      "platform": "WEB"
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "201",
            "content": {
              "application/json": {
                "examples": {
                  "With device fingerprints": {
                    "value": {
                      "three_d_secure_setup_id": "a17b4f2c-08d1-4e9b-b6c5-9a3e0c7f1b22",
                      "account_id": "11111111-1111-1111-1111-111111111111",
                      "type": "MERCHANT_PROVIDED",
                      "browser_info": {
                        "user_agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36",
                        "accept_header": "text/html,application/xhtml+xml,application/xml;q=0.9",
                        "color_depth": "24",
                        "screen_height": "1080",
                        "screen_width": "1920",
                        "language": "es-CO",
                        "javascript_enabled": true,
                        "java_enabled": false,
                        "browser_time_difference": "-300",
                        "platform": "WEB"
                      },
                      "device_fingerprints": [
                        {
                          "provider_id": "f3a8b5d2-9c4e-4a7b-b1f8-2d6c9e0a4f12",
                          "id": "fp_abc123xyz"
                        }
                      ]
                    }
                  }
                },
                "schema": {
                  "type": "object",
                  "properties": {
                    "three_d_secure_setup_id": {
                      "type": "string",
                      "description": "Identificador gerado da configuração 3DS2. Envie-o em `payment_method.detail.card.three_d_secure.three_d_secure_setup_id` no `POST /v1/payments` seguinte.",
                      "example": "a17b4f2c-08d1-4e9b-b6c5-9a3e0c7f1b22"
                    },
                    "account_id": {
                      "type": "string",
                      "description": "Eco do `account_id` da requisição.",
                      "example": "11111111-1111-1111-1111-111111111111"
                    },
                    "type": {
                      "type": "string",
                      "description": "Eco do `type` da requisição.",
                      "example": "MERCHANT_PROVIDED"
                    },
                    "browser_info": {
                      "type": "object",
                      "description": "Eco do `browser_info` da requisição.",
                      "properties": {
                        "user_agent": {
                          "type": "string",
                          "example": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36"
                        },
                        "accept_header": {
                          "type": "string",
                          "example": "text/html,application/xhtml+xml,application/xml;q=0.9"
                        },
                        "color_depth": {
                          "type": "string",
                          "example": "24"
                        },
                        "screen_height": {
                          "type": "string",
                          "example": "1080"
                        },
                        "screen_width": {
                          "type": "string",
                          "example": "1920"
                        },
                        "language": {
                          "type": "string",
                          "example": "es-CO"
                        },
                        "javascript_enabled": {
                          "type": "boolean",
                          "example": true
                        },
                        "java_enabled": {
                          "type": "boolean",
                          "example": false
                        },
                        "browser_time_difference": {
                          "type": "string",
                          "example": "-300"
                        },
                        "platform": {
                          "type": "string",
                          "example": "WEB"
                        }
                      }
                    },
                    "device_fingerprints": {
                      "type": "array",
                      "description": "Eco do `device_fingerprints` da requisição.",
                      "items": {
                        "type": "object",
                        "properties": {
                          "provider_id": {
                            "type": "string",
                            "example": "f3a8b5d2-9c4e-4a7b-b1f8-2d6c9e0a4f12"
                          },
                          "id": {
                            "type": "string",
                            "example": "fp_abc123xyz"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "400",
            "content": {
              "application/json": {
                "examples": {
                  "Invalid parameters": {
                    "value": {
                      "code": "INVALID_PARAMETERS",
                      "messages": [
                        "account_id must be a valid UUIDv4"
                      ],
                      "httpCode": 400
                    }
                  },
                  "Missing parameters": {
                    "value": {
                      "code": "MISSING_PARAMETERS",
                      "messages": [
                        "account_id is required"
                      ],
                      "httpCode": 400
                    }
                  }
                },
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "string",
                      "example": "INVALID_PARAMETERS"
                    },
                    "messages": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "example": "account_id must be a valid UUIDv4"
                      }
                    },
                    "httpCode": {
                      "type": "integer",
                      "example": 400
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "401",
            "content": {
              "application/json": {
                "examples": {
                  "Unauthorized": {
                    "value": {
                      "code": "NOT_AUTHENTICATED",
                      "messages": [
                        "Missing API credentials"
                      ],
                      "httpCode": 401
                    }
                  }
                },
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "string",
                      "example": "NOT_AUTHENTICATED"
                    },
                    "messages": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "example": "Missing API credentials"
                      }
                    },
                    "httpCode": {
                      "type": "integer",
                      "example": 401
                    }
                  }
                }
              }
            }
          },
          "403": {
            "description": "403",
            "content": {
              "application/json": {
                "examples": {
                  "Forbidden": {
                    "value": {
                      "code": "FORBIDDEN",
                      "messages": [
                        "Account inactive or lacks 3DS2 entitlement"
                      ],
                      "httpCode": 403
                    }
                  }
                },
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "string",
                      "example": "FORBIDDEN"
                    },
                    "messages": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "example": "Account inactive or lacks 3DS2 entitlement"
                      }
                    },
                    "httpCode": {
                      "type": "integer",
                      "example": 403
                    }
                  }
                }
              }
            }
          }
        },
        "deprecated": false
      }
    }
  },
  "x-readme": {
    "headers": [
      {
        "key": "charset",
        "value": "utf-8"
      }
    ],
    "explorer-enabled": true,
    "proxy-enabled": true
  },
  "x-readme-fauxas": true
}
