{
  "openapi": "3.1.0",
  "info": {
    "title": "meters",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://api-sandbox.y.uno/v1"
    },
    {
      "url": "https://api.eu.y.uno/v1"
    }
  ],
  "components": {
    "securitySchemes": {
      "sec0": {
        "type": "apiKey",
        "in": "header",
        "name": "public-api-key",
        "x-default": "<Your public-api-key>"
      },
      "sec1": {
        "type": "apiKey",
        "in": "header",
        "name": "private-secret-key",
        "x-default": "<Your private-secret-key>"
      }
    }
  },
  "security": [
    {
      "sec0": [],
      "sec1": []
    }
  ],
  "paths": {
    "/subscriptions/plans/{plan_id}/meters": {
      "get": {
        "summary": "List Plan Meters",
        "description": "Usage-based billing must be enabled for your organization before this endpoint accepts requests (otherwise `403 PRODUCT_NOT_ENABLED`). Returns every metered price attached to a plan. The same list is embedded as `meters[]` on Retrieve Plan.",
        "operationId": "list-plan-meters",
        "parameters": [
          {
            "name": "plan_id",
            "in": "path",
            "required": true,
            "description": "The unique identifier of the plan.",
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "header",
            "name": "X-Account-Code",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "The `account_id` found in your [Yuno Dashboard](https://dashboard.y.uno/developers) (UUID). Required — the list is always scoped to a single account. Omitting it returns `400 BAD_REQUEST` (\"Invalid x-account-code header.\")."
          },
          {
            "name": "limit",
            "in": "query",
            "description": "Accepted for consistency with other list endpoints, but not enforced by this endpoint: any value (including out-of-range or omitted) is accepted, and every metered price attached to the plan is always returned. The response's `pagination.limit` always equals `pagination.total`, never the requested value.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "offset",
            "in": "query",
            "description": "Accepted for consistency with other list endpoints, but not enforced by this endpoint: any value is accepted and ignored — results always start from the first item.",
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "200",
            "content": {
              "application/json": {
                "examples": {
                  "Result": {
                    "value": {
                      "data": [
                        {
                          "id": "77777777-7777-7777-7777-777777777777",
                          "plan_id": "00000000-0000-4000-8000-000000000001",
                          "meter_id": "66666666-6666-6666-6666-666666666666",
                          "credits": 100,
                          "pricing_strategy": "PER_UNIT",
                          "price_per_credit": {
                            "currency": "USD",
                            "value": 0.05
                          },
                          "country_prices": [
                            {
                              "country": "US",
                              "amount": {
                                "currency": "USD",
                                "value": 0.06
                              }
                            }
                          ],
                          "package_size": null,
                          "package_price": null,
                          "package_country_prices": [],
                          "tiers": [],
                          "created_at": "2026-08-18T09:00:04.000000Z",
                          "updated_at": "2026-08-18T09:00:04.000000Z"
                        },
                        {
                          "id": "88888888-8888-8888-8888-888888888888",
                          "plan_id": "00000000-0000-4000-8000-000000000001",
                          "meter_id": "55555555-5555-5555-5555-555555555555",
                          "credits": 10000,
                          "pricing_strategy": "PER_UNIT",
                          "price_per_credit": null,
                          "country_prices": [],
                          "package_size": null,
                          "package_price": null,
                          "package_country_prices": [],
                          "tiers": [],
                          "created_at": "2026-08-18T09:00:04.000000Z",
                          "updated_at": "2026-08-18T09:00:04.000000Z"
                        }
                      ],
                      "pagination": {
                        "total": 2,
                        "limit": 2,
                        "offset": 0,
                        "has_more": false
                      }
                    }
                  }
                },
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "string",
                            "description": "The unique identifier of the metered price (the plan-meter relation)."
                          },
                          "plan_id": {
                            "type": "string"
                          },
                          "meter_id": {
                            "type": "string"
                          },
                          "credits": {
                            "type": "integer",
                            "description": "Units included in the plan per billing cycle.",
                            "format": "int64"
                          },
                          "pricing_strategy": {
                            "type": "string",
                            "enum": [
                              "PER_UNIT",
                              "PACKAGE",
                              "TIERED"
                            ]
                          },
                          "price_per_credit": {
                            "type": "object",
                            "nullable": true,
                            "description": "`null` when inherited from the meter's `default_price` (USD plans).",
                            "properties": {
                              "currency": {
                                "type": "string"
                              },
                              "value": {
                                "type": "number"
                              }
                            }
                          },
                          "country_prices": {
                            "type": "array",
                            "items": {
                              "type": "object",
                              "properties": {
                                "country": {
                                  "type": "string"
                                },
                                "amount": {
                                  "type": "object",
                                  "properties": {
                                    "currency": {
                                      "type": "string"
                                    },
                                    "value": {
                                      "type": "number"
                                    }
                                  }
                                }
                              }
                            }
                          },
                          "package_size": {
                            "type": [
                              "integer",
                              "null"
                            ],
                            "description": "Units per package, for the `PACKAGE` pricing strategy. `null` for `PER_UNIT`/`TIERED`."
                          },
                          "package_price": {
                            "type": [
                              "object",
                              "null"
                            ],
                            "description": "Flat price per package, for the `PACKAGE` pricing strategy. `null` for `PER_UNIT`/`TIERED`.",
                            "properties": {
                              "currency": {
                                "type": "string"
                              },
                              "value": {
                                "type": "number"
                              }
                            }
                          },
                          "package_country_prices": {
                            "type": "array",
                            "description": "Per-country package price overrides, for the `PACKAGE` pricing strategy. Empty for other strategies.",
                            "items": {
                              "type": "object",
                              "properties": {
                                "country": {
                                  "type": "string"
                                },
                                "amount": {
                                  "type": "object",
                                  "properties": {
                                    "currency": {
                                      "type": "string"
                                    },
                                    "value": {
                                      "type": "number"
                                    }
                                  }
                                }
                              }
                            }
                          },
                          "tiers": {
                            "type": "array",
                            "description": "Tier boundaries and prices, for the `TIERED` pricing strategy. Empty for other strategies.",
                            "items": {
                              "type": "object"
                            }
                          },
                          "created_at": {
                            "type": "string",
                            "description": "Set by Yuno on creation."
                          },
                          "updated_at": {
                            "type": "string",
                            "description": "Set by Yuno on every update."
                          }
                        }
                      }
                    },
                    "pagination": {
                      "type": "object",
                      "properties": {
                        "total": {
                          "type": "integer",
                          "description": "Total number of items."
                        },
                        "limit": {
                          "type": "integer",
                          "description": "Always equals `pagination.total` — this endpoint does not paginate; it does not reflect the requested `limit`."
                        },
                        "offset": {
                          "type": "integer"
                        },
                        "has_more": {
                          "type": "boolean",
                          "description": "`true` when more items exist beyond `offset + limit`."
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "400",
            "content": {
              "application/json": {
                "examples": {
                  "Result": {
                    "value": {
                      "code": "BAD_REQUEST",
                      "messages": [
                        "Invalid x-account-code header."
                      ]
                    }
                  }
                },
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "string"
                    },
                    "messages": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "401",
            "content": {
              "application/json": {
                "examples": {
                  "Result": {
                    "value": {
                      "code": "NOT_AUTHENTICATED",
                      "messages": [
                        "Not authenticated"
                      ]
                    },
                    "summary": "Result"
                  }
                },
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "string",
                      "example": "NOT_AUTHENTICATED"
                    },
                    "messages": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "404",
            "content": {
              "application/json": {
                "examples": {
                  "Result": {
                    "value": {
                      "code": "PLAN_NOT_FOUND",
                      "messages": [
                        "Plan not found."
                      ]
                    }
                  }
                },
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "string"
                    },
                    "messages": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            }
          },
          "403": {
            "description": "403",
            "content": {
              "application/json": {
                "examples": {
                  "Product not enabled": {
                    "summary": "Product not enabled",
                    "value": {
                      "code": "PRODUCT_NOT_ENABLED",
                      "messages": [
                        "Usage-based billing is not enabled for this organization"
                      ]
                    }
                  }
                },
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "string",
                      "example": "PRODUCT_NOT_ENABLED"
                    },
                    "messages": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "deprecated": false
      }
    }
  },
