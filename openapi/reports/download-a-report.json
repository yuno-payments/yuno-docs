  },
  "security": [
    {
      "sec0": [],
      "sec1": []
    }
  ],
  "paths": {
    "/reports/{report_id}/download": {
      "get": {
        "summary": "Download a Report",
        "description": "Returns a time-limited link to the file of a report whose status is `SUCCEEDED`. This endpoint is served under `/v2`; the other Reports endpoints stay under `/v1`.",
        "operationId": "download-a-report",
        "parameters": [
          {
            "name": "report_id",
            "in": "path",
            "required": true,
            "description": "The report unique identifier.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "200",
            "content": {
              "application/json": {
                "examples": {
                  "Result": {
                    "value": {
                      "type": "TRANSACTIONS",
                      "download_link": "https://<bucket>.s3.amazonaws.com/reports/<report_id>.zip?X-Amz-Expires=604800&X-Amz-Signature=...",
                      "status": "DOWNLOADED"
                    }
                  }
                },
                "schema": {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string",
                      "example": "TRANSACTIONS",
                      "description": "The report type requested on creation."
                    },
                    "download_link": {
                      "type": "string",
                      "example": "https://<bucket>.s3.amazonaws.com/reports/<report_id>.zip?X-Amz-Expires=604800&X-Amz-Signature=...",
                      "description": "Pre-signed link to the report file. Download the file from this link; it is valid for 7 days after the report is generated. Most report types are delivered as a .zip containing a .csv; settlement reports as a .csv."
                    },
                    "status": {
                      "type": "string",
                      "example": "DOWNLOADED",
                      "description": "Report status after this call. The first successful download moves a `SUCCEEDED` report to `DOWNLOADED`."
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "400",
            "content": {
              "application/json": {
                "examples": {
                  "Report not ready": {
                    "value": {
                      "code": "REPORT_STATUS_ERROR",
                      "messages": [
                        "report is not ready yet, status is IN_PROCESS"
                      ]
                    }
                  },
                  "Bad Request": {
                    "value": {
                      "code": "INVALID_REQUEST",
                      "messages": [
                        "Invalid request"
                      ]
                    }
                  }
                },
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "string",
                      "example": "INVALID_REQUEST"
                    },
                    "messages": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "example": "Invalid request"
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "401",
            "content": {
              "application/json": {
                "examples": {
                  "Unauthorized": {
                    "value": {
                      "code": "INVALID_CREDENTIALS",
                      "messages": [
                        "Invalid credentials"
                      ]
                    }
                  }
                },
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "string",
                      "example": "INVALID_CREDENTIALS"
                    },
                    "messages": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "example": "Invalid credentials"
                      }
                    }
                  }
                }
              }
            }
          },
          "403": {
            "description": "403",
            "content": {
              "application/json": {
                "examples": {
                  "Forbidden": {
                    "value": {
                      "code": "AUTHORIZATION_REQUIRED",
                      "messages": [
                        "The merchant has no authorization to use this API."
                      ]
                    }
                  }
                },
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "string",
                      "example": "AUTHORIZATION_REQUIRED"
                    },
                    "messages": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "example": "The merchant has no authorization to use this API."
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "deprecated": false
      }
    }
  },
