  "paths": {
    "/subscriptions/{subscription_id}/resume": {
      "post": {
        "summary": "Resume Subscription",
        "description": "",
        "operationId": "resume-subscription",
        "parameters": [
          {
            "name": "subscription_id",
            "in": "path",
            "description": "The unique identifier of a subscription.",
            "schema": {
              "type": "string"
            },
            "required": true
          },
          {
            "in": "header",
            "name": "X-Account-Code",
            "schema": {
              "type": "string"
            },
            "description": "Optional. The `account_id` found in your [Yuno Dashboard](https://dashboard.y.uno/developers) (UUID). This route is scoped by `{subscription_id}` in the path, not by this header — omitting it does not return a 400; the subscription is resolved directly by id.",
            "required": false
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "billing_cycle_behavior": {
                    "type": "string",
                    "enum": [
                      "KEEP",
                      "RESTART"
                    ],
                    "description": "KEEP (default) leaves the next billing anchor untouched; RESTART re-anchors it to today. Omitted or bodyless is equivalent to KEEP."
                  }
                }
              }
            }
          },
          "required": false
        },
        "responses": {
          "200": {
            "description": "200",
            "content": {
              "application/json": {
                "examples": {
                  "RESUME SUBSCRIPTION": {
                    "value": {
                      "id": "7304911d-5df9-429e-8488-ad41abea1a4c",
                      "name": "sub_001",
                      "description": "streaming service",
                      "account_id": "2404911d-5df9-429e-8488-ad41abea1a4b",
                      "country": "US",
