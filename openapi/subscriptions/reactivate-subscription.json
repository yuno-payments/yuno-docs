        "deprecated": false,
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "billing_cycle_behavior": {
                    "type": "string",
                    "enum": [
                      "KEEP",
                      "RESTART"
                    ],
                    "default": "KEEP",
                    "description": "What the reactivated subscription does with its billing anchor. KEEP, which is also what omitting the field does, holds the original anchor: untouched while it is still ahead, and rolled to its next occurrence once it has passed. A subscriber who comes back inside a period they already paid for is billed on the date they paid through, never at the moment of reactivation. RESTART starts the cycle from the reactivation date instead, one full period out."
                  },
                  "billing_cycles": {
                    "type": "object",
                    "description": "Only for a subscription that used up its billing cycles, where reactivating creates a successor instead of returning the original to life. It sizes that successor. Sending it for a subscription that still has cycles left returns 400.",
                    "properties": {
                      "total": {
                        "type": "integer",
                        "nullable": true,
                        "minimum": 1,
                        "example": 24,
                        "description": "How many billing cycles the successor gets. Omit the field to copy the limit the finished subscription had, send a number to set a different one, or send null to leave the successor unlimited so it bills until it is canceled."
                      }
                    }
                  }
                }
              },
              "examples": {
                "KEEP THE ORIGINAL BILLING DATE": {
                  "value": {
                    "billing_cycle_behavior": "KEEP"
                  }
                },
                "SIZE THE SUCCESSOR OF A FINISHED SUBSCRIPTION": {
                  "value": {
                    "billing_cycles": {
                      "total": 24
                    }
                  }
                }
              }
            }
          }
