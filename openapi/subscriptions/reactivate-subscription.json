                "examples": {
                  "Result": {
                    "value": {
                      "code": "INVALID_DATE",
                      "messages": [
                        "The subscription can not be resumed due to a conflict with the availability dates. Please update availability dates and try again if you want to keep using the subscription."
                      ]
