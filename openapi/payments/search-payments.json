{
  "openapi": "3.1.0",
  "info": {
    "title": "payment-api-search-payments",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://api-sandbox.y.uno/v1",
      "description": "Sandbox"
    },
    {
      "url": "https://api.y.uno/v1",
      "description": "Production (US)"
    }
  ],
  "components": {
    "securitySchemes": {
      "sec0": {
        "type": "apiKey",
        "in": "header",
        "name": "public-api-key",
        "x-default": "<Your public-api-key>"
      },
      "sec1": {
        "type": "apiKey",
        "in": "header",
        "name": "private-secret-key",
        "x-default": "<Your private-secret-key>"
      }
    },
    "schemas": {
      "PaymentSearchResult": {
        "type": "object",
        "required": ["payments", "next_cursor", "has_more"],
        "properties": {
          "payments": {
            "type": "array",
            "description": "The payments of the page, ordered by `created_at` ascending and then by `id`.",
            "items": {
              "$ref": "#/components/schemas/PaymentSummary"
            }
          },
          "next_cursor": {
            "type": ["string", "null"],
            "description": "Opaque cursor for the next page. Send it as `cursor` together with the same filters. `null` on the last page."
          },
          "has_more": {
            "type": "boolean",
            "description": "`true` when another page exists after this one, `false` on the last page."
          }
        }
      },
      "PaymentSummary": {
        "type": "object",
        "description": "Summarized payment row. It carries no `transactions` array: retrieve the payment by `id` for the full object.",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "description": "The unique identifier of the payment."
          },
          "account_id": {
            "type": "string",
            "format": "uuid",
            "description": "The unique identifier of the account that owns the payment."
          },
          "merchant_order_id": {
            "type": "string",
            "description": "The unique identifier of the customer's order."
          },
          "description": {
            "type": "string",
            "description": "The description of the payment."
          },
          "country": {
            "type": "string",
            "description": "The country of the payment (ISO 3166-1 alpha-2)."
          },
          "status": {
            "type": "string",
            "description": "The status of the payment. See [Payment status](/reference/payments/status-and-response-codes/payment)."
          },
          "sub_status": {
            "type": "string",
            "description": "The sub status of the payment."
          },
          "amount": {
            "type": "object",
            "properties": {
              "value": {
                "type": "number",
                "description": "The amount of the payment."
              },
              "currency": {
                "type": "string",
                "description": "The currency of the payment (ISO 4217)."
              }
            }
          },
          "payment_method": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "description": "The payment method type, for example `CARD` or `PIX`."
              }
            }
          },
          "customer_payer": {
            "type": "object",
            "properties": {
              "id": {
                "type": ["string", "null"],
                "description": "The unique identifier of the customer, when the payment has one."
              }
            }
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "description": "Payment creation date and time (ISO 8601)."
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "description": "Last update date and time of the payment (ISO 8601)."
          }
        }
      },
      "Error": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "messages": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  },
  "security": [
    {
      "sec0": [],
      "sec1": []
    }
  ],
  "paths": {
    "/payments/search": {
      "get": {
        "summary": "Search Payments",
        "description": "Lists the payments of the account sent in `X-Account-Code` that were created inside a `created_at` window of at most 7 days, with optional filters and cursor pagination. Rows are ordered by `created_at` ascending and then by `id`.",
        "operationId": "search-payments",
        "parameters": [
          {
            "name": "X-Account-Code",
            "in": "header",
            "description": "The account whose payments are listed.",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "created_at_from",
            "in": "query",
            "description": "Start of the creation window (ISO 8601). The window between `created_at_from` and `created_at_to` is at most 7 days.",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "created_at_to",
            "in": "query",
            "description": "End of the creation window (ISO 8601). At most 7 days after `created_at_from`.",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "updated_at_from",
            "in": "query",
            "description": "Only payments last updated at or after this date and time (ISO 8601).",
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "updated_at_to",
            "in": "query",
            "description": "Only payments last updated at or before this date and time (ISO 8601).",
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "status",
            "in": "query",
            "description": "Payment statuses to match. Send a comma-separated list (`status=SUCCEEDED,DECLINED`) or repeat the parameter (`status=SUCCEEDED&status=DECLINED`).",
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "style": "form",
            "explode": true
          },
          {
            "name": "customer_id",
            "in": "query",
            "description": "Only payments of this customer.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "payment_method_type",
            "in": "query",
            "description": "Only payments made with this payment method type, for example `CARD`.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "country",
            "in": "query",
            "description": "Only payments of this country (ISO 3166-1 alpha-2).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "currency",
            "in": "query",
            "description": "Only payments in this currency (ISO 4217).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "merchant_order_id",
            "in": "query",
            "description": "Only payments with this merchant order ID.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "description": "Number of payments per page, from 1 to 100.",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 50
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "description": "The `next_cursor` of the previous page. Send it with the same filters as the request that returned it.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "200",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PaymentSearchResult"
                },
                "examples": {
                  "Page with more results": {
                    "value": {
                      "payments": [
                        {
                          "id": "e3f397ed-b7d0-4816-ab75-8457b0a30ec1",
                          "account_id": "493e9374-510a-4201-9e09-de669d75f256",
                          "merchant_order_id": "0000022",
                          "description": "Test payment",
                          "country": "US",
                          "status": "SUCCEEDED",
                          "sub_status": "APPROVED",
                          "amount": {
                            "value": 100,
                            "currency": "USD"
                          },
                          "payment_method": {
                            "type": "CARD"
                          },
                          "customer_payer": {
                            "id": "cfae0941-7234-427a-a739-ef4fce966c79"
                          },
                          "created_at": "2026-11-03T10:24:58.900553Z",
                          "updated_at": "2026-11-03T10:25:13.447662Z"
                        }
                      ],
                      "next_cursor": "eyJjIjoiMjAyNi0xMS0wM1QxMDoyNDo1OC45MDA1NTNaIn0",
                      "has_more": true
                    }
                  },
                  "Last page": {
                    "value": {
                      "payments": [],
                      "next_cursor": null,
                      "has_more": false
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "400",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "examples": {
                  "DATE_RANGE_TOO_WIDE": {
                    "value": {
                      "code": "DATE_RANGE_TOO_WIDE",
                      "messages": [
                        "The window between 'created_at_from' and 'created_at_to' must be at most 7 days."
                      ]
                    }
                  },
                  "INVALID_CURSOR": {
                    "value": {
                      "code": "INVALID_CURSOR",
                      "messages": [
                        "The cursor is malformed or was issued for different filters."
                      ]
                    }
                  }
                }
              }
            }
          }
        },
        "deprecated": false
      }
    }
  },
  "x-readme": {
    "headers": [],
    "explorer-enabled": true,
    "proxy-enabled": true
  }
}
