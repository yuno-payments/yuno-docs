            }
          },
          "400": {
            "description": "Invalid request. `INVALID_PARAMETERS` for a missing idempotency key or an amount above what can be operated on; `INVALID_STATUS` when the card cannot take the operation, for example a refund while the card has an open chargeback, or a capture or cancel while the payment is in `REFUND_RETRY_IN_PROCESS` or `CANCEL_RETRY_IN_PROCESS`.",
            "content": {
