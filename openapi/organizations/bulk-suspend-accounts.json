{
  "openapi": "3.1.0",
  "info": {
    "title": "Accounts API - Bulk Suspend",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://api-sandbox.y.uno/v1",
      "description": "Sandbox"
    },
    {
      "url": "https://api.y.uno/v1",
      "description": "Production (US)"
    },
    {
      "url": "https://api.eu.y.uno/v1",
      "description": "Production (EMEA)"
    }
  ],
  "components": {
    "securitySchemes": {
      "sec0": {
        "type": "apiKey",
        "in": "header",
        "name": "PUBLIC-API-KEY",
        "x-default": "<Your PUBLIC-API-KEY>"
      },
      "sec1": {
        "type": "apiKey",
        "in": "header",
        "name": "PRIVATE-SECRET-KEY",
        "x-default": "<Your PRIVATE-SECRET-KEY>"
      }
    }
  },
  "security": [
    {
      "sec0": [],
      "sec1": []
    }
  ],
  "paths": {
    "/organizations/accounts/bulk-suspend": {
      "post": {
        "summary": "Suspend Accounts in Bulk",
        "operationId": "bulk-suspend-accounts",
        "description": "Suspends up to 100 accounts of your organization in one all-or-nothing call: if any id is invalid, unknown or would leave your organization without an active account, nothing is changed. Accounts already suspended are returned unchanged.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "account_ids"
                ],
                "properties": {
                  "account_ids": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 100,
                    "items": {
                      "type": "string",
                      "format": "uuid"
                    },
                    "description": "Between 1 and 100 account ids of your organization."
                  }
                }
              },
              "example": {
                "account_ids": [
                  "6f1c2b9e-3a4d-4e5f-8a7b-9c0d1e2f3a4b",
                  "0a9b8c7d-6e5f-4a3b-9c2d-1e0f9a8b7c6d"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The accounts with their status, in `data`.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "string",
                            "format": "uuid",
                            "description": "Account id."
                          },
                          "name": {
                            "type": "string",
                            "description": "Account name."
                          },
                          "account_group_id": {
                            "type": [
                              "string",
                              "null"
                            ],
                            "format": "uuid",
                            "description": "Account group the account belongs to, or `null` when it belongs to none."
                          },
                          "status": {
                            "type": "string",
                            "enum": [
                              "ACTIVE",
                              "SUSPENDED"
                            ],
                            "readOnly": true,
                            "description": "Read-only. `SUSPENDED` after the account is suspended, `ACTIVE` otherwise."
                          },
                          "created_at": {
                            "type": "string",
                            "format": "date-time"
                          },
                          "updated_at": {
                            "type": "string",
                            "format": "date-time"
                          }
                        }
                      }
                    }
                  }
                },
                "example": {
                  "data": [
                    {
                      "id": "6f1c2b9e-3a4d-4e5f-8a7b-9c0d1e2f3a4b",
                      "name": "Account 1",
                      "account_group_id": "3c2b1a09-8f7e-4d6c-9b5a-4f3e2d1c0b9a",
                      "status": "SUSPENDED",
                      "created_at": "2026-10-01T10:00:00Z",
                      "updated_at": "2026-10-15T10:00:00Z"
                    },
                    {
                      "id": "0a9b8c7d-6e5f-4a3b-9c2d-1e0f9a8b7c6d",
                      "name": "Account 2",
                      "account_group_id": "3c2b1a09-8f7e-4d6c-9b5a-4f3e2d1c0b9a",
                      "status": "SUSPENDED",
                      "created_at": "2026-10-01T10:00:00Z",
                      "updated_at": "2026-10-15T10:00:00Z"
                    }
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Empty list, more than 100 ids, an invalid id, or `LAST_ACTIVE_ACCOUNT`: the batch would leave your organization with no active account. Nothing is changed.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "string"
                    },
                    "messages": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  }
                },
                "example": {
                  "code": "LAST_ACTIVE_ACCOUNT",
                  "messages": [
                    "Cannot disable accounts. At least one account must remain active in the organization."
                  ]
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid API keys.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "string"
                    },
                    "messages": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "`ACCOUNT_NOT_FOUND`: an id does not exist in your organization. Nothing is changed.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "string"
                    },
                    "messages": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  }
                },
                "example": {
                  "code": "ACCOUNT_NOT_FOUND",
                  "messages": [
                    "Account not found: 6f1c2b9e-3a4d-4e5f-8a7b-9c0d1e2f3a4b"
                  ]
                }
              }
            }
          }
        }
      }
    }
  }
}
