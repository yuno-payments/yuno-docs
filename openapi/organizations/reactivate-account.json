{
  "openapi": "3.1.0",
  "info": {
    "title": "Accounts API - Reactivate",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://api-sandbox.y.uno/v1",
      "description": "Sandbox"
    },
    {
      "url": "https://api.y.uno/v1",
      "description": "Production (US)"
    },
    {
      "url": "https://api.eu.y.uno/v1",
      "description": "Production (EMEA)"
    }
  ],
  "components": {
    "securitySchemes": {
      "sec0": {
        "type": "apiKey",
        "in": "header",
        "name": "PUBLIC-API-KEY",
        "x-default": "<Your PUBLIC-API-KEY>"
      },
      "sec1": {
        "type": "apiKey",
        "in": "header",
        "name": "PRIVATE-SECRET-KEY",
        "x-default": "<Your PRIVATE-SECRET-KEY>"
      }
    }
  },
  "security": [
    {
      "sec0": [],
      "sec1": []
    }
  ],
  "paths": {
    "/organizations/accounts/{account_id}/reactivate": {
      "post": {
        "summary": "Reactivate Account",
        "operationId": "reactivate-account",
        "description": "Reactivates a suspended account of your organization. Reactivating an already active account returns it unchanged.",
        "parameters": [
          {
            "name": "account_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "Account UUID."
          }
        ],
        "responses": {
          "200": {
            "description": "The account with its status.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "format": "uuid",
                      "description": "Account id."
                    },
                    "name": {
                      "type": "string",
                      "description": "Account name."
                    },
                    "account_group_id": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "format": "uuid",
                      "description": "Account group the account belongs to, or `null` when it belongs to none."
                    },
                    "status": {
                      "type": "string",
                      "enum": [
                        "ACTIVE",
                        "SUSPENDED"
                      ],
                      "readOnly": true,
                      "description": "Read-only. `SUSPENDED` after the account is suspended, `ACTIVE` otherwise."
                    },
                    "created_at": {
                      "type": "string",
                      "format": "date-time"
                    },
                    "updated_at": {
                      "type": "string",
                      "format": "date-time"
                    }
                  }
                },
                "example": {
                  "id": "6f1c2b9e-3a4d-4e5f-8a7b-9c0d1e2f3a4b",
                  "name": "Account 1",
                  "account_group_id": "3c2b1a09-8f7e-4d6c-9b5a-4f3e2d1c0b9a",
                  "status": "ACTIVE",
                  "created_at": "2026-10-01T10:00:00Z",
                  "updated_at": "2026-10-15T10:05:00Z"
                }
              }
            }
          },
          "400": {
            "description": "Invalid account id.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "string"
                    },
                    "messages": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid API keys.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "string"
                    },
                    "messages": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "`ACCOUNT_NOT_FOUND`: the account does not exist in your organization.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "string"
                    },
                    "messages": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  }
                },
                "example": {
                  "code": "ACCOUNT_NOT_FOUND",
                  "messages": [
                    "Account not found: 6f1c2b9e-3a4d-4e5f-8a7b-9c0d1e2f3a4b"
                  ]
                }
              }
            }
          }
        }
      }
    }
  }
}
