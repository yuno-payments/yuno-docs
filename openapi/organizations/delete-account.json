{
  "openapi": "3.1.0",
  "info": {
    "title": "Accounts API - Delete",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://api-sandbox.y.uno/v1",
      "description": "Sandbox"
    },
    {
      "url": "https://api.y.uno/v1",
      "description": "Production (US)"
    }
  ],
  "components": {
    "securitySchemes": {
      "sec0": { "type": "apiKey", "in": "header", "name": "PUBLIC-API-KEY", "x-default": "<Your PUBLIC-API-KEY>" },
      "sec1": { "type": "apiKey", "in": "header", "name": "PRIVATE-SECRET-KEY", "x-default": "<Your PRIVATE-SECRET-KEY>" }
    }
  },
  "security": [ { "sec0": [], "sec1": [] } ],
  "paths": {
    "/organizations/accounts/{account_id}": {
      "delete": {
        "summary": "Delete Account",
        "operationId": "delete-account",
        "description": "Deletes an account. Deleting is permanent: the account is no longer listed or retrievable by id, and the API cannot restore it.",
        "parameters": [
          {
            "name": "account_id",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "format": "uuid" },
            "description": "Account UUID."
          }
        ],
        "responses": {
          "204": {
            "description": "No Content — the account was deleted."
          }
        }
      }
    }
  }
}
