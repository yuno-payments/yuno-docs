{
  "openapi": "3.1.0",
  "info": {
    "title": "Accounts API - Retrieve",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://api-sandbox.y.uno/v1",
      "description": "Sandbox"
    },
    {
      "url": "https://api.y.uno/v1",
      "description": "Production (US)"
    },
    {
      "url": "https://api.eu.y.uno/v1",
      "description": "Production (EMEA)"
    }
  ],
  "components": {
    "securitySchemes": {
      "sec0": { "type": "apiKey", "in": "header", "name": "PUBLIC-API-KEY", "x-default": "<Your PUBLIC-API-KEY>" },
      "sec1": { "type": "apiKey", "in": "header", "name": "PRIVATE-SECRET-KEY", "x-default": "<Your PRIVATE-SECRET-KEY>" }
    }
  },
  "security": [ { "sec0": [], "sec1": [] } ],
  "paths": {
    "/organizations/accounts/{account_id}": {
      "get": {
        "summary": "Retrieve Account",
        "operationId": "retrieve-account",
        "description": "Get a specific account by UUID.",
        "parameters": [
          {
            "name": "account_id",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "format": "uuid" },
            "description": "Account UUID."
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": { "type": "string", "format": "uuid" },
                    "name": { "type": "string" },
                    "account_group_id": { "type": "string", "format": "uuid" },
                    "status": { "type": "string", "enum": ["ACTIVE", "SUSPENDED"], "readOnly": true, "description": "Read-only. `SUSPENDED` while the account is suspended, `ACTIVE` otherwise." },
                    "created_at": { "type": "string", "format": "date-time" },
                    "updated_at": { "type": "string", "format": "date-time" }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Not found. When no account matches the id, the API returns HTTP 400 with `code` set to `\"404\"`.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": { "type": "string", "example": "404" },
                    "messages": { "type": "array", "items": { "type": "string" } }
                  }
                },
                "example": { "code": "404", "messages": ["Account not found"] }
              }
            }
          }
        }
      }
    }
  }
}
