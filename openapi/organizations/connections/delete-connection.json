{
  "openapi": "3.1.0",
  "info": {
    "title": "Connections API - Delete",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://api-sandbox.y.uno/v1",
      "description": "Sandbox"
    },
    {
      "url": "https://api.y.uno/v1",
      "description": "Production (US)"
    }
  ],
  "components": {
    "securitySchemes": {
      "sec0": {
        "type": "apiKey",
        "in": "header",
        "name": "PUBLIC-API-KEY",
        "x-default": "<Your PUBLIC-API-KEY>"
      },
      "sec1": {
        "type": "apiKey",
        "in": "header",
        "name": "PRIVATE-SECRET-KEY",
        "x-default": "<Your PRIVATE-SECRET-KEY>"
      }
    }
  },
  "security": [
    {
      "sec0": [],
      "sec1": []
    }
  ],
  "paths": {
    "/connections/{connection_id}": {
      "delete": {
        "summary": "Delete a Connection",
        "operationId": "delete-connection",
        "description": "Deletes a connection. Known issue: the call returns 204, but retrieving the connection afterwards still returns ACTIVE.",
        "parameters": [
          {
            "name": "connection_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "X-Account-Code",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "Required for an account connection. Omit it for an organization connection."
          }
        ],
        "responses": {
          "204": {
            "description": "No Content"
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string",
                      "example": "auth_error"
                    },
                    "code": {
                      "type": "string",
                      "example": "NOT_AUTHENTICATED"
                    },
                    "message": {
                      "type": "string",
                      "example": "Not authenticated"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string",
                      "example": "not_found"
                    },
                    "code": {
                      "type": "string",
                      "example": "CONNECTION_NOT_FOUND"
                    },
                    "message": {
                      "type": "string",
                      "example": "Connection '...' was not found"
                    }
                  }
                }
              }
            }
          },
          "409": {
            "description": "Conflict For an organization connection, details.accounts lists the accounts whose routes still reference it.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string",
                      "example": "conflict"
                    },
                    "code": {
                      "type": "string",
                      "example": "CONNECTION_IN_USE"
                    },
                    "message": {
                      "type": "string",
                      "example": "Connection '...' is still referenced by an active routing rule"
                    }
                  }
                }
              }
            }
          },
          "503": {
            "description": "The organization connection's accounts could not be listed. Nothing changes; retry the request. A pause still commits.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string"
                    },
                    "code": {
                      "type": "string",
                      "example": "ORGANIZATION_ACCOUNTS_UNAVAILABLE"
                    },
                    "message": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
