{
  "openapi": "3.1.0",
  "info": { "title": "Connections API - Create", "version": "1.0.0" },
  "servers": [
    {
      "url": "https://api-sandbox.y.uno/v1",
      "description": "Sandbox"
    },
    {
      "url": "https://api.y.uno/v1",
      "description": "Production (US)"
    }
  ],
  "components": {
    "securitySchemes": {
      "sec0": { "type": "apiKey", "in": "header", "name": "PUBLIC-API-KEY", "x-default": "<Your PUBLIC-API-KEY>" },
      "sec1": { "type": "apiKey", "in": "header", "name": "PRIVATE-SECRET-KEY", "x-default": "<Your PRIVATE-SECRET-KEY>" }
    }
  },
  "security": [ { "sec0": [], "sec1": [] } ],
  "paths": {
    "/connections": {
      "post": {
        "summary": "Create a Connection",
        "operationId": "create-connection",
        "description": "Creates a connection in ACTIVE status.",
        "parameters": [
          { "name": "X-account-code", "in": "header", "required": false, "description": "The account that owns the connection. Required for an account connection. Omit it for an organization connection (scope ORGANIZATION).", "schema": { "type": "string" } },
          { "name": "X-Idempotency-Key", "in": "header", "required": true, "schema": { "type": "string", "format": "uuid" } }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["merchant_connection_id", "provider_id", "params"],
                "properties": {
                  "scope": { "type": "string", "enum": ["ACCOUNT", "ORGANIZATION"], "default": "ACCOUNT", "description": "ACCOUNT: the connection belongs to the account in X-account-code. ORGANIZATION: one Apple Pay (own certificates) or Google Pay (Yuno or partner gateway mode) connection used by every account in the organization, including accounts created later." },
                  "organization_connection_confirmation": { "type": "boolean", "description": "Required as true when scope is ORGANIZATION. Not used on account connections." },
                  "checkout_activation": { "type": "string", "enum": ["AVAILABLE", "ENABLED"], "description": "Required when scope is ORGANIZATION; not used on account connections. AVAILABLE: each account turns the wallet on in its checkout. ENABLED: switched on in every account's checkout at once." },
                  "merchant_connection_id": { "type": "string", "example": "stripe-us-prod-001" },
                  "provider_id": { "type": "string", "example": "STRIPE" },
                  "flow_type": { "type": "string", "description": "Optional. Defaults to PAYIN.", "example": "PAYIN" },
                  "payment_methods": { "type": "array", "items": { "type": "string" }, "minItems": 1, "description": "Optional. Subset of the provider's payment_method_type[]. Omit it to enable every payment method the provider supports, including ones added later. If sent, it must contain at least one value: an empty array is rejected with 400 VALIDATION_ERROR.", "example": ["CARD"] },
                  "params": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "param_id": { "type": "string" },
                        "value": { "type": ["string", "boolean", "number", "array"] }
                      }
                    }
                  },
                  "costs": {
                    "type": "array",
                    "description": "Optional. Per-connection cost configuration.",
                    "items": {
                      "type": "object",
                      "properties": {
                        "sort_number": { "type": "integer" },
                        "cost_name": { "type": "string" },
                        "currency": { "type": "string" },
                        "cost_values": { "type": "object" }
                      }
                    }
                  }
                }
              },
              "example": {
                "merchant_connection_id": "stripe-us-prod-001",
                "provider_id": "STRIPE",
                "flow_type": "PAYIN",
                "payment_methods": ["CARD"],
                "params": [
                  { "param_id": "INTEGRATION_TYPE", "value": "STRIPE_CHARGES" },
                  { "param_id": "SECRET_KEY", "value": "sk_live_..." },
                  { "param_id": "RADAR_FRAUD_ANALYSIS", "value": false },
                  { "param_id": "SEND_RECEIPT_EMAIL_PARAMETER", "value": false },
                  { "param_id": "SETUP_FUTURE_USAGE", "value": false },
                  { "param_id": "ORDER_ID", "value": "DEFAULT" }
                ],
                "costs": [
                  {
                    "sort_number": 1,
                    "cost_name": "Transaction Fee",
                    "currency": "USD",
                    "cost_values": {
                      "successful": { "fixed_fee": 0.3, "percentage": 2.9 },
                      "unsuccessful": { "fixed_fee": 0.0, "percentage": 0.0 }
                    }
                  }
                ]
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "connection_id": { "type": "string", "example": "f1a3c4d5-7b8e-4a2c-9d1e-3f4a5b6c7d8e" },
                    "scope": { "type": "string", "enum": ["ACCOUNT", "ORGANIZATION"], "example": "ACCOUNT" },
                    "checkout_activation": { "type": "string", "enum": ["AVAILABLE", "ENABLED"], "description": "Present only on organization connections (scope ORGANIZATION). Omitted on account connections.", "example": "ENABLED" },
                    "merchant_connection_id": { "type": "string", "example": "stripe-us-prod-001" },
                    "provider_id": { "type": "string", "example": "STRIPE" },
                    "status": { "type": "string", "example": "ACTIVE" },
                    "flow_type": { "type": "string", "example": "PAYIN" },
                    "payment_methods": { "type": "array", "items": { "type": "string" }, "example": ["CARD"] },
                    "params": { "type": "array", "items": { "type": "object" } },
                    "costs": { "type": "array", "items": { "type": "object" } },
                    "created_at": { "type": "string", "format": "date-time", "example": "2026-05-12T10:24:00Z" },
                    "updated_at": { "type": "string", "format": "date-time", "example": "2026-05-12T10:24:00Z" }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad Request. For an organization connection (scope ORGANIZATION), code can also be ORGANIZATION_CONNECTION_CONFIRMATION_REQUIRED, ORGANIZATION_SCOPE_NOT_SUPPORTED_FOR_PROVIDER, ORGANIZATION_APPLE_PAY_REQUIRES_OWN_CERTIFICATES or ORGANIZATION_CHECKOUT_ACTIVATION_REQUIRED.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "type": { "type": "string", "example": "validation_error" },
                    "code": { "type": "string", "example": "MISSING_REQUIRED_PARAM" },
                    "message": { "type": "string", "example": "Required param 'SECRET_KEY' is missing" },
                    "details": { "type": "object" }
                  }
                }
              }
            }
          },
          "409": {
            "description": "Conflict",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "type": { "type": "string", "example": "conflict" },
                    "code": { "type": "string", "example": "CONNECTION_MERCHANT_ID_CONFLICT" },
                    "message": { "type": "string", "example": "A connection with this merchant_connection_id already exists" }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "type": { "type": "string", "example": "auth_error" },
                    "code": { "type": "string", "example": "NOT_AUTHENTICATED" },
                    "message": { "type": "string", "example": "Not authenticated" }
                  }
                }
              }
            }
          },
          "503": {
            "description": "Service Unavailable. ORGANIZATION_ACCOUNTS_UNAVAILABLE: the organization's accounts could not be read while creating an organization connection. Nothing changes; retry the request.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "type": { "type": "string", "example": "internal_error" },
                    "code": { "type": "string", "example": "ORGANIZATION_ACCOUNTS_UNAVAILABLE" },
                    "message": { "type": "string", "example": "The organization's accounts could not be read. Try again." }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
