                      "type": "object",
                      "required": [
                        "document_type"
                      ],
                      "properties": {
                        "document_type": {
                          "type": "string",
                          "description": "The document type. It selects the sub-object you must send with the same name in lower case, for example `BANK_STATEMENT` requires `bank_statement`.",
