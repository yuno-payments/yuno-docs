                          "enum": [
                            "IDENTITY_DOCUMENT",
                            "PROOF_OF_ADDRESS",
                            "BANK_STATEMENT",
                            "TAX_INFORMATION",
                            "BIOMETRIC_VERIFICATION",
                            "EMPLOYMENT_INFORMATION",
                            "BUSINESS_DOCUMENT",
                            "FINANCIAL_DOCUMENT"
                          ]
                        },
                        "identity_document": {
                          "type": "object",
                          "required": [
                            "document_number",
                            "issuing_country",
                            "files"
                          ],
