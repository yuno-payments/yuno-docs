                              "description": "The document subtype.",
                              "example": "DRIVERS_LICENSE"
                            },
                            "issuing_country": {
                              "type": "string",
                              "description": "The issuing country (ISO 3166-1 alpha-2).",
                              "example": "US"
                            },
                            "expires_at": {
                              "type": "string",
                              "description": "The expiry date. Format `YYYY-MM-DD`.",
                              "example": "2028-01-15"
                            },
                            "files": {
                              "type": "array",
                              "minItems": 1,
                              "description": "The files that support the document. At least one file is required.",
                              "items": {
                                "type": "object",
                                "required": [
                                  "file_name",
                                  "content_type",
                                  "content"
                                ],
                                "properties": {
                                  "file_name": {
                                    "type": "string",
                                    "description": "The file name.",
                                    "example": "document.pdf"
                                  },
                                  "content_type": {
                                    "type": "string",
                                    "description": "The file media type.",
                                    "example": "application/pdf",
                                    "enum": [
                                      "image/jpeg",
                                      "image/png",
                                      "application/pdf",
                                      "image/tiff"
                                    ]
                                  },
                                  "content": {
                                    "type": "string",
                                    "description": "The file content, base64 encoded.",
                                    "example": "base64_encoded_content"
