{
  "$comment": "Docs code samples compiled in CI by .github/workflows/sdk-samples.yml. To cover a new page, add a block entry (and stubs in harness/<target>/ if the snippet calls merchant-side helpers). Each block selector must match exactly one fence, or extract.cjs fails.",
  "targets": {
    "web": {
      "version": {
        "default": "9.4.0",
        "$comment": "The quickstart's npm install line is unpinned. 9.4.0 is the sdk-web release whose loadScript() loads the v1.11 CDN tag the page pins. Bump together with the CDN tag."
      }
    },
    "android": {
      "version": {
        "file": "docs/sdks/overview/quickstart.mdx",
        "regex": "com\\.yuno\\.payments:android-sdk:([0-9][0-9A-Za-z.\\-]*)"
      }
    },
    "ios": {
      "version": {
        "file": "docs/sdks/overview/quickstart.mdx",
        "regex": "pod 'YunoSDK', '~> ([0-9][0-9.]*)'"
      }
    }
  },
  "blocks": [
    {
      "id": "quickstart-web",
      "target": "web",
      "file": "docs/sdks/overview/quickstart.mdx",
      "tab": "Web SDK integration",
      "lang": "javascript",
      "contains": "startCheckout",
      "dest": "src/quickstart.ts"
    },
    {
      "id": "quickstart-ios",
      "target": "ios",
      "file": "docs/sdks/overview/quickstart.mdx",
      "tab": "iOS",
      "lang": "swift",
      "contains": "import YunoSDK",
      "dest": "main.swift"
    },
    {
      "id": "quickstart-android-application",
      "target": "android",
      "file": "docs/sdks/overview/quickstart.mdx",
      "tab": "Android",
      "lang": "kotlin",
      "contains": ": Application()",
      "dest": "app/src/main/java/com/example/qs/MyApplication.kt",
      "prepend": "package com.example.qs\n\n"
    },
    {
      "id": "quickstart-android-activity",
      "target": "android",
      "file": "docs/sdks/overview/quickstart.mdx",
      "tab": "Android",
      "lang": "kotlin",
      "contains": "class PaymentActivity",
      "dest": "app/src/main/java/com/example/qs/PaymentActivity.kt",
      "prepend": "package com.example.qs\n\n"
    }
  ]
}
